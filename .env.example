# Copy to .env.local (never commit real values).

# --- Footer "Get in touch" form (app/api/subscribe) -----------------------
# Emails the enquiry to sales@pyngyn.com over Google Workspace (Gmail) SMTP.
#
# SMTP_PASS must be a Google **App Password**, not the account password:
#   1. Turn on 2-Step Verification for the sales@pyngyn.com Google account
#   2. Google Account -> Security -> App passwords -> create one for "Mail"
#   3. Paste the 16-character value below (spaces removed)
#
# HOSTING (IMPORTANT): SMTP needs a raw TCP socket, which Cloudflare Workers
# CANNOT open — so this route must run on a Node host. Deploy the repo to
# Vercel/Render (they run app/api/* on Node), set the SMTP_* vars THERE, and on
# the Cloudflare project set NEXT_PUBLIC_SUBSCRIBE_URL to that endpoint so the
# form POSTs to it. CORS is handled by the route.
SMTP_USER=sales@pyngyn.com
SMTP_PASS=
# Optional overrides:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Both default to SMTP_USER / sales@pyngyn.com.
SUBSCRIBE_FROM=
SUBSCRIBE_TO=

# Origins allowed to POST to the (cross-origin) subscribe endpoint, comma
# separated. pyngyn.com, *.pyngyn.com, *.workers.dev and localhost are always
# allowed; add anything else (e.g. a custom preview domain) here. Set on the
# NODE host (Vercel/Render), next to SMTP_*.
ALLOWED_ORIGINS=

# The URL the front-end form POSTs to. Set this on the CLOUDFLARE project to the
# Node deployment's endpoint, e.g. https://pyngyn-mailer.vercel.app/api/subscribe/
# Leave empty for local dev / an all-Node deployment (uses the same-origin route).
NEXT_PUBLIC_SUBSCRIBE_URL=

# --- Optional integrations already read by the app ------------------------
# Slack/Zapier/HTTP endpoint that receives native demo bookings (app/api/demo).
DEMO_WEBHOOK_URL=
# Google Search Console "HTML tag" verification code (content value only).
GOOGLE_SITE_VERIFICATION=
