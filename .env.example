# Copy to .env.local (never commit real values).

# --- Footer "Get in touch" form (app/api/subscribe) -----------------------
# Emails the enquiry to sales@pyngyn.com via the Resend HTTPS API (a fetch), so
# it runs directly on Cloudflare — no SMTP, no separate server.
#
# Setup:
#   1. Sign up at resend.com and add + verify the pyngyn.com domain
#      (Resend gives you 3 DNS records — SPF/DKIM/return-path — to add at your
#      DNS host; they coexist with your Google Workspace MX, no conflict).
#   2. Create an API key (Dashboard -> API Keys) and set RESEND_API_KEY below.
#   3. Add RESEND_API_KEY (and optionally the two below) to the Cloudflare
#      project's environment variables, then redeploy.
RESEND_API_KEY=
# Both default to sales@pyngyn.com. SUBSCRIBE_FROM must be on the verified
# Resend domain.
SUBSCRIBE_FROM=
SUBSCRIBE_TO=

# --- Optional integrations already read by the app ------------------------
# Slack/Zapier/HTTP endpoint that receives native demo bookings (app/api/demo).
DEMO_WEBHOOK_URL=
# Google Search Console "HTML tag" verification code (content value only).
GOOGLE_SITE_VERIFICATION=
