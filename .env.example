# Copy to .env.local (never commit real values).

# --- Footer "Get in touch" form (app/api/subscribe) -----------------------
# Emails the enquiry to sales@pyngyn.com via the Resend HTTPS API (a fetch), so
# it runs directly on Cloudflare — no SMTP, no separate server.
#
# Setup:
#   1. Sign up at resend.com and add + verify the pyngyn.com domain
#      (Resend gives you 3 DNS records — SPF/DKIM/return-path — to add at your
#      DNS host; they coexist with your Google Workspace MX, no conflict).
#   2. Create an API key (Dashboard -> API Keys) and set RESEND_API_KEY below.
#   3. Add RESEND_API_KEY (and optionally the two below) to the Cloudflare
#      project's environment variables, then redeploy.
RESEND_API_KEY=
# Both default to sales@pyngyn.com. SUBSCRIBE_FROM must be on the verified
# Resend domain.
SUBSCRIBE_FROM=
SUBSCRIBE_TO=

# --- Demo bookings (app/api/demo) ------------------------------------------
# Also sent through Resend (RESEND_API_KEY above): the team gets an email with
# the booking and a calendar file, and the visitor gets a confirmation. A
# booking is only confirmed to the visitor once the team email OR the webhook
# below succeeds, so set at least one of them.
# Where booking notifications go (defaults to SUBSCRIBE_TO, then sales@pyngyn.com).
DEMO_NOTIFY_TO=
# Optional Slack/Zapier/HTTP endpoint that also receives each booking as JSON.
DEMO_WEBHOOK_URL=

# --- Refer and earn (components/ReferralJoin.tsx) ---------------------------
# Public endpoint that saves referral codes (a Pyngyn Supabase Edge Function),
# e.g. https://<project-ref>.supabase.co/functions/v1/referral-code
# Ask the Pyngyn app team for the value. Never add Supabase keys to this site.
# Unset or unreachable: the form still shows the link it works out itself.
NEXT_PUBLIC_REFERRAL_ENDPOINT=
# Cloudflare Turnstile site key (invisible widget) for the referral form.
# Unset: no captcha is sent. Pyngyn checks it only once its secret is set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Optional integrations already read by the app ------------------------
# Google Search Console "HTML tag" verification code (content value only).
GOOGLE_SITE_VERIFICATION=
