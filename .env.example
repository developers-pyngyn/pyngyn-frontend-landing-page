# Copy to .env.local (never commit real values).

# --- Footer "Get in touch" form (app/api/subscribe) -----------------------
# Sends the subscriber's details to sales@pyngyn.com over Gmail SMTP.
#
# SMTP_PASS must be a Google **App Password**, not the account password:
#   1. Turn on 2-Step Verification for the sales@pyngyn.com Google account
#   2. Google Account -> Security -> App passwords -> create one for "Mail"
#   3. Paste the 16-character value below (spaces are fine to remove)
#
# NOTE ON HOSTING: SMTP needs a raw TCP socket, so /api/subscribe runs on the
# nodejs runtime. That works locally and on Node hosts (Vercel, Render, a VPS),
# but NOT on Cloudflare Workers/Pages, which cannot open SMTP connections. If
# this site stays on Cloudflare, this route has to move to a Node host or switch
# to an HTTPS email API instead.
SMTP_USER=sales@pyngyn.com
SMTP_PASS=
# Optional overrides:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Both default to SMTP_USER / sales@pyngyn.com.
SUBSCRIBE_FROM=
SUBSCRIBE_TO=

# --- Optional integrations already read by the app ------------------------
# Slack/Zapier/HTTP endpoint that receives native demo bookings (app/api/demo).
DEMO_WEBHOOK_URL=
# Google Search Console "HTML tag" verification code (content value only).
GOOGLE_SITE_VERIFICATION=
