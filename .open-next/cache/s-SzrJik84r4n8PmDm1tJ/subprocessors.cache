i/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"PYNGYN: Clientspace, a standalone branded client portal, and Workspace, a standalone back office for professional-services firms\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:site\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:creator\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:title\" content=\"PYNGYN: The operating system for professional-services firms\"/><meta name=\"twitter:description\" content=\"Run your firm and every client engagement in one place. The operating system for professional-services firms.\"/><meta name=\"twitter:image\" content=\"https://pyngyn.ai/og.png\"/><link rel=\"icon\" href=\"/icon.png\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png\"/><meta name=\"next-size-adjust\" content=\"\"/><script type=\"application/ld+json\" id=\"ld-organization\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://pyngyn.ai/#organization\",\"name\":\"PYNGYN\",\"legalName\":\"VIMOVI GlobalTech Private Limited\",\"url\":\"https://pyngyn.ai/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://pyngyn.ai/logo.png\",\"width\":512,\"height\":512},\"image\":\"https://pyngyn.ai/icon.png\",\"description\":\"PYNGYN gives every client a branded Client Space (a standalone portal for status, documents, and approvals), with Workspace, the firm's back office for projects, finances, and billable time, available on its own or bundled together.\",\"sameAs\":[\"https://x.com/Pyngyn_Official\",\"https://www.linkedin.com/company/pyngyn/\",\"https://www.reddit.com/user/Pyngyn_Official/\",\"https://www.facebook.com/profile.php?id=61584474731354\",\"https://www.youtube.com/@PyngynOfficial\",\"https://instagram.com/pyngyn_official\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"customer support\",\"email\":\"support@pyngyn.com\",\"url\":\"https://pyngyn.ai/support\",\"availableLanguage\":[\"English\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"sales@pyngyn.com\",\"url\":\"https://pyngyn.ai/demo\",\"availableLanguage\":[\"English\"]}]}</script><script type=\"application/ld+json\" id=\"ld-website\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://pyngyn.ai/#website\",\"url\":\"https://pyngyn.ai/\",\"name\":\"PYNGYN\",\"description\":\"The operating system for professional-services firms. Run your firm and every client engagement in one place.\",\"publisher\":{\"@id\":\"https://pyngyn.ai/#organization\"},\"inLanguage\":\"en\"}</script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-sans\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main\" class=\"sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white\">Skip to content</a><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://pyngyn.ai/subprocessors#webpage\",\"url\":\"https://pyngyn.ai/subprocessors\",\"name\":\"Subprocessors | PYNGYN\",\"description\":\"This page lists the subprocessors we use to provide the Pyngyn marketing site, free tools, and the app.pyngyn.ai product. We review this list periodically and update it when our processing partners change.\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"breadcrumb\":{\"@id\":\"https://pyngyn.ai/subprocessors#breadcrumb\"},\"dateModified\":\"June 24, 2026\",\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/subprocessors#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://pyngyn.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Subprocessors\",\"item\":\"https://pyngyn.ai/subprocessors\"}]}]}</script><header class=\"fixed inset-x-0 top-0 z-[100] border-b transition-all duration-300 border-transparent bg-transparent\"><div class=\"wrap flex h-[68px] items-center justify-between\"><a class=\"flex items-center\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><div class=\"hidden h-full lg:flex lg:items-center\"><nav class=\"flex items-center gap-7 text-[15px] text-[#3a3a42]\"><a class=\"py-2 transition-colors hover:text-accent\" href=\"/clientspace/\">Clientspace</a><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Product<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Solutions<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Resources<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Compare<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></nav></div><div class=\"flex items-center gap-3\"><a href=\"https://app.pyngyn.ai/\" class=\"hidden text-[15px] font-semibold lg:inline \">Sign in</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"hidden px-4 py-2.5 lg:inline-flex btn btn-ghost\">Start free</a><a href=\"/demo\" class=\"hidden px-[18px] py-2.5 lg:inline-flex btn btn-primary\">Book a demo</a><button type=\"button\" class=\"grid h-10 w-10 place-items-center rounded-lg border lg:hidden border-line bg-white text-ink\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"mobile-menu\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"></path></svg></button></div></div></header><main id=\"main\" class=\"wrap pb-[104px] pt-[150px]\"><article class=\"mx-auto max-w-[820px]\"><h1 class=\"font-display text-[clamp(32px,4.4vw,48px)] font-semibold leading-[1.08] tracking-[-0.025em]\">Subprocessors</h1><p class=\"mt-3 text-[14px] text-muted\">Last updated: <!-- -->June 24, 2026</p><p class=\"mt-1.5 text-[14px] text-muted\"><span>Read alongside our </span><a class=\"text-accent underline underline-offset-2 hover:text-ink\" href=\"/privacy/\">Privacy Policy</a><span> and </span><a class=\"text-accent underline underline-offset-2 hover:text-ink\" href=\"/dpa/\">Data Processing Agreement</a><span>.</span></p><p class=\"mt-6 text-[17px] leading-[1.7] text-ink\"><span>This page lists the subprocessors we use to provide the Pyngyn marketing site, free tools, and the app.pyngyn.ai product. We review this list periodically and update it when our processing partners change.</span></p><div class=\"mt-10 flex flex-col gap-9\"><section><h2 class=\"font-display text-[22px] font-semibold tracking-[-0.01em]\">1. Infrastructure Subprocessors</h2><div class=\"mt-3 flex flex-col gap-3.5\"><div class=\"overflow-x-auto rounded-[14px] border border-line\"><table class=\"w-full min-w-[560px] border-collapse text-left text-[14px]\"><thead><tr class=\"bg-[#fbfbfd]\"><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Sub-processor</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Purpose of processing</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Location(s)</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">More information</th></tr></thead><tbody><tr class=\"\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Google Cloud Platform</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Infrastructure &amp; cloud hosting (asia-south1 region) for app.pyngyn.ai, including database and compute services.</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>India</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><a href=\"https://cloud.google.com/security/compliance\" class=\"text-accent underline underline-offset-2 hover:text-ink\">cloud.google.com/security/compliance</a></td></tr></tbody></table></div></div></section><section><h2 class=\"font-display text-[22px] font-semibold tracking-[-0.01em]\">2. Platform Subprocessors</h2><div class=\"mt-3 flex flex-col gap-3.5\"><div class=\"overflow-x-auto rounded-[14px] border border-line\"><table class=\"w-full min-w-[560px] border-collapse text-left text-[14px]\"><thead><tr class=\"bg-[#fbfbfd]\"><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Sub-processor</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Purpose of processing</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Location(s)</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">More information</th></tr></thead><tbody><tr class=\"border-b border-line\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Google Tag Manager</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Tag and script management on the marketing site (loads other analytics/marketing tags below).</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>USA</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><a href=\"https://policies.google.com/privacy\" class=\"text-accent underline underline-offset-2 hover:text-ink\">policies.google.com/privacy</a></td></tr><tr class=\"border-b border-line\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Google Analytics (GA4)</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Marketing site analytics, page views, timestamps, referrer paths, and session behavior.</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>USA</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><a href=\"https://policies.google.com/privacy\" class=\"text-accent underline underline-offset-2 hover:text-ink\">policies.google.com/privacy</a></td></tr><tr class=\"border-b border-line\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Meta Platforms (Meta Pixel)</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Marketing campaign measurement and conversion tracking on the marketing site.</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>USA</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><a href=\"https://www.facebook.com/privacy/policy/\" class=\"text-accent underline underline-offset-2 hover:text-ink\">facebook.com/privacy/policy</a></td></tr><tr class=\"border-b border-line\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Google Fonts</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Web font delivery for site typography; loading a font shares the visitor&#x27;s IP address with Google.</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>USA</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><a href=\"https://policies.google.com/privacy\" class=\"text-accent underline underline-offset-2 hover:text-ink\">policies.google.com/privacy</a></td></tr><tr class=\"border-b border-line\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Microsoft Entra ID</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Identity and access management for internal team accounts and Organization-level SSO.</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>USA, EU</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><a href=\"https://www.microsoft.com/en-us/trust-center/privacy\" class=\"text-accent underline underline-offset-2 hover:text-ink\">microsoft.com/trust-center/privacy</a></td></tr><tr class=\"\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Clerk</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>User authentication, account creation, session management, SSO, and passwordless login for app.pyngyn.ai.</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>USA</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><a href=\"https://clerk.com/legal/privacy\" class=\"text-accent underline underline-offset-2 hover:text-ink\">clerk.com/legal/privacy</a></td></tr></tbody></table></div></div></section><section><h2 class=\"font-display text-[22px] font-semibold tracking-[-0.01em]\">3. LLM / Gen AI Capabilities Subprocessors</h2><div class=\"mt-3 flex flex-col gap-3.5\"><div class=\"overflow-x-auto rounded-[14px] border border-line\"><table class=\"w-full min-w-[560px] border-collapse text-left text-[14px]\"><thead><tr class=\"bg-[#fbfbfd]\"><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Sub-processor</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Purpose of processing</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Location(s)</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">More information</th></tr></thead><tbody><tr class=\"\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Anthropic</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Provides AI functionality across the Pyngyn platform, including automatic task generation, customer support assistance, organizational health summaries, task assignment recommendations, project insights, workflow recommendations, and other AI-powered features available within app.pyngyn.ai.</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>USA</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><a href=\"https://www.anthropic.com/legal/privacy\" class=\"text-accent underline underline-offset-2 hover:text-ink\">anthropic.com/legal/privacy</a></td></tr></tbody></table></div></div></section><section><h2 class=\"font-display text-[22px] font-semibold tracking-[-0.01em]\">4. Customer Support &amp; Scheduling Subprocessors</h2><div class=\"mt-3 flex flex-col gap-3.5\"><div class=\"overflow-x-auto rounded-[14px] border border-line\"><table class=\"w-full min-w-[560px] border-collapse text-left text-[14px]\"><thead><tr class=\"bg-[#fbfbfd]\"><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Sub-processor</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Purpose of processing</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Location(s)</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">More information</th></tr></thead><tbody><tr class=\"\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Calendly</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Demo scheduling via the /demo page, collects name, email, and meeting details directly into the Calendly account.</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>USA</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><a href=\"https://calendly.com/privacy\" class=\"text-accent underline underline-offset-2 hover:text-ink\">calendly.com/privacy</a></td></tr></tbody></table></div></div></section><section><h2 class=\"font-display text-[22px] font-semibold tracking-[-0.01em]\">5. Payments Subprocessors</h2><div class=\"mt-3 flex flex-col gap-3.5\"><div class=\"overflow-x-auto rounded-[14px] border border-line\"><table class=\"w-full min-w-[560px] border-collapse text-left text-[14px]\"><thead><tr class=\"bg-[#fbfbfd]\"><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Sub-processor</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Purpose of processing</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Location(s)</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">More information</th></tr></thead><tbody><tr class=\"\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Razorpay</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Payment processing for paid subscriptions and invoicing.</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>India</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><a href=\"https://razorpay.com/privacy/\" class=\"text-accent underline underline-offset-2 hover:text-ink\">razorpay.com/privacy</a></td></tr></tbody></table></div></div></section><section><h2 class=\"font-display text-[22px] font-semibold tracking-[-0.01em]\">6. What we don&#x27;t send anywhere</h2><div class=\"mt-3 flex flex-col gap-3.5\"><p class=\"text-[16px] leading-[1.7] text-ink\"><span>Several interactions on our marketing site never reach a subprocessor or our own servers at all:</span></p><ul class=\"flex flex-col gap-2\"><li class=\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\"><span class=\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\" aria-hidden=\"true\"></span><span><strong>Browser-only storage.</strong><span> The promo popup timer, workspace offer countdown, and roadmap upvotes are stored using your browser&#x27;s in-memory state or </span><strong>localStorage</strong><span> only. None of this is transmitted to Pyngyn or to any subprocessor.</span></span></li><li class=\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\"><span class=\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\" aria-hidden=\"true\"></span><span><strong>Calculator tools.</strong><span> Inputs to our ROI, cost-margin, and team-utilization calculators stay in your browser unless you choose to copy or share the results, there is no backend collection for these tools in our current implementation.</span></span></li></ul></div></section></div></article></main><footer class=\"border-t border-line bg-white pt-16 pb-10 text-sm text-muted\"><div class=\"wrap\"><div class=\"grid gap-10 lg:grid-cols-[1.4fr_repeat(5,1fr)]\"><div><a class=\"mb-4 inline-block\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"