site\"},\"inLanguage\":\"en\"},{\"@type\":\"SoftwareApplication\",\"@id\":\"https://pyngyn.ai/#software\",\"name\":\"PYNGYN\",\"applicationCategory\":\"BusinessApplication\",\"applicationSubCategory\":\"Project Management Software\",\"operatingSystem\":\"Web, iOS, Android\",\"url\":\"https://pyngyn.ai/\",\"description\":\"PYNGYN is an operating system for professional-services firms: a standalone branded client portal (Client Space) and a standalone back office for projects, finances, and billable time (Workspace), with AI that drafts plans, keeps status current, and flags risk before it slips.\",\"publisher\":{\"@id\":\"https://pyngyn.ai/#organization\"},\"offers\":{\"@type\":\"Offer\",\"price\":9,\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://pyngyn.ai/pricing\"},\"featureList\":[\"AI-generated project plans from plain-language goals\",\"Automatic status updates from work activity\",\"Risk detection and slip prediction\",\"Timeline and Gantt views\",\"Task dependencies and owners\",\"One-click import from other trackers\",\"SSO / SAML and SOC 2 aligned controls\"]},{\"@type\":\"FAQPage\",\"@id\":\"https://pyngyn.ai/#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What happens in the demo?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A 30-minute guided walkthrough where we run PYNGYN on an engagement like yours, with no generic slideshow.\"}},{\"@type\":\"Question\",\"name\":\"Do I have to trust the AI's plan?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Every plan is fully editable. PYNGYN drafts; you decide.\"}},{\"@type\":\"Question\",\"name\":\"Can I import from my current tool?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. One-click import from common trackers, with mapping handled for you.\"}},{\"@type\":\"Question\",\"name\":\"Is my data used to train AI?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Not without your explicit consent. Your data stays yours.\"}},{