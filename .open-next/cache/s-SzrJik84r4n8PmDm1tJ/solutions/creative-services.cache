"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"index-num\",\"children\":\"03\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[17px] font-bold leading-snug\",\"children\":\"Feedback scattered everywhere\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"Notes come in by email, voice memo, marked-up PDF, and in comments on a shared file. Consolidating them is its own project.\"}]]}],[\"$\",\"div\",\"04\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"index-num\",\"children\":\"04\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[17px] font-bold leading-snug\",\"children\":\"Deadlines slip without warning\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"Production depends on a client decision that has not come. The deadline risk is invisible until you are already late.\"}]]}],[\"$\",\"div\",\"05\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"index-num\",\"children\":\"05\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[17px] font-bold leading-snug\",\"children\":\"No live profitability per project\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"Fixed-fee projects live and die by hours spent. You find out you went over at billing, not when you could have reset scope.\"}]]}],[\"$\",\"div\",\"06\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"index-num\",\"children\":\"06\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[17px] font-bold leading-snug\",\"children\":\"Client confusion at delivery\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"The client is not sure what they approved, when, or what is still outstanding. Sign-off turns into a back-and-forth.\"}]]}]]}]]}]}]\n17:[\"$\",\"section\",null,{\"className\":\"section\",\"