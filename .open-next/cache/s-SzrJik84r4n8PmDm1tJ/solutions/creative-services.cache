],[\"$\",\"div\",null,{\"className\":\"mt-10 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",\"01\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"index-num\",\"children\":\"01\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[17px] font-bold leading-snug\",\"children\":\"Briefs misunderstood at handoff\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"The brief goes in, the first concepts come back, and the client says that is not what they meant. Two rounds wasted because the brief was never locked.\"}]]}],[\"$\",\"div\",\"02\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"index-num\",\"children\":\"02\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[17px] font-bold leading-snug\",\"children\":\"Revision rounds go over\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"Three rounds are in scope. The client is on round six. Nobody tracked the extras, and the conversation about scope is awkward to have after the fact.\"}]]}],[\"$\",\"div\",\"03\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"index-num\",\"children\":\"03\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[17px] font-bold leading-snug\",\"children\":\"Feedback scattered everywhere\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"Notes come in by email, voice memo, marked-up PDF, and in comments on a shared file. Consolidating them is its own project.\"}]]}],[\"$\",\"div\",\"04\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"index-num\",\"children\":\"04\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[17px] font-bold leading-snug\",\"children\":\"Deadlines slip without warning\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"Production depends on a client decision that has not come. The deadline risk is invisible until you are already late.\"}]]}],[\"$\",\"div\",\"05\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"index-num\",\"children\":\"05\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[17px] font-bold leading-snug\",\"children\":\"No live profitability per project\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"Fixed-fee projects live and die by hours spent. You find out you went over at billing, not when you could have reset scope.\"}]]}],[\"$\",\"div\",\"06\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"index-num\",\"children\":\"06\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[17px] font-bold leading-snug\",\"children\":\"Client confusion at delivery\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"The client is not sure what they approved, when, or what is still outstanding. Sign-off turns into a back-and-forth.\"}]]}]]}]]}]}]\n17:[\"$\",\"section\",null,{\"className\":\"section\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":\"The client portal\"}],[\"$\",\"span\",null,{\"className\":\"rounded-full border border-accent/40 px-2.5 py-0.5 text-[11px] font-bold text-accent\",\"children\":\"Client Space\"}]]}],[\"$\",\"h2\",null,{\"className\":\"mt-3 max-w-[820px] font-display text-[clamp(26px,3.4vw,40px)] font-semibold leading-tight tracking-[-0.025em]\",\"children\":[\"A branded portal for every client.\",[\"$\",\"span\",null,{\"className\":\"block text-accent\",\"children\":\"$$19 per client / month, standalone.\"}]]}],[\"$\",\"p\",null,{\"className\":\"lead mt-4 max-w-[640px]\",\"children\":\"Give each client their own isolated, white-labeled