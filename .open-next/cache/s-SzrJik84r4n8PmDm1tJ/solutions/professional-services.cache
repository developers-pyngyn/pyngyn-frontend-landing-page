\n28:[[\"$\",\"title\",\"0\",{\"children\":\"Professional Services OS | PYNGYN\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"PYNGYN gives every client a standalone branded Client Space (a portal for status, documents, and approvals). Workspace, your firm's back office, is available on its own or bundled. Built for lawyers, accountants, consultants, agencies, and architects.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"author\",\"content\":\"Nikunj Chugh\"}],[\"$\",\"meta\",\"3\",{\"name\":\"creator\",\"content\":\"Nikunj Chugh\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://pyngyn.ai/solutions/professional-services/\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Professional Services OS | PYNGYN\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Client Space for every client. Workspace for your team. The operating system for professional-services firms.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:url\",\"content\":\"https://pyngyn.ai/solutions/professional-services/\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image\",\"content\":\"https://pyngyn.ai/og.png\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:image:alt\",\"content\":\"PYNGYN: Clientspace, a standalone branded client portal, and Workspace, a standalone back office for professional-services firms\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:site\",\"content\":\"@Pyngyn_Official\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:creator\",\"content\":\"@Pyngyn_Official\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:title\",\"content\":\"PYNGYN: The operating system for professional-services firms\"}],[\"$\",\"meta\",\"17\",{\"name\":\"twitter:description\",\"content\":\"Run your firm and every client engagement in one place. The operating system for professional-services firms.\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:image\",\"content\":\"https://pyngyn.ai/og.png\"}],[\"$\",\"link\",\"19\",{\"rel\":\"icon\",\"href\":\"/icon.png\"}],[\"$\",\"link\",\"20\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png\"}],[\"$\",\"$L35\",\"21\",{}]]\n34:null\n","/solutions/professional-services/__PAGE__":"1:\"$Sreact.fragment\"\n3:I[62319,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/41mnvtr75by45.js\",\"/_next/static/chunks/1_p0c8_mtfqqv.js\"],\"Navbar\"]\n2:Tb86,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://pyngyn.ai/solutions/professional-services#webpage\",\"url\":\"https://pyngyn.ai/solutions/professional-services\",\"name\":\"Professional Services OS | PYNGYN\",\"description\":\"PYNGYN gives every client a standalone branded Client Space. Workspace, your firm's back office, is available on its own or bundled.\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"breadcrumb\":{\"@id\":\"https://pyngyn.ai/solutions/professional-services#breadcrumb\"},\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/solutions/professional-services#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://pyngyn.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Solutions\",\"item\":\"https://pyngyn.ai/solutions/professional-services\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Professional Services\",\"item\":\"https://pyngyn.ai/solutions/professional-services\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://pyngyn.ai/solutions/professional-services#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Who is PYNGYN built for?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Professional-services firms, law, accounting, consulting, agencies, creative studios, and architecture practices. It's not a generic project tool; every feature is designed around how firms deliver client work.\"}},{\"@type\":\"Question\",\"name\":\"What is Workspace?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Workspace is the operating system for your firm's internal work: projects, tasks, calendar, finance, billable timesheets, Business Brain AI, automations, team skills, and 240+ templates. Every internal seat gets Workspace.\"}},{\"@type\":\"Question\",\"name\":\"What is Client Space?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Client Space is a branded client portal, sold standalone at $19/month per client, no Workspace purchase required. Each client gets their own isolated space showing their deliverables, status, and approvals. Firms that also want Workspace can bundle both for $24.99/month.\"}},{\"@type\":\"Question\",\"name\":\"What are the four roles?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Directors/partners see the whole firm. Managers see their engagements. ICs see their tasks. Clients see only their own Client Space. Role-based access is enforced automatically.\"}},{\"@type\":\"Question\",\"name\":\"How is PYNGYN different from generic PM tools?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Generic tools (Asana, Monday, ClickUp) have no concept of a client portal, billable time, engagement profitability, or firm-level finance. PYNGYN is built around the professional-services delivery model from the ground up.\"}},{\"@type\":\"Question\",\"name\":\"How long does setup take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Most firms are delivering inside PYNGYN within a week. Import from your current tool, set up your first engagement, and invite clients to their Client Space, all on day one.\"}}]}]}16:X\n1b:X\n1b:C\n0:{\"buildId\":\"s-SzrJik84r4n8PmDm1tJ\",\"data\":[{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+j