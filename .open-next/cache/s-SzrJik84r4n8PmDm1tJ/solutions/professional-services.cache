{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/solutions/layout,_N_T_/solutions/professional-services/layout,_N_T_/solutions/professional-services/page,_N_T_/solutions/professional-services"},"segmentPaths":["/_tree","/_full","/solutions/professional-services/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"display_2a073e65-module__7MkqkG__variable jakarta_55fc869e-module__LB2P7q__variable mono_8ba1b3ff-module__cxzmQq__variable\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_400_normal-s.p.2_o2v7tpo0q5m.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_500_normal-s.p.3vqzgd2jdiw22.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_600_normal-s.p.3_r60-qkmao3a.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_700_normal-s.p.0rb33xx2bxpl8.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_400_normal-s.p.3crsbyy6lh6yf.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_500_normal-s.p.2h52d08o60qht.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_600_normal-s.p.2mm922pe315l1.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_400_normal-s.p.2ysn9gc82zk1v.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_500_normal-s.p.1evhelic1rxge.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_600_normal-s.p.0p6sew1q6gl7s.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_700_normal-s.p.1dulefe5e4s81.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"/logo.webp\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/02mkr0z8o939x.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1b-l3oagpuv39.js\"/><script src=\"/_next/static/chunks/11jq0c2_zavac.js\" async=\"\"></script><script src=\"/_next/static/chunks/4561u0v7ysn3r.js\" async=\"\"></script><script src=\"/_next/static/chunks/021sppg0zbt0v.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2pcc6e_qu_s3g.js\" async=\"\"></script><script src=\"/_next/static/chunks/0ht-3v40sanoo.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/41mnvtr75by45.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/1_p0c8_mtfqqv.js\" async=\"\" crossorigin=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Professional Services OS | PYNGYN</title><meta name=\"description\" content=\"PYNGYN gives every client a standalone branded Client Space (a portal for status, documents, and approvals). Workspace, your firm&#x27;s back office, is available on its own or bundled. Built for lawyers, accountants, consultants, agencies, and architects.\"/><meta name=\"author\" content=\"Nikunj Chugh\"/><meta name=\"creator\" content=\"Nikunj Chugh\"/><link rel=\"canonical\" href=\"https://pyngyn.ai/solutions/professional-services/\"/><meta property=\"og:title\" content=\"Professional Services OS | PYNGYN\"/><meta property=\"og:description\" content=\"Client Space for every client. Workspace for your team. The operating system for professional-services firms.\"/><meta property=\"og:url\" content=\"https://pyngyn.ai/solutions/professional-services/\"/><meta property=\"og:image\" content=\"https://pyngyn.ai/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"PYNGYN: Clientspace, a standalone branded client portal, and Workspace, a standalone back office for professional-services firms\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:site\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:creator\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:title\" content=\"PYNGYN: The operating system for professional-services firms\"/><meta name=\"twitter:description\" content=\"Run your firm and every client engagement in one place. The operating system for professional-services firms.\"/><meta name=\"twitter:image\" content=\"https://pyngyn.ai/og.png\"/><link rel=\"icon\" href=\"/icon.png\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png\"/><script type=\"application/ld+json\" id=\"ld-organization\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://pyngyn.ai/#organization\",\"name\":\"PYNGYN\",\"legalName\":\"VIMOVI GlobalTech Private Limited\",\"url\":\"https://pyngyn.ai/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://pyngyn.ai/logo.png\",\"width\":512,\"height\":512},\"image\":\"https://pyngyn.ai/icon.png\",\"description\":\"PYNGYN gives every client a branded Client Space (a standalone portal for status, documents, and approvals), with Workspace, the firm's back office for projects, finances, and billable time, available on its own or bundled together.\",\"sameAs\":[\"https://x.com/Pyngyn_Official\",\"https://www.linkedin.com/company/pyngyn/\",\"https://www.reddit.com/user/Pyngyn_Official/\",\"https://www.facebook.com/profile.php?id=61584474731354\",\"https://www.youtube.com/@PyngynOfficial\",\"https://instagram.com/pyngyn_official\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"customer support\",\"email\":\"support@pyngyn.com\",\"url\":\"https://pyngyn.ai/support\",\"availableLanguage\":[\"English\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"sales@pyngyn.com\",\"url\":\"https://pyngyn.ai/demo\",\"availableLanguage\":[\"English\"]}]}</script><script type=\"application/ld+json\" id=\"ld-website\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://pyngyn.ai/#website\",\"url\":\"https://pyngyn.ai/\",\"name\":\"PYNGYN\",\"description\":\"The operating system for professional-services firms. Run your firm and every client engagement in one place.\",\"publisher\":{\"@id\":\"https://pyngyn.ai/#organization\"},\"inLanguage\":\"en\"}</script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-sans\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main\" class=\"sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white\">Skip to content</a><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://pyngyn.ai/solutions/professional-services#webpage\",\"url\":\"https://pyngyn.ai/solutions/professional-services\",\"name\":\"Professional Services OS | PYNGYN\",\"description\":\"PYNGYN gives every client a standalone branded Client Space. Workspace, your firm's back office, is available on its own or bundled.\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"breadcrumb\":{\"@id\":\"https://pyngyn.ai/solutions/professional-services#breadcrumb\"},\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/solutions/professional-services#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://pyngyn.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Solutions\",\"item\":\"https://pyngyn.ai/solutions/professional-services\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Professional Services\",\"item\":\"https://pyngyn.ai/solutions/professional-services\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://pyngyn.ai/solutions/professional-services#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Who is PYNGYN built for?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Professional-services firms, law, accounting, consulting, agencies, creative studios, and architecture practices. It's not a generic project tool; every feature is designed around how firms deliver client work.\"}},{\"@type\":\"Question\",\"name\":\"What is Workspace?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Workspace is the operating system for your firm's internal work: projects, tasks, calendar, finance, billable timesheets, Business Brain AI, automations, team skills, and 240+ templates. Every internal seat gets Workspace.\"}},{\"@type\":\"Question\",\"name\":\"What is Client Space?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Client Space is a branded client portal, sold standalone at $19/month per client, no Workspace purchase required. Each client gets their own isolated space showing their deliverables, status, and approvals. Firms that also want Workspace can bundle both for $24.99/month.\"}},{\"@type\":\"Question\",\"name\":\"What are the four roles?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Directors/partners see the whole firm. Managers see their engagements. ICs see their tasks. Clients see only their own Client Space. Role-based access is enforced automatically.\"}},{\"@type\":\"Question\",\"name\":\"How is PYNGYN different from generic PM tools?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Generic tools (Asana, Monday, ClickUp) have no concept of a client portal, billable time, engagement profitability, or firm-level finance. PYNGYN is built around the professional-services delivery model from the ground up.\"}},{\"@type\":\"Question\",\"name\":\"How long does setup take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Most firms are delivering inside PYNGYN within a week. Import from your current tool, set up your first engagement, and invite clients to their Client Space, all on day one.\"}}]}]}</script><header class=\"fixed inset-x-0 top-0 z-[100] border-b transition-all duration-300 border-transparent bg-transparent\"><div class=\"wrap flex h-[68px] items-center justify-between\"><a class=\"flex items-center\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><div class=\"hidden h-full lg:flex lg:items-center\"><nav class=\"flex items-center gap-7 text-[15px] text-[#3a3a42]\"><a class=\"py-2 transition-colors hover:text-accent\" href=\"/clientspace/\">Clientspace</a><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Product<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Solutions<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Resources<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Compare<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></nav></div><div class=\"flex items-center gap-3\"><a href=\"https://app.pyngyn.ai/\" class=\"hidden text-[15px] font-semibold lg:inline \">Sign in</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"hidden px-4 py-2.5 lg:inline-flex btn btn-ghost\">Start free</a><a href=\"/demo\" class=\"hidden px-[18px] py-2.5 lg:inline-flex btn btn-primary\">Book a demo</a><button type=\"button\" class=\"grid h-10 w-10 place-items-center rounded-lg border lg:hidden border-line bg-white text-ink\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"mobile-menu\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"></path></svg></button></div></div></header><main id=\"main\"><section class=\"wrap pb-[60px] pt-[140px]\"><span class=\"eyebrow\">Professional Services</span><h1 class=\"mt-4 max-w-[900px] font-display text-[clamp(34px,5.2vw,60px)] font-semibold leading-[1.04] tracking-[-0.025em]\">One place to run your firm<br class=\"hidden sm:block\"/> and<!-- --> <span class=\"text-accent\">every client engagement.</span></h1><p class=\"lead mt-5 max-w-[680px]\">PYNGYN gives every client their own standalone branded <strong>Client Space</strong>, a portal where they see their status, documents, and approvals 24/7, instead of emailing you for updates. No <strong>Workspace</strong> purchase required, though firms that also want to run projects, finances, and billable time internally can add it or bundle both.</p><div class=\"mt-8 flex flex-wrap gap-3\"><a href=\"/demo\" class=\"btn btn-accent\">Book a demo</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-primary\">Start free trial</a></div><p class=\"mt-4 text-[13px] text-muted\">30-min walkthrough on your firm&#x27;s workflows · No commitment</p></section><section class=\"wrap pb-[60px]\"><span class=\"eyebrow\">Built for your practice</span><h2 class=\"mt-3 font-display text-[clamp(22px,3vw,32px)] font-semibold tracking-[-0.02em]\">Which type of firm are you?</h2><div class=\"mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5\"><a class=\"card group flex flex-col gap-3 transition-all hover:border-accent hover:shadow-soft\" href=\"/solutions/lawyers/\"><span class=\"text-[28px]\" aria-hidden=\"true\">⚖️</span><div><div class=\"font-semibold text-ink group-hover:text-accent transition-colors\">Lawyers</div><div class=\"mt-1 text-[13px] leading-relaxed text-muted\">Matter management, deadlines, and client portals for law firms.</div></div><span class=\"mt-auto text-[12.5px] font-semibold text-accent\">See how it works →</span></a><a class=\"card group flex flex-col gap-3 transition-all hover:border-accent hover:shadow-soft\" href=\"/solutions/accountants/\"><span class=\"text-[28px]\" aria-hidden=\"true\">📊</span><div><div class=\"font-semibold text-ink group-hover:text-accent transition-colors\">Accountants &amp; CAs</div><div class=\"mt-1 text-[13px] leading-relaxed text-muted\">Audit pipelines, statutory deadlines, and filing workflows.</div></div><span class=\"mt-auto text-[12.5px] font-semibold text-accent\">See how it works →</span></a><a class=\"card group flex flex-col gap-3 transition-all hover:border-accent hover:shadow-soft\" href=\"/solutions/consultants/\"><span class=\"text-[28px]\" aria-hidden=\"true\">📣</span><div><div class=\"font-semibold text-ink group-hover:text-accent transition-colors\">Marketing Consultants</div><div class=\"mt-1 text-[13px] leading-relaxed text-muted\">Retainers, campaigns, and client approvals in one place.</div></div><span class=\"mt-auto text-[12.5px] font-semibold text-accent\">See how it works →</span></a><a class=\"card group flex flex-col gap-3 transition-all hover:border-accent hover:shadow-soft\" href=\"/solutions/creative-services/\"><span class=\"text-[28px]\" aria-hidden=\"true\">🎨</span><div><div class=\"font-semibold text-ink group-hover:text-accent transition-colors\">Creative Services</div><div class=\"mt-1 text-[13px] leading-relaxed text-muted\">Briefs, revision rounds, and sign-offs across client projects.</div></div><span class=\"mt-auto text-[12.5px] font-semibold text-accent\">See how it works →</span></a><a class=\"card group flex flex-col gap-3 transition-all hover:border-accent hover:shadow-soft\" href=\"/solutions/architects/\"><span class=\"text-[28px]\" aria-hidden=\"true\">📐</span><div><div class=\"font-semibold text-ink group-hover:text-accent transition-colors\">Architects</div><div class=\"mt-1 text-[13px] leading-relaxed text-muted\">Design phases, consultant coordination, and permit tracking.</div></div><span class=\"mt-auto text-[12.5px] font-semibold text-accent\">See how it works →</span></a></div></section><section class=\"section bg-[#fbfbfd]\"><div class=\"wrap\"><span class=\"eyebrow\">Why firms switch</span><h2 class=\"mt-3 max-w-[760px] font-display text-[clamp(26px,3.4vw,40px)] font-semibold leading-tight tracking-[-0.025em]\">The problems every services firm knows.</h2><div class=\"mt-10 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-3\"><div class=\"card h-full\"><div class=\"index-num\">01</div><h3 class=\"mt-3 text-[17px] font-bold leading-snug\">Status lives in WhatsApp</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Updates scatter across messages, emails, and spreadsheets. Nobody has the full picture before a client call, and every partner carries the picture in their head.</p></div><div class=\"card h-full\"><div class=\"index-num\">02</div><h3 class=\"mt-3 text-[17px] font-bold leading-snug\">You learn about losses after invoicing</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Without live engagement health, you only find out a project was unprofitable after billing. By then the overrun has already happened.</p></div><div class=\"card h-full\"><div class=\"index-num\">03</div><h3 class=\"mt-3 text-[17px] font-bold leading-snug\">Knowledge walks out the door</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">A senior leaves and takes five years of client context with them. Nobody wrote it down. The next engagement starts from zero.</p></div><div class=\"card h-full\"><div class=\"index-num\">04</div><h3 class=\"mt-3 text-[17px] font-bold leading-snug\">Clients don&#x27;t know where things stand</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Clients email for updates. You chase the team for answers. Everybody loses time doing administration instead of work.</p></div><div class=\"card h-full\"><div class=\"index-num\">05</div><h3 class=\"mt-3 text-[17px] font-bold leading-snug\">SOP drift erodes quality</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">The onboarding process lives in one partner&#x27;s head. It gets done differently every time. Quality depends on who is available.</p></div><div class=\"card h-full\"><div class=\"index-num\">06</div><h3 class=\"mt-3 text-[17px] font-bold leading-snug\">Deadlines slip without warning</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Risk is invisible until it has already cost you the date. The first time you hear about a problem is when the client does.</p></div></div></div></section><section class=\"section\"><div class=\"wrap\"><div class=\"flex items-center gap-3\"><span class=\"eyebrow\">The client portal</span><span class=\"rounded-full border border-accent/40 px-2.5 py-0.5 text-[11px] font-bold text-accent\">Client Space</span></div><h2 class=\"mt-3 max-w-[820px] font-display text-[clamp(26px,3.4vw,40px)] font-semibold leading-tight tracking-[-0.025em]\">A branded portal for every client.<span class=\"block text-accent\">$19 per client / month, standalone.</span></h2><p class=\"lead mt-4 max-w-[680px]\">Give each client their own isolated, white-labeled portal. They see their deliverables, status, and approvals, nothing from your other clients, and nothing from your internal operations.</p><div class=\"mt-10 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-3\"><div class=\"card h-full\"><span class=\"text-[28px]\" aria-hidden=\"true\">🏷️</span><h3 class=\"mt-3 text-[16px] font-bold\">Branded client portal</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">White-labeled with your firm&#x27;s identity. Clients land in a space that looks like yours.</p></div><div class=\"card h-full\"><span class=\"text-[28px]\" aria-hidden=\"true\">🔒</span><h3 class=\"mt-3 text-[16px] font-bold\">One isolated space per client</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Each client sees only their own engagement. Nothing leaks between clients.</p></div><div class=\"card h-full\"><span class=\"text-[28px]\" aria-hidden=\"true\">✅</span><h3 class=\"mt-3 text-[16px] font-bold\">Client-visible tasks and status</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Clients see what you want them to see: deliverables, milestones, and current status, nothing else.</p></div><div class=\"card h-full\"><span class=\"text-[28px]\" aria-hidden=\"true\">📝</span><h3 class=\"mt-3 text-[16px] font-bold\">Approvals and sign-off</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Clients approve deliverables inside their portal. No email threads, no lost attachments.</p></div><div class=\"card h-full\"><span class=\"text-[28px]\" aria-hidden=\"true\">🔗</span><h3 class=\"mt-3 text-[16px] font-bold\">Shareable invite links</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Add clients with a link. No onboarding required on their end.</p></div></div></div></section><section class=\"section bg-[#fbfbfd]\"><div class=\"wrap\"><div class=\"flex items-center gap-3\"><span class=\"eyebrow\">The engine</span><span class=\"rounded-full border border-line px-2.5 py-0.5 text-[11px] font-bold text-muted\">Workspace</span></div><h2 class=\"mt-3 max-w-[820px] font-display text-[clamp(26px,3.4vw,40px)] font-semibold leading-tight tracking-[-0.025em]\">Your firm&#x27;s operating system.<span class=\"block text-accent\">$9 per seat / month.</span></h2><p class=\"lead mt-4 max-w-[680px]\">Everything directors, managers, and ICs need to run client work and the firm in one place, with AI that keeps plans, status, and risk current automatically.</p><div class=\"mt-10 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-3\"><div class=\"card h-full\"><span class=\"text-[28px]\" aria-hidden=\"true\">📋</span><h3 class=\"mt-3 text-[16px] font-bold\">Projects, tasks, and calendar</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Run all client engagements and internal work in one board. Milestones, owners, and due dates always visible.</p></div><div class=\"card h-full\"><span class=\"text-[28px]\" aria-hidden=\"true\">💰</span><h3 class=\"mt-3 text-[16px] font-bold\">Finance dashboard</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Revenue, MRR, and profit tracked live. Know if an engagement is profitable while it&#x27;s running, not after the invoice.</p></div><div class=\"card h-full\"><span class=\"text-[28px]\" aria-hidden=\"true\">⏱️</span><h3 class=\"mt-3 text-[16px] font-bold\">Billable timesheets</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Log billable vs non-billable hours. Export to CSV for invoicing with one click.</p></div><div class=\"card h-full\"><span class=\"text-[28px]\" aria-hidden=\"true\">🧠</span><h3 class=\"mt-3 text-[16px] font-bold\">Business Brain</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Context-aware AI trained on your firm&#x27;s knowledge. Drafts plans, writes status, and flags risk.</p></div><div class=\"card h-full\"><span class=\"text-[28px]\" aria-hidden=\"true\">⚡</span><h3 class=\"mt-3 text-[16px] font-bold\">Automation builder</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Plain-English automation: &#x27;when a task moves to review, notify the client.&#x27; No code needed.</p></div><div class=\"card h-full\"><span class=\"text-[28px]\" aria-hidden=\"true\">👥</span><h3 class=\"mt-3 text-[16px] font-bold\">Team skills and roles</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Skills, benchmarks, and gap insights across directors, managers, and ICs. 240+ workflow templates.</p></div></div></div></section><section class=\"section\"><div class=\"wrap\"><span class=\"eyebrow\">Role-based access</span><h2 class=\"mt-3 max-w-[760px] font-display text-[clamp(26px,3.4vw,40px)] font-semibold leading-tight tracking-[-0.025em]\">Everyone sees exactly what they need.</h2><p class=\"lead mt-4 max-w-[640px]\">PYNGYN comes with four roles. Each role controls what a person can see and do, enforced automatically, no configuration required.</p><div class=\"mt-10 grid gap-[18px] sm:grid-cols-2\"><div class=\"card h-full\"><div class=\"flex items-center gap-3\"><span class=\"text-[28px]\" aria-hidden=\"true\">🏛️</span><h3 class=\"text-[17px] font-bold\">Director / Partner</h3></div><div class=\"mt-4 space-y-2\"><div class=\"flex gap-2 text-[14px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg><span><strong>Sees:</strong> <!-- -->Firm-wide: all engagements, finances, utilisation, and goals.</span></div><div class=\"flex gap-2 text-[14px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg><span><strong>Does:</strong> <!-- -->Sets strategy, approves scope changes, reviews profitability.</span></div></div></div><div class=\"card h-full\"><div class=\"flex items-center gap-3\"><span class=\"text-[28px]\" aria-hidden=\"true\">📌</span><h3 class=\"text-[17px] font-bold\">Manager</h3></div><div class=\"mt-4 space-y-2\"><div class=\"flex gap-2 text-[14px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg><span><strong>Sees:</strong> <!-- -->Their engagements: tasks, timelines, team workload, and risk.</span></div><div class=\"flex gap-2 text-[14px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg><span><strong>Does:</strong> <!-- -->Plans delivery, unblocks the team, writes client updates.</span></div></div></div><div class=\"card h-full\"><div class=\"flex items-center gap-3\"><span class=\"text-[28px]\" aria-hidden=\"true\">💼</span><h3 class=\"text-[17px] font-bold\">IC / Associate</h3></div><div class=\"mt-4 space-y-2\"><div class=\"flex gap-2 text-[14px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg><span><strong>Sees:</strong> <!-- -->Their assigned tasks and what they need to complete them.</span></div><div class=\"flex gap-2 text-[14px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg><span><strong>Does:</strong> <!-- -->Does the work, logs time, flags blockers.</span></div></div></div><div class=\"card h-full\"><div class=\"flex items-center gap-3\"><span class=\"text-[28px]\" aria-hidden=\"true\">🤝</span><h3 class=\"text-[17px] font-bold\">Client</h3></div><div class=\"mt-4 space-y-2\"><div class=\"flex gap-2 text-[14px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg><span><strong>Sees:</strong> <!-- -->Their Client Space only: deliverables, status, and approvals.</span></div><div class=\"flex gap-2 text-[14px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg><span><strong>Does:</strong> <!-- -->Reviews work, gives feedback, signs off deliverables.</span></div></div></div></div></div></section><section class=\"section bg-[#fbfbfd]\"><div class=\"wrap\"><span class=\"eyebrow\">Pricing</span><h2 class=\"mt-3 font-display text-[clamp(26px,3.4vw,40px)] font-semibold tracking-[-0.02em]\">Simple. Predictable. Fair.</h2><p class=\"lead mt-3 max-w-[580px]\">Buy Client Space on it