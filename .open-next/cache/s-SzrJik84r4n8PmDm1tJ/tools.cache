ools\",\"itemListOrder\":\"https://schema.org/ItemListOrderAscending\",\"numberOfItems\":6,\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"\\\"Any Update?\\\" Cost Calculator\",\"url\":\"https://pyngyn.ai/tools/any-update-cost\",\"description\":\"Put a number on the hours spent answering client status emails and calls, then see what a branded client portal could win back. Priced like Clientspace, per client.\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Engagement Plan Generator\",\"url\":\"https://pyngyn.ai/tools/ai-project-plan\",\"description\":\"Describe a client engagement in plain English and get phases, tasks, owners, milestones, a suggested team, risks, and meeting cadence. Export to Markdown or CSV.\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Cost of Chaos ROI Calculator\",\"url\":\"https://pyngyn.ai/tools/roi-calculator\",\"description\":\"Put a number on the billable hours lost to status-chasing and tool-switching, then see how much you could win back. Adjust every input, in INR or USD.\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Status Report Generator\",\"url\":\"https://pyngyn.ai/tools/status-report\",\"description\":\"Paste your rough weekly notes. Get a clean, client-ready status update, status colour, TL;DR, completed, blockers, asks, and next week. Export to Markdown, email, or Slack.\"},{\"@type\":\"ListItem\",\"position\":5,\"name\":\"Project Cost & Margin Estimator\",\"url\":\"https://pyngyn.ai/tools/cost-margin-estimator\",\"description\":\"Estimate effort, blended rate, and gross margin for a fixed-fee engagement before you send the proposal. See your breakeven fee and how scope creep erodes margin.\"},{\"@type\":\"ListItem\",\"position\":6,\"name\":\"Team Utilization Calculator\",\"url\":\"https://pyngyn.ai/tools/team-utilization\",\"description\":\"Work out billable utilization across your bench, see what your current rate is worth, and find the revenue upside of hitting target. In INR or USD.\"}]}]}</script><header class=\"fixed inset-x-0 top-0 z-[100] border-b transition-all duration-300 border-transparent bg-transparent\"><div class=\"wrap flex h-[68px] items-center justify-between\"><a class=\"flex items-center\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><div class=\"hidden h-full lg:flex lg:items-center\"><nav class=\"flex items-center gap-7 text-[15px] text-[#3a3a42]\"><a class=\"py-2 transition-colors hover:text-accent\" href=\"/clientspace/\">Clientspace</a><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Product<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Solutions<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Resources<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Compare<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></nav></div><div class=\"flex items-center gap-3\"><a href=\"https://app.pyngyn.ai/\" class=\"hidden text-[15px] font-semibold lg:inline \">Sign in</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"hidden px-4 py-2.5 lg:inline-flex btn btn-ghost\">Start free</a><a href=\"/demo\" class=\"hidden px-[18px] py-2.5 lg:inline-flex btn btn-primary\">Book a demo</a><button type=\"button\" class=\"grid h-10 w-10 place-items-center rounded-lg border lg:hidden border-line bg-white text-ink\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"mobile-menu\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"></path></svg></button></div></div></header><main id=\"main\"><section class=\"wrap pb-[10px] pt-[150px] text-center\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>Free tools</span><h1 class=\"mx-auto mt-3 max-w-[760px] font-display text-[clamp(34px,4.8vw,56px)] font-semibold leading-[1.05] tracking-[-0.025em]\">Tools for the way services teams actually work.</h1><p class=\"lead mx-auto mt-5\">Free, no signup. Practical utilities for scoping, reporting, and running client work. Built by the team behind PYNGYN.</p></section><section class=\"section\"><div class=\"wrap\"><div class=\"grid gap-[18px] sm:grid-cols-2\"><a class=\"flex h-full flex-col rounded-[20px] border border-line bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\" href=\"/tools/any-update-cost/\"><div class=\"flex items-center justify-between\"><span class=\"grid h-12 w-12 place-items-center rounded-2xl\" style=\"background-color:#0d94881a;color:#0d9488\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 4h16v12H8l-4 4z M8 9h8M8 12h5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><span class=\"rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide bg-accent-lt text-accent\">Client experience</span></div><h2 class=\"mt-5 font-display text-[21px] font-semibold tracking-[-0.02em]\">&quot;Any Update?&quot; Cost Calculator</h2><p class=\"mt-2 flex-1 text-[14.5px] leading-relaxed text-muted\">Put a number on the hours spent answering client status emails and calls, then see what a branded client portal could win back. Priced like Clientspace, per client.</p><span class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Open tool →</span></a><a class=\"flex h-full flex-col rounded-[20px] border border-line bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\" href=\"/tools/ai-project-plan/\"><div class=\"flex items-center justify-between\"><span class=\"grid h-12 w-12 place-items-center rounded-2xl\" style=\"background-color:#ec48991a;color:#ec4899\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><span class=\"rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide bg-accent-lt text-accent\">Planning</span></div><h2 class=\"mt-5 font-display text-[21px] font-semibold tracking-[-0.02em]\">Engagement Plan Generator</h2><p class=\"mt-2 flex-1 text-[14.5px] leading-relaxed text-muted\">Describe a client engagement in plain English and get phases, tasks, owners, milestones, a suggested team, risks, and meeting cadence. Export to Markdown or CSV.</p><span class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Open tool →</span></a><a class=\"flex h-full flex-col rounded-[20px] border border-line bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\" href=\"/tools/roi-calculator/\"><div class=\"flex items-center justify-between\"><span class=\"grid h-12 w-12 place-items-center rounded-2xl\" style=\"background-color:#4f46e51a;color:#4f46e5\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 3v18M3 12h18M6 6l12 12M18 6L6 18\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><span class=\"rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide bg-accent-lt text-accent\">ROI</span></div><h2 class=\"mt-5 font-display text-[21px] font-semibold tracking-[-0.02em]\">Cost of Chaos ROI Calculator</h2><p class=\"mt-2 flex-1 text-[14.5px] leading-relaxed text-muted\">Put a number on the billable hours lost to status-chasing and tool-switching, then see how much you could win back. Adjust every input, in INR or USD.</p><span class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Open tool →</span></a><a class=\"flex h-full flex-col rounded-[20px] border border-line bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\" href=\"/tools/status-report/\"><div class=\"flex items-center justify-between\"><span class=\"grid h-12 w-12 place-items-center rounded-2xl\" style=\"background-color:#2563eb1a;color:#2563eb\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7 3h7l4 4v14H7zM14 3v4h4M9 12h6M9 16h4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><span class=\"rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide bg-accent-lt text-accent\">Status</span></div><h2 class=\"mt-5 font-display text-[21px] font-semibold tracking-[-0.02em]\">Status Report Generator</h2><p class=\"mt-2 flex-1 text-[14.5px] leading-relaxed text-muted\">Paste your rough weekly notes. Get a clean, client-ready status update, status colour, TL;DR, completed, blockers, asks, and next week. Export to Markdown, email, or Slack.</p><span class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Open tool →</span></a><a class=\"flex h-full flex-col rounded-[20px] border border-line bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\" href=\"/tools/cost-margin-estimator/\"><div class=\"flex items-center justify-between\"><span class=\"grid h-12 w-12 place-items-center rounded-2xl\" style=\"background-color:#0b7a4b1a;color:#0b7a4b\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 3h7l11 11-7 7L3 10z M7 7h.01\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><span class=\"rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide bg-accent-lt text-accent\">Pricing</span></div><h2 class=\"mt-5 font-display text-[21px] font-semibold tracking-[-0.02em]\">Project Cost &amp; Margin Estimator</h2><p class=\"mt-2 flex-1 text-[14.5px] leading-relaxed text-muted\">Estimate effort, blended rate, and gross margin for a fixed-fee engagement before you send the proposal. See your breakeven fee and how scope creep erodes margin.</p><span class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Open tool →</span></a><a class=\"flex h-full flex-col rounded-[20px] border border-line bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\" href=\"/tools/team-utilization/\"><div class=\"flex items-center justify-between\"><span class=\"grid h-12 w-12 place-items-center rounded-2xl\" style=\"background-color:#f973161a;color:#f97316\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 20V10M10 20V4M15 20v-8M20 20V7\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><span class=\"rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide bg-accent-lt text-accent\">Operations</span></div><h2 class=\"mt-5 font-display text-[21px] font-semibold tracking-[-0.02em]\">Team Utilization Calculator</h2><p class=\"mt-2 flex-1 text-[14.5px] leading-relaxed text-muted\">Work out billable utilization across your bench, see what your current rate is worth, and find the revenue upside of hitting target. In INR or USD.</p><span class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Open tool →</span></a></div></div></section><section class=\"section-tight\"><div class=\"wrap max-w-[820px]\"><div class=\"rounded-[22px] border border-accent/30 bg-accent-lt px-7 py-9 sm:px-9\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>One-off tools vs. the real thing</span><h2 class=\"mt-3 font-display text-[22px] font-semibold leading-snug tracking-[-0.01em] sm:text-[26px]\">These tools are one calculation. Workspace and Clientspace run this permanently.</h2><p class=\"mt-3 max-w-[640px] text-[15px] leading-relaxed text-muted\">Every tool above answers one question, once. Workspace tracks the plan, the margin, the utilization, and the status live, every week, without you opening a calculator. Clientspace shows your clients the result in their own branded portal, standalone or bundled with Workspace.</p><div class=\"mt-6 flex flex-wrap items-center gap-3\"><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-accent\">Start free trial<!-- --> →</a><a href=\"/demo\" class=\"btn btn-ghost bg-white\">Book a demo</a></div></div></div></section><section id=\"demo\" class=\"section\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"relative overflow-hidden rounded-[28px] border border-line bg-white px-7 py-[72px] text-center shadow-card\"><div class=\"pointer-events-none absolute -top-24 left-1/2 h-[420px] w-[420px] -translate-x-1/2 rounded-full bg-accent-lt opacity-70 blur-[80px]\" aria-hidden=\"true\"></div><span class=\"eyebrow relative\">Ready when you are</span><h2 class=\"title relative mx-auto mt-3.5 max-w-[680px] text-[clamp(30px,4.4vw,48px)]\">Stop managing the tool. Start shipping the work.</h2><p class=\"lead relative mx-auto mt-[18px]\">See PYNGYN run a real project in 30 minutes, and let AI handle the project management busywork.</p><div class=\"relative mt-[30px] flex flex-wrap items-center justify-center gap-3.5\"><a href=\"/demo\" class=\"btn btn-primary\">Book a demo →</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-ghost\">Start free</a></div><p class=\"relative mt-4 text-sm text-muted\">30-minute walkthrough · Tailored to your team · No commitment</p></div></div></div></section></main><footer class=\"border-t border-line bg-white pt-16 pb-10 text-sm text-muted\"><div class=\"wrap\"><div class=\"grid gap-10 lg:grid-cols-[1.4fr_repeat(5,1fr)]\"><div><a class=\"mb-4 inline-block\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" loading=\"lazy\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><p class=\"max-w-[230px] leading-relaxed\">The operating system for professional-services firms.</p><a href=\"https://play.google.com/store/apps/details?id=com.pyngyn.io&amp;hl=en_IN\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"mt-5 inline-flex items-center gap-2.5 rounded-xl border border-line bg-white px-4 py-2.5 transition-colors hover:border-accent\" aria-label=\"Get PYNGYN on Google Play\"><svg width=\"22\" height=\"22\" vi