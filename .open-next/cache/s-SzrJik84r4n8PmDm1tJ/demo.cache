d-cols-2\",\"children\":[[\"$\",\"div\",\"Is this a sales call?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[15.5px] font-bold leading-snug\",\"children\":\"Is this a sales call?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"It's a working session. We spend the time setting up a Clientspace on one of your real engagements and mapping fit, not walking through slides. If PYNGYN isn't right for your firm, we'll say so.\"}]]}],[\"$\",\"div\",\"Do I need to prepare anything?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[15.5px] font-bold leading-snug\",\"children\":\"Do I need to prepare anything?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"No preparation required. If you want the most out of it, have one current engagement in mind, we'll use it to set up your Clientspace live on the call.\"}]]}],[\"$\",\"div\",\"Who should join from our side?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[15.5px] font-bold leading-snug\",\"children\":\"Who should join from our side?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"Whoever owns the client relationship problem: partners, practice managers, operations or delivery leads. Bring the whole group if you like, add their emails in the booking notes.\"}]]}],[\"$\",\"div\",\"We already use Notion, ClickUp, Jira, or spreadsheets. Is this still useful?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[15.5px] font-bold leading-snug\",\"children\":\"We already use Notion, ClickUp, Jira, or spreadsheets. Is this still useful?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"Yes, that's the most common starting point. We'll be honest about what PYNGYN replaces, what it sits alongside, and what migration actually involves.\"}]]}],[\"$\",\"div\",\"Can I just try the product instead?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[15.5px] font-bold leading-snug\",\"children\":\"Can I just try the product instead?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"Absolutely. There's a 7-day free trial with no credit card, Clientspace is $19 per client/month standalone, Workspace is $9 per seat/month, or bundle both for $24.99/month. The demo is for teams who want a guided setup and a rollout plan.\"}]]}],[\"$\",\"div\",\"Is our data safe if we share our workflow on the call?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[15.5px] font-bold leading-snug\",\"children\":\"Is our data safe if we share our workflow on the call?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14px] leading-relaxed text-muted\",\"children\":\"The call is a conversation over Google Meet, nothing is uploaded anywhere. If we set up a trial Clientspace, it lives in your own account, isolated per client, and you can delete it any time.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"mx-auto mt-8 max-w-xl text-center text-[14px] text-muted\",\"children\":[\"Not ready for a call? You can\",\" \",[\"$\",\"a\",null,{\"href\":\"https://app.pyngyn.ai/?signup=true\",\"className\":\"font-semibold text-accent hover:text-accent-dk\",\"children\":\"start a 7-day free trial\"}],\" \",\"instead, no credit card required.\"]}]]}]}]\nc:[\"$\",\"section\",null,{\"className\":\"wrap pb-20\",\"children\":[\"$\",\"$L22\",null,{}]}]\nd:[\"$\",\"$L23\",null,{}]\ne:[\"$\",\"$L24\",null,{\"ctaHref\":\"https://app.pyngyn.ai/?signup=true\",\"ctaLabel\":\"Start free trial\",\"eyebrow\":\"Before you go\",\"title\":\"Not ready for a 30-minute call?\",\"body\":\"Skip the calendar. Start a 7-day free trial and explore Client Space or Workspace yourself, no cr