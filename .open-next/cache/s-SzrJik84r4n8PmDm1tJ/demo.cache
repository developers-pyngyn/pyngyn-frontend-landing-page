e\\\":\\\"WebPage\\\",\\\"@id\\\":\\\"https://pyngyn.ai/demo#webpage\\\",\\\"url\\\":\\\"https://pyngyn.ai/demo\\\",\\\"name\\\":\\\"Book a demo | PYNGYN\\\",\\\"description\\\":\\\"Book a free 30-minute live walkthrough. We set up a Clientspace on one of your real engagements and you leave with a written rollout plan.\\\",\\\"isPartOf\\\":{\\\"@id\\\":\\\"https://pyngyn.ai/#website\\\"},\\\"inLanguage\\\":\\\"en\\\"},{\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"@id\\\":\\\"https://pyngyn.ai/demo#breadcrumb\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://pyngyn.ai/\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Book a demo\\\",\\\"item\\\":\\\"https://pyngyn.ai/demo\\\"}]},{\\\"@type\\\":\\\"FAQPage\\\",\\\"@id\\\":\\\"https://pyngyn.ai/demo#faq\\\",\\\"mainEntity\\\":[{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Is this a sales call?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"It's a working session. We spend the time setting up a Clientspace on one of your real engagements and mapping fit, not walking through slides. If PYNGYN isn't right for your firm, we'll say so.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Do I need to prepare anything?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"No preparation required. If you want the most out of it, have one current engagement in mind, we'll use it to set up your Clientspace live on the call.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Who should join from our side?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Whoever owns the client relationship problem: partners, practice managers, operations or delivery leads. Bring the whole group if you like, add their emails in the booking notes.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"We already use Notion, ClickUp, Jira, or spreadsheets. Is this still useful?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Yes, that's the most common starting point. We'll be honest about what PYNGYN replaces, what it sits alongside, and what migration actually involves.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Can I just try the product instead?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Absolutely. There's a 7-day free trial with no credit card, Clientspace is $19 per client/month standalone, Workspace is $9 per seat/month, or bundle both for $24.99/month. The demo is for teams who want a guided setup and a rollout plan.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Is our data safe if we share our workflow on the call?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"The call is a conversation over Google Meet, nothing is uploaded anywhere. If we set up a trial Clientspace, it lives in your own account, isolated per client, and you can delete it any time.\\\"}}]}]}9:[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"id\\\":\\\"$undefined\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$10\\\"}}],[\\\"$\\\",\\\"$L11\\\",null,{}],[\\\"$\\\",\\\"main\\\",null,{\\\"id\\\":\\\"main\\\",\\\"className\\\":\\\"text-ink antialiased\\\",\\\"children\\\":[[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"booking\\\",\\\"className\\\":\\\"bg-canvas pb-16 pt-24 sm:pb-20 sm:pt-28\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto w-full max-w-content px-5 sm:px-7\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-8 text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"eyebrow justify-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"eyebrow-dot\\\"}],\\\" Live strategy walkthrough · 30 min\\\"]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\