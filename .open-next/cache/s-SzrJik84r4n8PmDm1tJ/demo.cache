{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/demo/layout,_N_T_/demo/page,_N_T_/demo"},"segmentPaths":["/_tree","/_full","/demo/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"display_2a073e65-module__7MkqkG__variable jakarta_55fc869e-module__LB2P7q__variable mono_8ba1b3ff-module__cxzmQq__variable\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_400_normal-s.p.2_o2v7tpo0q5m.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_500_normal-s.p.3vqzgd2jdiw22.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_600_normal-s.p.3_r60-qkmao3a.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_700_normal-s.p.0rb33xx2bxpl8.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_400_normal-s.p.3crsbyy6lh6yf.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_500_normal-s.p.2h52d08o60qht.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_600_normal-s.p.2mm922pe315l1.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_400_normal-s.p.2ysn9gc82zk1v.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_500_normal-s.p.1evhelic1rxge.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_600_normal-s.p.0p6sew1q6gl7s.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_700_normal-s.p.1dulefe5e4s81.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"/logo.webp\"/><link rel=\"preload\" as=\"image\" href=\"/team/vivek-pandey.png\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/02mkr0z8o939x.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1b-l3oagpuv39.js\"/><script src=\"/_next/static/chunks/11jq0c2_zavac.js\" async=\"\"></script><script src=\"/_next/static/chunks/4561u0v7ysn3r.js\" async=\"\"></script><script src=\"/_next/static/chunks/021sppg0zbt0v.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2pcc6e_qu_s3g.js\" async=\"\"></script><script src=\"/_next/static/chunks/0ht-3v40sanoo.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/0a1jij4oaqs5_.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/1_p0c8_mtfqqv.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/41mnvtr75by45.js\" async=\"\" crossorigin=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Book a demo | PYNGYN</title><meta name=\"description\" content=\"Book a free 30-minute live walkthrough. We set up a Clientspace on one of your real engagements, map pricing to your firm, and you leave with a written rollout plan.\"/><meta name=\"author\" content=\"Nikunj Chugh\"/><meta name=\"creator\" content=\"Nikunj Chugh\"/><link rel=\"canonical\" href=\"https://pyngyn.ai/demo/\"/><meta property=\"og:title\" content=\"Book a demo | PYNGYN\"/><meta property=\"og:description\" content=\"30 minutes, live, no slideshow. We set up a Clientspace on a real engagement of yours and leave you with a tailored rollout plan.\"/><meta property=\"og:url\" content=\"https://pyngyn.ai/demo/\"/><meta property=\"og:image\" content=\"https://pyngyn.ai/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"PYNGYN: Clientspace, a standalone branded client portal, and Workspace, a standalone back office for professional-services firms\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:site\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:creator\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:title\" content=\"PYNGYN: The operating system for professional-services firms\"/><meta name=\"twitter:description\" content=\"Run your firm and every client engagement in one place. The operating system for professional-services firms.\"/><meta name=\"twitter:image\" content=\"https://pyngyn.ai/og.png\"/><link rel=\"icon\" href=\"/icon.png\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png\"/><script type=\"application/ld+json\" id=\"ld-organization\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://pyngyn.ai/#organization\",\"name\":\"PYNGYN\",\"legalName\":\"VIMOVI GlobalTech Private Limited\",\"url\":\"https://pyngyn.ai/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://pyngyn.ai/logo.png\",\"width\":512,\"height\":512},\"image\":\"https://pyngyn.ai/icon.png\",\"description\":\"PYNGYN gives every client a branded Client Space (a standalone portal for status, documents, and approvals), with Workspace, the firm's back office for projects, finances, and billable time, available on its own or bundled together.\",\"sameAs\":[\"https://x.com/Pyngyn_Official\",\"https://www.linkedin.com/company/pyngyn/\",\"https://www.reddit.com/user/Pyngyn_Official/\",\"https://www.facebook.com/profile.php?id=61584474731354\",\"https://www.youtube.com/@PyngynOfficial\",\"https://instagram.com/pyngyn_official\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"customer support\",\"email\":\"support@pyngyn.com\",\"url\":\"https://pyngyn.ai/support\",\"availableLanguage\":[\"English\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"sales@pyngyn.com\",\"url\":\"https://pyngyn.ai/demo\",\"availableLanguage\":[\"English\"]}]}</script><script type=\"application/ld+json\" id=\"ld-website\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://pyngyn.ai/#website\",\"url\":\"https://pyngyn.ai/\",\"name\":\"PYNGYN\",\"description\":\"The operating system for professional-services firms. Run your firm and every client engagement in one place.\",\"publisher\":{\"@id\":\"https://pyngyn.ai/#organization\"},\"inLanguage\":\"en\"}</script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-sans\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main\" class=\"sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white\">Skip to content</a><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://pyngyn.ai/demo#webpage\",\"url\":\"https://pyngyn.ai/demo\",\"name\":\"Book a demo | PYNGYN\",\"description\":\"Book a free 30-minute live walkthrough. We set up a Clientspace on one of your real engagements and you leave with a written rollout plan.\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/demo#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://pyngyn.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Book a demo\",\"item\":\"https://pyngyn.ai/demo\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://pyngyn.ai/demo#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is this a sales call?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It's a working session. We spend the time setting up a Clientspace on one of your real engagements and mapping fit, not walking through slides. If PYNGYN isn't right for your firm, we'll say so.\"}},{\"@type\":\"Question\",\"name\":\"Do I need to prepare anything?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No preparation required. If you want the most out of it, have one current engagement in mind, we'll use it to set up your Clientspace live on the call.\"}},{\"@type\":\"Question\",\"name\":\"Who should join from our side?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Whoever owns the client relationship problem: partners, practice managers, operations or delivery leads. Bring the whole group if you like, add their emails in the booking notes.\"}},{\"@type\":\"Question\",\"name\":\"We already use Notion, ClickUp, Jira, or spreadsheets. Is this still useful?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, that's the most common starting point. We'll be honest about what PYNGYN replaces, what it sits alongside, and what migration actually involves.\"}},{\"@type\":\"Question\",\"name\":\"Can I just try the product instead?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Absolutely. There's a 7-day free trial with no credit card, Clientspace is $19 per client/month standalone, Workspace is $9 per seat/month, or bundle both for $24.99/month. The demo is for teams who want a guided setup and a rollout plan.\"}},{\"@type\":\"Question\",\"name\":\"Is our data safe if we share our workflow on the call?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The call is a conversation over Google Meet, nothing is uploaded anywhere. If we set up a trial Clientspace, it lives in your own account, isolated per client, and you can delete it any time.\"}}]}]}</script><header class=\"fixed inset-x-0 top-0 z-[100] border-b transition-all duration-300 border-transparent bg-transparent\"><div class=\"wrap flex h-[68px] items-center justify-between\"><a class=\"flex items-center\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><div class=\"hidden h-full lg:flex lg:items-center\"><nav class=\"flex items-center gap-7 text-[15px] text-[#3a3a42]\"><a class=\"py-2 transition-colors hover:text-accent\" href=\"/clientspace/\">Clientspace</a><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Product<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Solutions<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Resources<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Compare<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></nav></div><div class=\"flex items-center gap-3\"><a href=\"https://app.pyngyn.ai/\" class=\"hidden text-[15px] font-semibold lg:inline \">Sign in</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"hidden px-4 py-2.5 lg:inline-flex btn btn-ghost\">Start free</a><a href=\"/demo\" class=\"hidden px-[18px] py-2.5 lg:inline-flex btn btn-primary\">Book a demo</a><button type=\"button\" class=\"grid h-10 w-10 place-items-center rounded-lg border lg:hidden border-line bg-white text-ink\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"mobile-menu\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"></path></svg></button></div></div></header><main id=\"main\" class=\"text-ink antialiased\"><section id=\"booking\" class=\"bg-canvas pb-16 pt-24 sm:pb-20 sm:pt-28\"><div class=\"mx-auto w-full max-w-content px-5 sm:px-7\"><div class=\"mb-8 text-center\"><span class=\"eyebrow justify-center\"><span class=\"eyebrow-dot\"></span> Live strategy walkthrough · 30 min</span><h1 class=\"mx-auto mt-3 max-w-3xl font-display text-[clamp(28px,4.4vw,48px)] font-semibold leading-[1.04] tracking-[-0.03em]\">See your clients&#x27; portal set up live, on a real engagement of yours.</h1><p class=\"mx-auto mt-4 max-w-xl text-[15px] leading-relaxed text-muted sm:text-[16px]\">A 30-minute Google Meet with our founder. No slide deck: we configure a Clientspace for your firm on the call and you leave with a written rollout plan.</p><div class=\"mx-auto mt-6 grid max-w-md grid-cols-3 overflow-hidden rounded-2xl border border-line bg-white shadow-card\"><div class=\"flex flex-col items-center justify-center gap-1 px-2 py-3.5 text-center \"><span class=\"font-display text-[17px] font-semibold tracking-tight text-ink sm:text-[20px]\">30 min</span><span class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-muted\">Focused session</span></div><div class=\"flex flex-col items-center justify-center gap-1 px-2 py-3.5 text-center border-l border-line\"><span class=\"font-display text-[17px] font-semibold tracking-tight text-ink sm:text-[20px]\">Free</span><span class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-muted\">No commitment</span></div><div class=\"flex flex-col items-center justify-center gap-1 px-2 py-3.5 text-center border-l border-line\"><span class=\"font-display text-[17px] font-semibold tracking-tight text-ink sm:text-[20px]\">1:1</span><span class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-muted\">Real walkthrough</span></div></div></div><div class=\"grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:items-start\"><div class=\"lg:sticky lg:top-24\"><div class=\"overflow-hidden rounded-2xl border border-line bg-white shadow-card\" style=\"position:relative;min-width:320px;height:760px\"><div class=\"h-full\" role=\"region\" aria-label=\"Schedule a demo\"></div><div class=\"absolute inset-0 grid place-items-center bg-white\" aria-hidden=\"true\"><div class=\"flex flex-col items-center gap-3\"><span class=\"h-7 w-7 animate-spin rounded-full border-2 border-line border-t-accent\"></span><span class=\"text-[13px] text-muted\">Loading scheduler…</span></div></div></div><div class=\"mt-4 flex flex-wrap items-center gap-2\"><span class=\"text-[11px] font-bold uppercase tracking-[0.14em] text-muted\">Built for</span><span class=\"rounded-full border border-line bg-white px-2.5 py-1 text-[11px] font-semibold text-ink\">Partners &amp; directors</span><span class=\"rounded-full border border-line bg-white px-2.5 py-1 text-[11px] font-semibold text-ink\">Practice managers</span><span class=\"rounded-full border border-line bg-white px-2.5 py-1 text-[11px] font-semibold text-ink\">Associates &amp; ICs</span><span class=\"rounded-full border border-line bg-white px-2.5 py-1 text-[11px] font-semibold text-ink\">Client services</span><span class=\"rounded-full border border-line bg-white px-2.5 py-1 text-[11px] font-semibold text-ink\">Operations leads</span></div><p class=\"mt-3 text-[12px] text-muted\">Prefer email? Reach the team at<!-- --> <a href=\"mailto:sales@pyngyn.com\" class=\"font-semibold text-accent hover:text-accent-dk\">sales@pyngyn.com</a>.</p></div><div id=\"what-you-get\"><section aria-label=\"About this demo\" class=\"flex flex-col gap-6\"><div class=\"flex items-center gap-4 rounded-3xl border border-line bg-white p-5 shadow-card sm:p-6\"><img src=\"/team/vivek-pandey.png\" alt=\"Vivek Pandey\" width=\"64\" height=\"64\" class=\"shrink-0 rounded-full object-cover shadow-card\" style=\"width:64px;height:64px\"/><div class=\"min-w-0\"><p class=\"truncate font-display text-[20px] font-semibold leading-tight text-ink\">PYNGYN</p><p class=\"truncate text-[13px] text-muted\">Vivek Pandey<!-- --> · <!-- -->Founder &amp; CEO</p></div><span class=\"ml-auto hidden items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-emerald-700 sm:inline-flex\"><span class=\"h-1.5 w-1.5 rounded-full bg-emerald-500\"></span>Booking</span></div><div role=\"tablist\" aria-label=\"More about this session\" class=\"inline-flex flex-wrap items-center gap-1 self-start rounded-full border border-line bg-white p-1 shadow-card\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" class=\"rounded-full px-4 py-1.5 text-[13px] font-semibold transition-colors bg-ink text-white shadow-cta\"><span class=\"mr-1.5 inline-block h-1.5 w-1.5 -translate-y-0.5 rounded-full bg-accent\"></span>About</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"rounded-full px-4 py-1.5 text-[13px] font-semibold transition-colors text-muted hover:text-ink\">Experience</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"rounded-full px-4 py-1.5 text-[13px] font-semibold transition-colors text-muted hover:text-ink\">FAQs</button></div><div class=\"rounded-3xl border border-line bg-white p-6 shadow-card sm:p-7\"><div><h3 class=\"font-display text-[22px] font-semibold leading-tight text-ink\">Hey, I&#x27;m <!-- -->Vivek<!-- -->.</h3><p class=\"mt-3 text-[15px] leading-relaxed text-muted\">I&apos;ve spent years close to how services teams actually deliver work. On this call we won&apos;t pitch slides, we&apos;ll open your workflow, find the things quietly costing you hours each week, and show how PYNGYN would absorb them.</p><ul class=\"mt-5 flex flex-col gap-2.5\"><li class=\"flex items-start gap-3 text-[14px] text-ink\"><span class=\"mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-accent-lt text-accent\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><span>Map your real workflow live, not a generic demo flow.</span></li><li class=\"flex items-start gap-3 text-[14px] text-ink\"><span class=\"mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-accent-lt text-accent\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><span>See PYNGYN turn a goal into tasks, owners, timelines, and status.</span></li><li class=\"flex items-start gap-3 text-[14px] text-ink\"><span class=\"mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-accent-lt text-accent\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><span>Leave with a tailored rollout plan and a written summary.</span></li></ul></div></div><div class=\"rounded-3xl border border-line bg-white p-5 shadow-card sm:p-6\"><div class=\"mb-4 flex items-end justify-between gap-3\"><div><p class=\"font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-accent\">Gallery</p><h3 class=\"mt-1 font-display text-[18px] font-semibold text-ink\">What you&#x27;ll see in the call</h3></div></div><div class=\"grid grid-cols-3 gap-3\"><div class=\"relative overflow-hidden rounded-2xl border border-line bg-gradient-to-br from-accent/15 to-accent/5 p-3 transition-transform hover:-translate-y-0.5\"><div class=\"aspect-[4/3] w-full rounded-xl bg-white/80 backdrop-blur\"><div class=\"flex h-full flex-col gap-1.5 p-2\"><div class=\"h-1.5 w-1/3 rounded-full bg-ink/15\"></div><div class=\"h-1.5 w-2/3 rounded-full bg-ink/10\"></div><div class=\"mt-auto flex gap-1\"><span class=\"h-1.5 w-1.5 rounded-full bg-accent\"></span><span class=\"h-1.5 w-1.5 rounded-full bg-ink/30\"></span><span class=\"h-1.5 w-1.5 rounded-full bg-ink/20\"></span></div></div></div><p class=\"mt-2 text-[12px] font-semibold text-ink\">Plan view</p><p class=\"text-[11px] text-muted\">Live project board</p></div><div class=\"relative overflow-hidden rounded-2xl border border-line bg-gradient-to-br from-emerald-200/40 to-emerald-100/10 p-3 transition-transform hover:-translate-y-0.5\"><div class=\"aspect-[4/3] w-full rounded-xl bg-white/80 backdrop-blur\"><div class=\"flex h-full flex-col gap-1.5 p-2\"><div class=\"h-1.5 w-1/3 rounded-full bg-ink/15\"></div><div class=\"h-1.5 w-2/3 rounded-full bg-ink/10\"></div><div class=\"mt-auto flex gap-1\"><span class=\"h-1.5 w-1.5 rounded-full bg-accent\"></span><span class=\"h-1.5 w-1.5 rounded-full bg-ink/30\"></span><span class=\"h-1.5 w-1.5 rounded-full bg-ink/20\"></span></div></div></div><p class=\"mt-2 text-[12px] font-semibold text-ink\">Status digest</p><p class=\"text-[11px] text-muted\">Weekly auto-summary</p></div><div class=\"relative overflow-hidden rounded-2xl border border-line bg-gradient-to-br from-amber-200/40 to-amber-100/10 p-3 transition-transform hover:-translate-y-0.5\"><div class=\"aspect-[4/3] w-full rounded-xl bg-white/80 backdrop-blur\"><div class=\"flex h-full flex-col gap-1.5 p-2\"><div class=\"h-1.5 w-1/3 rounded-full bg-ink/15\"></div><div class=\"h-1.5 w-2/3 rounded-full bg-ink/10\"></div><div class=\"mt-auto flex gap-1\"><span class=\"h-1.5 w-1.5 rounded-full bg-accent\"></span><span class=\"h-1.5 w-1.5 rounded-full bg-ink/30\"></span><span class=\"h-1.5 w-1.5 rounded-full bg-ink/20\"></span></div></div></div><p class=\"mt-2 text-[12px] font-semibold text-ink\">Risk radar</p><p class=\"text-[11px] text-muted\">Owners + blockers</p></div></div></div></section></div></div></div></section><section class=\"section bg-white\"><div class=\"wrap\"><div class=\"mx-auto max-w-2xl text-center\"><span class=\"eyebrow justify-center\"><span class=\"eyebrow-dot\"></span> The agenda</span><h2 class=\"mt-3 font-display text-[clamp(26px,4vw,40px)] font-semibold leading-[1.06] tracking-[-0.03em]\">How the 30 minutes runs.</h2><p class=\"mx-auto mt-4 max-w-xl text-[15.5px] leading-relaxed text-muted\">Every call follows the same simple structure, tailored to your firm.</p></div><ol class=\"mx-auto mt-10 grid max-w-[1040px] gap-[18px] sm:grid-cols-2 lg:grid-cols-4\"><li class=\"card h-full\"><span class=\"inline-block rounded-full bg-accent-lt px-3 py-1 font-mono text-[11.5px] font-bold text-accent\">0–5 min</span><h3 class=\"mt-3.5 text-[16px] font-bold leading-snug\">Your firm, your workflow</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">You talk, we listen: how engagements run today, where clients chase you for updates, and which tools are already in the mix.</p></li><li class=\"card h-full\"><span class=\"inline-block rounded-full bg-accent-lt px-3 py-1 font-mono text-[11.5px] font-bold text-accent\">5–15 min</span><h3 class=\"mt-3.5 text-[16px] font-bold leading-snug\">Clientspace, set up live</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">We create a branded Clientspace for one of your real engagements (your logo, your colors), so you see exactly what your client would see.</p></li><li class=\"card h-full\"><span class=\"inline-block rounded-full bg-accent-lt px-3 py-1 font-mono text-[11.5px] font-bold text-accent\">15–25 min</span><h3 class=\"mt-3.5 text-[16px] font-bold leading-snug\">The fit for your firm</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Workspace for your internal ops if you want it, honest answers on what PYNGYN replaces vs. sits alongside, and pricing mapped to your team and client count.</p></li><li class=\"card h-full\"><span class=\"inline-block rounded-full bg-accent-lt px-3 py-1 font-mono text-[11.5px] font-bold text-accent\">25–30 min</span><h3 class=\"mt-3.5 text-[16px] font-bold leading-snug\">Your rollout plan</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">We agree concrete next steps. Within a day you get a written summary and a tailored rollout plan, whether or not you buy.</p></li></ol></div></section><section class=\"relative overflow-hidden bg-[#f2ecff] py-16 sm:py-20\"><div class=\"absolute left-[8%] top-28 h-56 w-56 rounded-full bg-white/70 blur-3xl\" aria-hidden=\"true\"></div><div class=\"absolute right-[5%] top-36 h-72 w-72 rounded-full bg-accent/10 blur-3xl\" aria-hidden=\"true\"></div><div class=\"relative mx-auto w-full max-w-content px-5 sm:px-7\"><div class=\"mx-auto max-w-2xl text-center\"><span class=\"eyebrow justify-center\"><span class=\"eyebrow-dot\"></span> What we&#x27;ll show you</span><h2 class=\"mt-4 font-display text-[clamp(28px,4.6vw,44px)] font-semibold leading-[1.05] tracking-[-0.03em]\">The branded portal your clients will log into.</h2><p class=\"mx-auto mt-4 max-w-xl text-[16px] leading-relaxed text-muted\">On the call, we&#x27;ll set up a Clientspace for a real engagement of yours, your logo, your colors, so you leave knowing exactly what your clients see.</p></div><div class=\"mx-auto mt-10 max-w-[860px] overflow-hidden rounded-[22px] border border-line bg-white shadow-art\"><img alt=\"Clientspace portal showing needs-your-attention items, active engagements, engagement value, and upcoming sessions for a client logging in\" loading=\"lazy\" width=\"1909\" height=\"940\" decoding=\"async\" data-nimg=\"1\" class=\"h-auto w-full\" style=\"color:transparent\" src=\"/screens/clientspace-space.webp\"/></div><ul class=\"mx-auto mt-6 flex max-w-2xl flex-wrap items-center justify-center gap-x-8 gap-y-2 text-[13.5px] text-muted\"><li class=\"flex items-center gap-2\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Standalone, no Workspace required</li><li class=\"flex items-center gap-2\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Branded to your firm</li><li class=\"flex items-center gap-2\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Live in the call, not a slide deck</li></ul></div></section><section class=\"section bg-white\"><div class=\"wrap\"><div class=\"mx-auto max-w-2xl text-center\"><span class=\"eyebrow justify-center\"><span class=\"eyebrow-dot\"></span> What you leave with</span><h2 class=\"mt-3 font-display text-[clamp(26px,4vw,40px)] font-semibold leading-[1.06] tracking-[-0.03em]\">Three things you keep, whether or not you buy.</h2></div><div class=\"mx-auto mt-10 grid max-w-[1040px] gap-[18px] md:grid-cols-3\"><div class=\"card h-full text-center\"><span class=\"text-[30px]\" aria-hidden=\"true\">🖥️</span><h3 class=\"mt-3 text-[16.5px] font-bold leading-snug\">A Clientspace you can show around</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">The portal we configure on the call is yours to keep exploring, share it internally before you decide anything.</p></div><div class=\"card h-full text-center\"><span class=\"text-[30px]\" aria-hidden=\"true\">📋</span><h3 class=\"mt-3 text-[16.5px] font-bold leading-snug\">A written rollout plan</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">A one-page summary of what we covered, what a rollout would look like for your firm, and honest effort estimates.</p></div><div class=\"card h-full text-center\"><span class=\"text-[30px]\" aria-hidden=\"true\">💰</span><h3 class=\"mt-3 text-[16.5px] font-bold leading-snug\">A pricing recommendation</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Clientspace standalone, Workspace standalone, or the bundle, we&#x27;ll tell you which actually fits, including when the answer is &quot;start smaller.&quot;</p></div></div></div></section><section class=\"section bg-canvas\"><div class=\"wrap\"><div class=\"mx-auto max-w-[1040px]\"><section aria-label=\"What teams raise on a demo call\" class=\"rounded-3xl border border-line bg-white p-6 shadow-card sm:p-8\"><div class=\"flex flex-wrap items-end justify-between gap-3\"><div><p class=\"font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-accent\">From discovery calls</p><h2 class=\"mt-2 font-display text-[26px] font-semibold leading-tight text-ink sm:text-[30px]\">What teams raise on the call.</h2></div><div class=\"flex items-center gap-2\"><button type=\"button\" aria-label=\"Previous testimonial\" class=\"grid h-9 w-9 place-items-center rounded-full border border-line text-ink transition-colors hover:border-ink/40\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M15 6l-6 6 6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-label=\"Next testimonial\" class=\"grid h-9 w-9 place-items-center rounded-full border border-line bg-ink text-white transition-colors hover:bg-black\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></div></div><div class=\"mt-6 grid grid-cols-1 gap-4 md:grid-cols-3\"><figure class=\"rounded-3xl border border-line bg-canvas/40 p-6 md:col-span-2\"><span aria-hidden=\"true\" class=\"inline-flex h-9 w-9 items-center justify-center rounded-full bg-accent-lt text-accent\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M7 7h4v4H8c0 2 1 3 3 3v3c-4 0-6-2-6-6V7zm9 0h4v4h-3c0 2 1 3 3 3v3c-4 0-6-2-6-6V7z\"></path></svg></span><blockquote class=\"mt-3 font-display text-[20px] leading-snug text-ink sm:text-[24px]\">We came in wanting to see one thing: could it turn our messy intake into a plan without rebuilding everything. The call walked through exactly that.</blockquote><figcaption class=\"mt-5 border-t border-line pt-3.5 text-[13px] text-muted\"><span class=\"font-semibold text-ink\">From a discovery call</span> ·<!-- --> <!-- -->Founder, mid-market consulting firm</figcaption></figure><div class=\"flex flex-col gap-3\"><figure class=\"rounded-2xl border border-line bg-white p-4\"><blockquote class=\"text-[13px] leading-relaxed text-ink\">&ldquo;The useful part was mapping it to our actual delivery flow, not a generic demo. We left knowing what a rollout would involve.&rdquo;</blockquote><figcaption class=\"mt-3 text-[12px] text-muted\"><span class=\"font-semibold text-ink\">From a discovery call</span> · <!-- -->Head of delivery, creative studio</figcaption></figure><figure class=\"rounded-2xl border border-line bg-white p-4\"><blockquote class=\"text-[13px] leading-relaxed text-ink\">&ldquo;What we wanted to understand was where our process leaks time. The session was specific and practical, with no fluff.&rdquo;</blockquote><figcaption class=\"mt-3 text-[12px] text-muted\"><span class=\"font-semibold text-ink\">From a discovery call</span> · <!-- -->Operations lead, advisory firm</figcaption></figure></div></div><div class=\"mt-6 flex justify-center gap-1.5\"><button type=\"button\" aria-label=\"Go to testimonial 1\" class=\"h-1.5 rounded-full transition-all w-6 bg-ink\"></button><button type=\"button\" aria-label=\"Go to testimonial 2\" class=\"h-1.5 rounded-full transition-all w-1.5 bg-line hover:bg-muted/50\"></button><button type=\"button\" aria-label=\"Go to testimonial 3\" class=\"h-1.5 rounded-full transition-all w-1.5 bg-line hover:bg-muted/50\"></button><button type=\"button\" aria-label=\"Go to testimonial 4\" class=\"h-1.5 rounded-full transition-all w-1.5 bg-line hover:bg-muted/50\"></button></div></section></div></div></section><section class=\"section bg-white\"><div class=\"wrap\"><div class=\"mx-auto max-w-2xl text-center\"><span class=\"eyebrow justify-center\"><span class=\"eyebrow-dot\"></span> After you book</span><h2 class=\"mt-3 font-display text-[clamp(26px,4vw,40px)] font-semibold leading-[1.06] tracking-[-0.03em]\">What happens next.</h2></div><ol class=\"mx-auto mt-10 grid max-w-[960px] gap-[18px] md:grid-cols-3\"><li class=\"card h-full\"><span class=\"grid h-9 w-9 place-items-center rounded-full bg-ink font-display text-[15px] font-bold text-white\">1</span><h3 class=\"mt-3.5 text-[16px] font-bold leading-snug\">Instant confirmation</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">You get a calendar invite with a Google Meet link right away. Nothing to install, no account needed.</p></li><li class=\"card h-full\"><span class=\"grid h-9 w-9 place-items-center rounded-full bg-ink font-display text-[15px] font-bold text-white\">2</span><h3 class=\"mt-3.5 text-[16px] font-bold leading-snug\">We prepare for your firm</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Tell us your industry and team size in the booking notes, and we&#x27;ll come with a Clientspace template that matches how firms like yours deliver.</p></li><li class=\"card h-full\"><span class=\"grid h-9 w-9 place-items-center rounded-full bg-ink font-display text-[15px] font-bold text-white\">3</span><h3 class=\"mt-3.5 text-[16px] font-bold leading-snug\">The call, then the plan</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">30 focused minutes on Google Meet. Within one business day, your written summary and rollout plan land in your inbox.</p></li></ol></div></section><section class=\"section bg-canvas\"><div class=\"wrap\"><div class=\"mx-auto max-w-2xl text-center\"><span class=\"eyebrow justify-center\"><span class=\"eyebrow-dot\"></span> Common questions</span><h2 class=\"mt-3 font-display text-[clamp(26px,4vw,40px)] font-semibold leading-[1.06] tracking-[-0.03em]\">Before you book.</h2></div><div class=\"mx-auto mt-10 grid max-w-[1040px] gap-[18px] md:grid-cols-2\"><div class=\"card h-full\"><h3 class=\"text-[15.5px] font-bold leading-snug\">Is this a sales call?</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">It&#x27;s a working session. We spend the time setting up a Clientspace on one of your real engagements and mapping fit, not walking through slides. If PYNGYN isn&#x27;t right for your firm, we&#x27;ll say so.</p></div><div class=\"card h-full\"><h3 class=\"text-[15.5px] font-bold leading-snug\">Do I need to prepare anything?</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">No preparation required. If you want the most out of it, have one current engagement in mind, we&#x27;ll use it to set up your Clientspace live on the call.</p></div><div class=\"card h-full\"><h3 class=\"text-[15.5px] font-bold leading-snug\">Who should join from our side?</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Whoever owns the client relationship problem: partners, practice managers, operations or delivery leads. Bring the whole group if you like, add their emails in the booking notes.</p></div><div class=\"card h-full\"><h3 class=\"text-[15.5px] font-bold leading-snug\">We already use Notion, ClickUp, Jira, or spreadsheets. Is this still useful?</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Yes, that&#x27;s the most common starting point. We&#x27;ll be honest about what PYNGYN replaces, what it sits alongside, and what migration actually involves.</p></div><div class=\"card h-full\"><h3 class=\"text-[15.5px] font-bold leading-snug\">Can I just try the product instead?</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Absolutely. There&#x27;s a 7-day free trial with no credit card, Clientspace is $19 per client/month standalone, Workspace is $9 per seat/month, or bundle both for $24.99/month. The demo is for teams who want a guided setup and a rollout plan.</p></div><div class=\"card h-full\"><h3 class=\"text-[15.5px] font-bold leading-snug\">Is our data safe if we share our workflow on the call?</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">The call is a conversation over Google Meet, nothing is uploaded anywhere. If we set up a trial Clientspace, it lives in your own account, isolated per client, and you can delete it any time.</p></div></div><p class=\"mx-auto mt-8 max-w-xl text-center text-[14px] text-muted\">Not ready for a call? You can<!-- --> <a href=\"https://app.pyngyn.ai/?signup=true\" class=\"font-semibold text-accent hover:text-accent-dk\">start a 7-day free trial</a> <!-- -->instead, no credit card required.</p></div></section><section class=\"wrap pb-20\"><section class=\"rounded-3xl border border-line bg-ink p-7 text-white shadow-soft sm:p-9\"><div class=\"flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between\"><div><p class=\"font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-white/60\">Ready when you are</p><h2 class=\"mt-2 font-display text-[24px] font-semibold leading-tight sm:text-[28px]\">One 30-minute call. A clearer plan, either way.</h2><p class=\"mt-2 max-w-xl text-[14px] text-white/70\">If PYNGYN&#x27;s the right fit, we&#x27;ll show you exactly how to roll it out. If not, you&#x27;ll still walk away with a sharper view of your workflow.</p></div><a href=\"#booking\" class=\"btn btn-accent shrink-0\">Pick a time →</a></div></section></section></main><footer class=\"border-t border-line bg-white pt-16 pb-10 text-sm text-muted\"><div class=\"wrap\"><div class=\"grid gap-10 lg:grid-cols-[1.4fr_repeat(5,1fr)]\"><div><a class=\"mb-4 inline-block\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" loading=\"lazy\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><p class=\"max-w-[230px] leading-relaxed\">The operating system for professional-services firms.</p><a href=\"https://play.google.com/store/apps/details?id=com.pyngyn.io&amp;hl=en_IN\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"mt-5 inline-flex items-center gap-2.5 rounded-xl border border-line bg-white px-4 py-2.5 transition-colors hover:border-accent\" aria-label=\"Get PYNGYN on Google Play\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3.6 2.3 13 12 3.6 21.7a1.4 1.4 0 0 1-.6-1.2V3.5c0-.5.2-.9.6-1.2z\" fill=\"#34a853\"></path><path d=\"M16.8 8.6 13 12 3.6 2.3c.4-.3.9-.3 1.4 0l8.8 5z\" fill=\"#ea4335\"></path><path d=\"M16.8 15.4 5 22c-.5.3-1 .3-1.4 0L13 12z\" fill=\"#fbbc04\"></path><path d=\"m16.8 8.6 4 2.3c.7.4.7 1.4 0 1.8l-4 2.7L13 12z\" fill=\"#4285f4\"></path></svg><span class=\"flex flex-col leading-tight\"><span class=\