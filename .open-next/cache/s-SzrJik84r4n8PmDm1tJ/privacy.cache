ype\":\"application/ld+json\",\"id\":\"$undefined\",\"dangerouslySetInnerHTML\":{\"__html\":\"$10\"}}],[\"$\",\"$L11\",null,{}],[\"$\",\"main\",null,{\"id\":\"main\",\"className\":\"wrap pb-[104px] pt-[150px]\",\"children\":[\"$\",\"article\",null,{\"className\":\"mx-auto max-w-[820px]\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"font-display text-[clamp(32px,4.4vw,48px)] font-semibold leading-[1.08] tracking-[-0.025em]\",\"children\":\"Pyngyn Privacy Policy\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[14px] text-muted\",\"children\":[\"Last updated: \",\"June 22, 2026\"]}],\"$undefined\",[\"$\",\"p\",null,{\"className\":\"mt-6 text-[17px] leading-[1.7] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Welcome to Pyngyn. Your privacy is extremely important to us. Because Pyngyn is a business-to-business (B2B) platform, the way we handle your data depends on how you interact with our service. This Privacy Policy explains what data we collect, why we collect it, our legal bases for doing so under the General Data Protection Regulation (“GDPR”) and the Digital Personal Data Protection Act (“DPDP Act”), and how you can exercise your rights. If you do not agree to our use of your personal data in line with this policy, please do not use the Pyngyn Services.\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-10 flex flex-col gap-9\",\"children\":[[\"$\",\"section\",\"0\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-[22px] font-semibold tracking-[-0.01em]\",\"children\":\"1. Our Role: Controller vs. Processor\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-col gap-3.5\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-[16px] leading-[1.7] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"To understand how your data is managed, it is important to understand the distinct roles Pyngyn plays, depending on how you interact with us:\"}]]}],[\"$\",\"ul\",\"1\",{\"className\":\"flex flex-col gap-2\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"As a Data Controller:\"}],[\"$\",\"span\",\"1\",{\"children\":\" When you create an account, request customer support, book a demo, or browse our public website, Pyngyn acts as the Data Controller. We determine how and why this operational, billing, marketing, and account data is processed.\"}]]}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\",\"children\":[\"$L12\",\"$L13\"]}]]}]]}]]}],\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"]}]]}]}],\"$L1d\"],[\"$L1e\",\"$L1f\"],\"$L20\"]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L21\",null,{\"children\":\"$L22\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L23\",null,{\"children\":[\"$\",\"$24\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L25\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\nd:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/02mkr0z8o939x.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n30:I[56691,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/41mnvtr75by45.js\",\"/_next/static/chunks/1_p0c8_mtfqqv.js\"],\"Footer\"]\n31:I[97367,[\"/_next/static/chunks/0ht-3v40sanoo.js\"],\"OutletBoundary\"]\na:C\n12:[\"$\",\"span\",null,{\"className\":\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\",\"aria-hidden\":\"true\"}]\n13:[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"As a Data Processor:\"}],[\"$\",\"span\",\"1\",{\"children\":\" For all the project data, tasks, comments, and files you create or upload within a corporate workspace, your employer o