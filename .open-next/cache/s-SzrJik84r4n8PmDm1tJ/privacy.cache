g partner, \"}],[\"$\",\"strong\",\"1\",{\"children\":\"Anthropic\"}],[\"$\",\"span\",\"2\",{\"children\":\", and is not permanently recorded or saved in Pyngyn's internal databases.\"}]]}]]}]\n1e:[\"$\",\"tr\",\"4\",{\"className\":\"border-b border-line\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Communications Data, support ticket histories, issue subjects, and diagnostic communications.\"}]]}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"To troubleshoot platform exceptions and provide customer support.\"}]]}],[\"$\",\"td\",\"2\",{\"className\":\"px-4 py-3 align-top leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Legitimate Interest / Legitimate Use (GDPR Art. 6(1)(f) / DPDP Act Sec. 7).\"}]]}]]}]\n1f:[\"$\",\"tr\",\"5\",{\"className\":\"\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Technical & Security Telemetry, IP addresses, user-agent strings, and edge ingress access logs.\"}]]}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Essential for cyber defense, real-time rate-limiting, and maintaining the stability of our cloud boundaries.\"}]]}],[\"$\",\"td\",\"2\",{\"className\":\"px-4 py-3 align-top leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Legitimate Interest / Legitimate Use (GDPR Art. 6(1)(f) / DPDP Act Sec. 7).\"}]]}]]}]\n20:[\"$\",\"p\",\"3\",{\"className\":\"text-[16px] leading-[1.7] text-ink\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"B. Data We Process (Workspace Content)\"}]]}]\n21:[\"$\",\"ul\",\"4\",{\"className\":\"flex flex-col gap-2\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-2.