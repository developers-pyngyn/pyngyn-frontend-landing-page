ull \"}],\"$L22\",\"$L23\",\"$L24\",\"$L25\"]}]]}]]}]\n8:[\"$\",\"section\",\"4\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-[22px] font-semibold tracking-[-0.01em]\",\"children\":\"5. Your Data Privacy Rights\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-col gap-3.5\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-[16px] leading-[1.7] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Depending on your region, you have the following rights regarding your personal data:\"}]]}],[\"$\",\"ul\",\"1\",{\"className\":\"flex flex-col gap-2\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"Right to Access:\"}],[\"$\",\"span\",\"1\",{\"children\":\" You may request a copy of the personal data we hold about you.\"}]]}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"Right to Rectification:\"}],[\"$\",\"span\",\"1\",{\"children\":\" You may request correction of inaccurate or incomplete personal data.\"}]]}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"Right to Erasure:\"}],[\"$\",\"span\",\"1\",{\"children\":\" You may request deletion of your personal data where it is no longer necessary for the purposes for which it was collected.\"}]]}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"Right to Restriction of Processing:\"}],[\"$\",\"span\",\"1\",{\"children\":\" You may request that we restrict processing of your personal data in certain circumstances.\"}]]}]]}],[\"$\",\"li\",\"4\",{\"className\":\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"Right to Data Portability:\"}],[\"$\",\"span\",\"1\",{\"children\":\" You may request to receive your personal data in a structured, commonly used, machine-readable format.\"}]]}]]}],[\"$\",\"li\",\"5\",{\"className\":\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"Right to Object:\"}],[\"$\",\"span\",\"1\",{\"children\":\" You may object to processing based on legitimate interests, direct marketing, or profiling.\"}]]}]]}],[\"$\",\"li\",\"6\",{\"className\":\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"Right to Withdraw Consent:\"}],[\"$\",\"span\",\"1\",{\"children\":\" Where processing is based on consent, you may withdraw that consent at any time without affecting the lawfulness of prior processing.\"}]]}]]}]]}],[\"$\",\"p\",\"2\",{\"className\":\"text-[16px] leading-[1.7] text-ink\",\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"How to exercise your rights:\"}]]}],[\"$\",\"ul\",\"3\",{\"className\":\"flex flex-col gap-2\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"For Account & Technical Data (Controller Data):\"}],[\"$\",\"span\",\"1\",{\"children\":\" If you wish to access, correct, or delete your Pyngyn profile details, billing history, or support history, you can submit a request directly to us using the contact information below.\"}]]}]]}],\"$L26\"]}]]}]]}]\n9:[\"$\",\"section\",\"5\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-[22px] font-semibold tracking-[-0.01em]\",\"children\":\"6. Where Will Data Be Transferred?\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-col gap-3.5\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-[16px] leading-[1.7] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Your data, including personal data that we collect from you, may be transferred to, stored at, and processed by us and other third parties outside the country in which you reside, including, but not limited to, the United States, where data protection and privacy regulations may not offer the same level of protection as in other parts of the world. By using our platform, you agree to this transfer, storing, or processing, subject to the terms of our applicable Data Processing Agreements. We will take all steps reasonably necessary to ensure that your data is treated securely and in accordance with this policy.\"}]]}]]}]]}]\na:[\"$\",\"section\",\"6\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-[22px] font-semibold tracking-[-0.01em]\",\"children\":\"7. Do We Collect Information from Children?\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-col gap-3.5\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-[16px] leading-[1.7] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"We are committed to protecting the privacy of children. The Pyngyn Service is a B2B platform and is not designed for or directed to children under the age of 16. We do not knowingly collect personally identifiable information from any person we actually know is under the age of 16.\"}]]}]]}]]}]\nb:[\"$\",\"section\",\"7\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-[22px] font-semibold tracking-[-0.01em]\",\"children\":\"8. How Will Information Be Secured?\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-col gap-3.5\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-[16px] leading-[1.7] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"We take precautions to protect the security of your information. We have physical, electronic, and managerial procedures in place to help safeguard, prevent unauthorized access, maintain data security, and correctly use your information. However, no method of transmission over the internet or method of electronic storage is 100% secure, and we cannot guarantee absolute security.\"}]]}]]}]]}]\nc:[\"$\",\"section\",\"8\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-[22px] font-semibold tracking-[-0.01em]\",\"children\":\"9. How Will I Know if There Are Any Changes to This Privacy Policy?\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-col gap-3.5\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-[16px] leading-[1.7] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"We may revise this Privacy Policy from time to time. We will not make changes that result in significant additional uses or disclosures of your personal data without notifying you of such changes via email. We will also make non-significant changes to this Privacy Policy for which an email is not required. We encourage you to check this page periodically for any changes. Your continued use of the Pyngyn Service following the posting of changes to this Privacy Policy constitutes your acceptance of those changes.\"}]]}]]}]]}]\nd:[\"$\",\"section\",\"9\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-[22px] font-semibold tracking-[-0.01em]\",\"children\":\"10. Contact for Data Requests\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-col gap-3.5\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-[16px] leading-[1.7] text-ink\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"If you have any questions about this Privacy Policy, wish to exercise your rights as a data principal, or need to contact our Data Protection Officer (DPO), please reach out to us at:\"}]]}],[\"$\",\"div\",\"1\",{\"className\":\"rounded-[14px] border border-line bg-[#fbfbfd] p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-1.5 text-[14px] font-bold text-ink\",\"children\":\"Privacy & Compliance Team\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-1 text-[14.5px] leading-[1.6] text-ink\",\"children\":[[\"$\",\"div\",\"0\",{\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Data Protection Officer: Vivek Pandey\"}]]}],[\"$\",\"div\",\"1\",{\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Email: \"}],[\"$\",\"strong\",\"1\",{\"children\":\"[vivek.pandey@pyngyn.com](mailto:vivek.pandey@pyngyn.com)\"}]]}],[\"$\",\"div\",\"2\",{\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Subject Line: Data Subject Request – [Your Name]\"}]]}]]}]]}]]}]]}]\ne:[\"$\",\"$L27\",null,{}]\nf:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/41mnvtr75by45.js\",\"async\":true}]\n10:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"async\":true}]\n11:[\"$\",\"$L28\",null,{\"children\":[\"$\",\"$29\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@2a\"}]}]\n14:[\"$\",