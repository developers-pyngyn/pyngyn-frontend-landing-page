fill\":\"none\",\"aria-hidden\":\"true\",\"className\":\"mt-0.5 flex-none text-positive\",\"children\":[\"$\",\"path\",null,{\"d\":\"M5 12l5 5L20 6\",\"stroke\":\"currentColor\",\"strokeWidth\":\"3\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\"}]}],\"One-click magic-link access\"]}],[\"$\",\"li\",\"Invoices & online payments\",{\"className\":\"flex items-start gap-2.5 text-[14.5px]\",\"children\":[[\"$\",\"svg\",null,{\"width\":\"13\",\"height\":\"13\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"aria-hidden\":\"true\",\"className\":\"mt-0.5 flex-none text-positive\",\"children\":[\"$\",\"path\",null,{\"d\":\"M5 12l5 5L20 6\",\"stroke\":\"currentColor\",\"strokeWidth\":\"3\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\"}]}],\"Invoices & online payments\"]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-8 flex flex-wrap justify-center gap-3\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://app.pyngyn.ai/?signup=true\",\"className\":\"btn btn-accent\",\"children\":\"Start free trial\"}],[\"$\",\"a\",null,{\"href\":\"/demo\",\"className\":\"btn btn-primary\",\"children\":\"Book a demo\"}]]}]]}]}]}]\n20:[\"$\",\"section\",null,{\"className\":\"section bg-[#fbfbfd]\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":\"FAQ\"}],[\"$\",\"h2\",null,{\"className\":\"mt-3 font-display text-[clamp(24px,3vw,32px)] font-semibold tracking-[-0.01em]\",\"children\":\"Questions about Client Space.\"}],[\"$\",\"div\",null,{\"className\":\"mt-7 grid gap-[18px] md:grid-cols-2\",\"children\":[[\"$\",\"div\",\"What is Client Space?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"What is Client Space?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Client Space is a branded client portal for your firm, sold on its own. Each client gets their own secure, isolated space showing the status of their engagement, their documents, approvals, and invoices, so they stop emailing you for updates and start self-serving 24/7.\"}]]}],[\"$\",\"div\",\"How much does Client Space cost?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"How much does Client Space cost?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Client Space is $19 per client per month, standalone, you don't need to buy Workspace to use it. If your firm also wants Workspace (your internal back office, $9 per seat/month), you can bundle both for $24.99/month.\"}]]}],[\"$\",\"div\",\"Do my clients need to create an account or remember a password?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"Do my clients need to create an account or remember a password?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"No. Clients join with a one-click magic link, no password to remember and no login friction. Login frustration is the number-one reason client portals go unused, so we removed it entirely.\"}]]}],[\"$\",\"div\",\"Can clients see my other clients, or my internal work?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"Can clients see my other clients, or my internal work?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Never. Each Client Space is fully isolated. A client sees only their own engagement, never another client's work, and never your internal operations. You control exactly what's visible.\"}]]}],[\"$\",\"div\",\"Is it secure enough for legal and financial documents?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"Is it secure enough for legal and financial documents?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Yes. Documents are encrypted in transit and at rest, access is controlled per client, and every action is logged in an audit trail, far safer than emailing sensitive records, which most firms still do.\"}]]}],[\"$\",\"div\",\"Can I brand it as my own firm?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"Can I brand it as my own firm?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Yes. Client Space is white-labeled with your logo, colors, and domain. To your clients, it looks and feels like your firm's own portal.\"}]]}],[\"$\",\"div\",\"What is Workspace, and do I need it?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"What is Workspace, and do I need it?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Workspace is a separate product, your firm's internal back office for projects, finances, and billable time. You don't need it to use Client Space. Firms that want both can bundle Workspace and Client Space together for $24.99/month.\"}]]}]]}]]}]}]\n21:[\"$\",\"$L31\",null,{\"headline\":\"Give every client their own portal, not another email thread.\",\"body\":\"See Client Space set up on a real engagement in 30 minutes, branded portal, magic-link invite, live status from day one.\",\"secondaryLabel\":\"Start free trial\",\"note\":\"30-minute walkthrough · Set up in minutes · No commitment\"}]\n25:null\n13:true\na:300\n30:[\"$\",\"div\",\"Invoices & online payment\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[26px]\",\"aria-hidden\":\"true\",\"children\":\"💳\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[15.5px] font-bold leading-snug\",\"children\":\"Invoices & online payment\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[13.5px] leading-relaxed text-muted\",\"children\":\"Clients view invoices and pay inside the portal. Faster cash flow, fewer billing disputes, and no chasing.\"}]]}]\na:C\n12:0\nc:\"$undefined\"\ne:\"$undefined\"\n11:\"$undefined\"\n9:\"$undefined\"\n"}}