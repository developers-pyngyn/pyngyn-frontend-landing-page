iv\",null,{\"className\":\"mt-8 flex flex-wrap gap-3\",\"children\":[[\"$\",\"a\",null,{\"href\":\"/demo\",\"className\":\"btn btn-accent\",\"children\":\"Book a demo\"}],[\"$\",\"a\",null,{\"href\":\"https://app.pyngyn.ai/?signup=true\",\"className\":\"btn btn-primary\",\"children\":\"Start free trial\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-[13px] text-muted\",\"children\":[\"From \",[\"$\",\"strong\",null,{\"className\":\"text-ink\",\"children\":\"$$19 per client / month\"}],\" · standalone, no Workspace required · clients join with one click\"]}]]}],[\"$\",\"section\",null,{\"className\":\"wrap pb-[72px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[900px] overflow-hidden rounded-[22px] border border-line bg-white shadow-art\",\"children\":[\"$\",\"$L15\",null,{\"src\":\"/screens/clientspace-space.webp\",\"alt\":\"Client Space portal showing needs-your-attention items, active engagements, engagement value, and upcoming sessions for a client logging in\",\"width\":1909,\"height\":940,\"priority\":true,\"sizes\":\"(max-width: 768px) 100vw, 900px\",\"className\":\"h-auto w-full\"}]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-center text-[13px] text-muted\",\"children\":\"What your client sees when they log in, branded as your firm, updated automatically.\"}]]}],[\"$\",\"section\",null,{\"className\":\"section bg-[#fbfbfd]\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":\"The problem\"}],[\"$\",\"h2\",null,{\"className\":\"mt-3 max-w-[720px] font-display text-[clamp(26px,3.4vw,42px)] font-semibold leading-tight tracking-[-0.025em]\",\"children\":\"Your clients are in the dark, and it's costing you.\"}],[\"$\",\"p\",null,{\"className\":\"lead mt-4 max-w-[620px]\",\"children\":\"Most firms still run client communication through email. Clients can't see anything without asking, so they ask constantly, and the work waits while you answer.\"}],[\"$\",\"div\",null,{\"className\":\"mt-10 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-4\",\"children\":[[\"$\",\"div\",\"Clients chase you for updates\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-display text-[20px] font-semibold leading-tight text-accent\",\"children\":\"“Did you get my email?”\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[15.5px] font-bold leading-snug\",\"children\":\"Clients chase you for updates\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[13.5px] leading-relaxed text-muted\",\"children\":\"Every status request is an email, a call, or a text. You become the bottleneck between your client and their own information, and the work stops while you answer.\"}]]}],[\"$\",\"div\",\"Email creates more work, not less\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-display text-[20px] font-semibold leading-tight text-accent\",\"children\":\"90%\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[15.5px] font-bold leading-snug\",\"children\":\"Email creates more work, not less\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[13.5px] leading-relaxed text-muted\",\"children\":\"Email threads generate far more back-and-forth than a portal, leave no audit trail, and bury the one document everyone needs under twenty replies.\"}]]}],\"$L16\",\"$L17\"]}],\"$L18\"]}]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"]}]\n5:[\"$\",\"$L22\",null,{}]\n6:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/41mnvtr75by45.js\",\"async\":true}]\n7:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"async\":true}]\n8:[\"$\",\"$L23\",null,{\"children\":[\"$\",\"$24\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@25\"}]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L26\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"