\",\"svg\",null,{\"width\":\"13\",\"height\":\"13\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"aria-hidden\":\"true\",\"className\":\"mt-0.5 flex-none text-positive\",\"children\":[\"$\",\"path\",null,{\"d\":\"M5 12l5 5L20 6\",\"stroke\":\"currentColor\",\"strokeWidth\":\"3\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\"}]}],\"Approvals with full audit trail\"]}],[\"$\",\"li\",\"One-click magic-link access\",{\"className\":\"flex items-start gap-2.5 text-[14.5px]\",\"children\":[[\"$\",\"svg\",null,{\"width\":\"13\",\"height\":\"13\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"aria-hidden\":\"true\",\"className\":\"mt-0.5 flex-none text-positive\",\"children\":[\"$\",\"path\",null,{\"d\":\"M5 12l5 5L20 6\",\"stroke\":\"currentColor\",\"strokeWidth\":\"3\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\"}]}],\"One-click magic-link access\"]}],[\"$\",\"li\",\"Invoices & online payments\",{\"className\":\"flex items-start gap-2.5 text-[14.5px]\",\"children\":[[\"$\",\"svg\",null,{\"width\":\"13\",\"height\":\"13\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"aria-hidden\":\"true\",\"className\":\"mt-0.5 flex-none text-positive\",\"children\":[\"$\",\"path\",null,{\"d\":\"M5 12l5 5L20 6\",\"stroke\":\"currentColor\",\"strokeWidth\":\"3\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\"}]}],\"Invoices & online payments\"]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-8 flex flex-wrap justify-center gap-3\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://app.pyngyn.ai/?signup=true\",\"className\":\"btn btn-accent\",\"children\":\"Start free trial\"}],[\"$\",\"a\",null,{\"href\":\"/demo\",\"className\":\"btn btn-primary\",\"children\":\"Book a demo\"}]]}]]}]}]}]\n28:[\"$\",\"section\",null,{\"className\":\"section bg-[#fbfbfd]\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":\"FAQ\"}],[\"$\",\"h2\",null,{\"className\":\"mt-3 font-display text-[clamp(24px,3vw,32px)] font-semibold tracking-[-0.01em]\",\"children\":\"Questions about Client Space.\"}],[\"$\",\"div\",null,{\"className\":\"mt-7 grid gap-[18px] md:grid-cols-2\",\"children\":[[\"$\",\"div\",\"What is Client Space?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"What is Client Space?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Client Space is a branded client portal for your firm, sold on its own. Each client gets their own secure, isolated space showing the status of their engagement, their documents, approvals, and invoices, so they stop emailing you for updates and start self-serving 24/7.\"}]]}],[\"$\",\"div\",\"How much does Client Space cost?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"How much does Client Space cost?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Client Space is $19 per client per month, standalone, you don't need to buy Workspace to use it. If your firm also wants Workspace (your internal back office, $9 per seat/month), you can bundle both for $24.99/month.\"}]]}],[\"$\",\"div\",\"Do my clients need to create an account or remember a password?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"Do my clients need to create an account or remember a password?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"No. Clients join with a one-click magic link, no password to remember and no login friction. Login frustration is the number-one reason client portals go unused, so we removed it entirely.\"}]]}],[\"$\",\"div\",\"Can clients see my other clients, or my internal work?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"Can clients see my other clients, or my internal work?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Never. Each Client Space is fully isolated. A client sees only their own engagement, never another client's work, and never your internal operations. You control exactly what's visible.\"}]]}],[\"$\",\"div\",\"Is it secure enough for legal and financial documents?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"Is it secure enough for legal and financial documents?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Yes. Documents are encrypted in transit and at rest, access is controlled per client, and every action is logged in an audit trail, far safer than emailing sensitive records, which most firms still do.\"}]]}],[\"$\",\"div\",\"Can I brand it as my own firm?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"Can I brand it as my own firm?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Yes. Client Space is white-labeled with your logo, colors, and domain. To your clients, it looks and feels like your firm's own portal.\"}]]}],[\"$\",\"div\",\"What is Workspace, and do I need it?\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"What is Workspace, and do I need it?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Workspace is a separate product, your firm's internal back office for projects, finances, and billable time. You don't need it to use Client Space. Firms that want both can bundle Workspace and Client Space together for $24.99/month.\"}]]}]]}]]}]}]\n29:[\"$\",\"$L2f\",null,{\"headline\":\"Give every client their own portal, not another email thread.\",\"body\":\"See Client Space set up on a real engagement in 30 minutes, branded portal, magic-link invite, live status from day one.\",\"secondaryLabel\":\"Start free trial\",\"note\":\"30-minute walkthrough · Set up in minutes · No commitment\"}]\n2e:[\"$\",\"div\",\"Invoices & online payment\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[26px]\",\"aria-hidden\":\"true\",\"children\":\"💳\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[15.5px] font-bold leading-snug\",\"children\":\"Invoices & online payment\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[13.5px] leading-relaxed text-muted\",\"children\":\"Clients view invoices and pay inside the portal. Faster cash flow, fewer billing disputes, and no chasing.\"}]]}]\n18:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n1b:[[\"$\",\"title\",\"0\",{\"children\":\"Client Space | PYNGYN, the standalone branded client portal for professional-services firms\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Give every client a branded portal where they see status, documents, and approvals 24/7, instead of emailing you for updates. Client Space is $19 per client / month, standalone. No Workspace purchase required.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"author\",\"content\":\"Nikunj Chugh\"}],[\"$\",\"meta\",\"3\",{\"name\":\"creator\",\"content\":\"Nikunj Chugh\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://pyngyn.ai/clientspace/\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Client Space | The standalone branded client portal for professional-services firms\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Stop being the bottleneck between your clients and their own information. Give every client a branded, secure portal, status, documents, approvals, and payments in one place.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:url\",\"content\":\"https://pyngyn.ai/clientspace/\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image\",\"content\":\"https://pyngyn.ai/og.png\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:image:alt\",\"content\":\"PYNGYN: Clientspace, a standalone branded client portal, and Workspace, a standalone back office for professional-services firms\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:site\",\"content\":\"@Pyngyn_Official\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:creator\",\"content\":\"@Pyngyn_Official\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:title\",\"content\":\"PYNGYN: The operating system for professional-services firms\"}],[\"$\",\"meta\",\"17\",{\"name\":\"twitter:description\",\"content\":\"Run your firm and every client engagement in one place. The operating system for professional-services firms.\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:image\",\"content\":\"https://pyngyn.ai/og.png\"}],[\"$\",\"link\",\"19\",{\"rel\":\"icon\",\"href\":\"/icon.png\"}],[\"$\",\"link\",\"20\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png\"}],[\"$\",\"$L30\",\"21\",{}]]\n2c:null\n","/clientspace/__PAGE__":"1:\"$Sreact.fragment\"\n2:Tc49,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://pyngyn.ai/clientspace#webpage\",\"url\":\"https://pyngyn.ai/clientspace\",\"name\":\"Client Space | PYNGYN, the standalone branded client portal for professional-services firms\",\"description\":\"Give every client a branded portal where they see status, documents, and approvals 24/7 instead of emailing you. $19 per client / month, standalone.\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"breadcrumb\":{\"@id\":\"https://pyngyn.ai/clientspace#breadcrumb\"},\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/clientspace#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://pyngyn.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Client Space\",\"item\":\"https://pyngyn.ai/clientspace\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://pyngyn.ai/clientspace#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is Client Space?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Client Space is a branded client portal for your firm, sold on its own. Each client gets their own secure, isolated space showing the status of their engagement, their documents, approvals, and invoices, so they stop emailing you for updates and start self-serving 24/7.\"}},{\"@type\":\"Question\",\"name\":\"How much does Client Space cost?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Client Space is $19 per client per month, standalone, you don't need to buy Workspace to use it. If your firm also wants Workspace (your internal back office, $9 per seat/month), you can bundle both for $24.99/month.\"}},{\"@type\":\"Question\",\"name\":\"Do my clients need to create an account or remember a password?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Clients join with a one-click magic link, no password to remember and no login friction. Login frustration is the number-one reason client portals go unused, so we removed it entirely.\"}},{\"@type\":\"Question\",\"name\":\"Can clients see my other clients, or my internal work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Never. Each Client Space is fully isolated. A client sees only their own engagement, never another client's work, and never your internal operations. You control exactly what's visible.\"}},{\"@type\":\"Question\",\"name\":\"Is it secure enough for legal and financial documents?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Documents are encrypted in transit and at rest, access is controlled per client, and every action is logged in an audit trail, far safer than emailing sensitive records, which most firms still do.\"}},{\"@type\":\"Question\",\"name\":\"Can I brand it as my own firm?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Client Space is white-labeled with your logo, colors, and domain. To your clients, it looks and feels like your firm's own portal.\"}},{\"@type\":\"Question\",\"name\":\"What is Workspace, and do I need it?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Workspace is a separate product, your firm's internal back office for projects, finances, and billable time. You don't need it to use Client Space. Firms that want both can bundle Workspace and Client Space together for $24.99/month.\"}}]}]}a:X\nf:X\nf:C\n0:{\"buildId\":\"s-SzrJik84r4n8PmDm1tJ\",\"data\":[{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\"],[\"$L6\",\"$L7\"],\"$L8\"]}],\"isPartial\":\"$@9\",\"staleTime\":\"$a\",\"varyParams\":null},{\"rsc\":\"$Lb\",\"isPartial\":\"$@c\",\"staleTime\":\"$a\",\"varyParams\":null},{\"rsc\":\"$Ld\",\"isPartial\":\"$@e\",\"staleTime\":\"$a\",\"varyParams\":\"$f\"},{\"rsc\":\"$L10\",\"isPartial\":\"$@11\",\"staleTime\":\"$a\",\"varyParams\":null}],\"isUpgradeableISRFallback\":false,\"a\":\"$@12\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@13\"}\n14:I[62319,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/41mnvtr75by45.js\",\"/_next/static/chunks/1_p0c8_mtfqqv.js\"],\"Navbar\"]\n15:I[85437,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/41mnvtr75by45.j