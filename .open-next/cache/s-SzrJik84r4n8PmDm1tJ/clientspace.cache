3.4vw,42px)] font-semibold leading-tight tracking-[-0.025em]\",\"children\":\"Your clients are in the dark, and it's costing you.\"}],[\"$\",\"p\",null,{\"className\":\"lead mt-4 max-w-[620px]\",\"children\":\"Most firms still run client communication through email. Clients can't see anything without asking, so they ask constantly, and the work waits while you answer.\"}],[\"$\",\"div\",null,{\"className\":\"mt-10 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-4\",\"children\":[[\"$\",\"div\",\"Clients chase you for updates\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-display text-[20px] font-semibold leading-tight text-accent\",\"children\":\"“Did you get my email?”\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[15.5px] font-bold leading-snug\",\"children\":\"Clients chase you for updates\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[13.5px] leading-relaxed text-muted\",\"children\":\"Every status request is an email, a call, or a text. You become the bottleneck between your client and their own information, and the work stops while you answer.\"}]]}],[\"$\",\"div\",\"Email creates more work, not less\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-display text-[20px] font-semibold leading-tight text-accent\",\"children\":\"90%\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[15.5px] font-bold leading-snug\",\"children\":\"Email creates more work, not less\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[13.5px] leading-relaxed text-muted\",\"children\":\"Email threads generate far more back-and-forth than a portal, leave no audit trail, and bury the one document everyone needs under twenty replies.\"}]]}],\"$L1e\",\"$L1f\"]}],\"$L20\"]}]}],\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\"]}]\n13:[\"$\",\"$L2a\",null,{}]\n14:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/41mnvtr75by45.js\",\"async\":true,\"nonce\":\"$undefined\