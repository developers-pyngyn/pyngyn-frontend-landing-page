{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/clientspace/layout,_N_T_/clientspace/page,_N_T_/clientspace"},"segmentPaths":["/_tree","/_full","/clientspace/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"display_2a073e65-module__7MkqkG__variable jakarta_55fc869e-module__LB2P7q__variable mono_8ba1b3ff-module__cxzmQq__variable\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_400_normal-s.p.2_o2v7tpo0q5m.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_500_normal-s.p.3vqzgd2jdiw22.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_600_normal-s.p.3_r60-qkmao3a.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_700_normal-s.p.0rb33xx2bxpl8.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_400_normal-s.p.3crsbyy6lh6yf.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_500_normal-s.p.2h52d08o60qht.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_600_normal-s.p.2mm922pe315l1.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_400_normal-s.p.2ysn9gc82zk1v.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_500_normal-s.p.1evhelic1rxge.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_600_normal-s.p.0p6sew1q6gl7s.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_700_normal-s.p.1dulefe5e4s81.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"/logo.webp\"/><link rel=\"preload\" as=\"image\" href=\"/screens/clientspace-space.webp\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/02mkr0z8o939x.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1b-l3oagpuv39.js\"/><script src=\"/_next/static/chunks/11jq0c2_zavac.js\" async=\"\"></script><script src=\"/_next/static/chunks/4561u0v7ysn3r.js\" async=\"\"></script><script src=\"/_next/static/chunks/021sppg0zbt0v.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2pcc6e_qu_s3g.js\" async=\"\"></script><script src=\"/_next/static/chunks/0ht-3v40sanoo.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/41mnvtr75by45.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/1_p0c8_mtfqqv.js\" async=\"\" crossorigin=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Client Space | PYNGYN, the standalone branded client portal for professional-services firms</title><meta name=\"description\" content=\"Give every client a branded portal where they see status, documents, and approvals 24/7, instead of emailing you for updates. Client Space is $19 per client / month, standalone. No Workspace purchase required.\"/><meta name=\"author\" content=\"Nikunj Chugh\"/><meta name=\"creator\" content=\"Nikunj Chugh\"/><link rel=\"canonical\" href=\"https://pyngyn.ai/clientspace/\"/><meta property=\"og:title\" content=\"Client Space | The standalone branded client portal for professional-services firms\"/><meta property=\"og:description\" content=\"Stop being the bottleneck between your clients and their own information. Give every client a branded, secure portal, status, documents, approvals, and payments in one place.\"/><meta property=\"og:url\" content=\"https://pyngyn.ai/clientspace/\"/><meta property=\"og:image\" content=\"https://pyngyn.ai/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"PYNGYN: Clientspace, a standalone branded client portal, and Workspace, a standalone back office for professional-services firms\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:site\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:creator\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:title\" content=\"PYNGYN: The operating system for professional-services firms\"/><meta name=\"twitter:description\" content=\"Run your firm and every client engagement in one place. The operating system for professional-services firms.\"/><meta name=\"twitter:image\" content=\"https://pyngyn.ai/og.png\"/><link rel=\"icon\" href=\"/icon.png\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png\"/><script type=\"application/ld+json\" id=\"ld-organization\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://pyngyn.ai/#organization\",\"name\":\"PYNGYN\",\"legalName\":\"VIMOVI GlobalTech Private Limited\",\"url\":\"https://pyngyn.ai/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://pyngyn.ai/logo.png\",\"width\":512,\"height\":512},\"image\":\"https://pyngyn.ai/icon.png\",\"description\":\"PYNGYN gives every client a branded Client Space (a standalone portal for status, documents, and approvals), with Workspace, the firm's back office for projects, finances, and billable time, available on its own or bundled together.\",\"sameAs\":[\"https://x.com/Pyngyn_Official\",\"https://www.linkedin.com/company/pyngyn/\",\"https://www.reddit.com/user/Pyngyn_Official/\",\"https://www.facebook.com/profile.php?id=61584474731354\",\"https://www.youtube.com/@PyngynOfficial\",\"https://instagram.com/pyngyn_official\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"customer support\",\"email\":\"support@pyngyn.com\",\"url\":\"https://pyngyn.ai/support\",\"availableLanguage\":[\"English\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"sales@pyngyn.com\",\"url\":\"https://pyngyn.ai/demo\",\"availableLanguage\":[\"English\"]}]}</script><script type=\"application/ld+json\" id=\"ld-website\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://pyngyn.ai/#website\",\"url\":\"https://pyngyn.ai/\",\"name\":\"PYNGYN\",\"description\":\"The operating system for professional-services firms. Run your firm and every client engagement in one place.\",\"publisher\":{\"@id\":\"https://pyngyn.ai/#organization\"},\"inLanguage\":\"en\"}</script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-sans\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main\" class=\"sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white\">Skip to content</a><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://pyngyn.ai/clientspace#webpage\",\"url\":\"https://pyngyn.ai/clientspace\",\"name\":\"Client Space | PYNGYN, the standalone branded client portal for professional-services firms\",\"description\":\"Give every client a branded portal where they see status, documents, and approvals 24/7 instead of emailing you. $19 per client / month, standalone.\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"breadcrumb\":{\"@id\":\"https://pyngyn.ai/clientspace#breadcrumb\"},\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/clientspace#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://pyngyn.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Client Space\",\"item\":\"https://pyngyn.ai/clientspace\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://pyngyn.ai/clientspace#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is Client Space?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Client Space is a branded client portal for your firm, sold on its own. Each client gets their own secure, isolated space showing the status of their engagement, their documents, approvals, and invoices, so they stop emailing you for updates and start self-serving 24/7.\"}},{\"@type\":\"Question\",\"name\":\"How much does Client Space cost?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Client Space is $19 per client per month, standalone, you don't need to buy Workspace to use it. If your firm also wants Workspace (your internal back office, $9 per seat/month), you can bundle both for $24.99/month.\"}},{\"@type\":\"Question\",\"name\":\"Do my clients need to create an account or remember a password?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Clients join with a one-click magic link, no password to remember and no login friction. Login frustration is the number-one reason client portals go unused, so we removed it entirely.\"}},{\"@type\":\"Question\",\"name\":\"Can clients see my other clients, or my internal work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Never. Each Client Space is fully isolated. A client sees only their own engagement, never another client's work, and never your internal operations. You control exactly what's visible.\"}},{\"@type\":\"Question\",\"name\":\"Is it secure enough for legal and financial documents?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Documents are encrypted in transit and at rest, access is controlled per client, and every action is logged in an audit trail, far safer than emailing sensitive records, which most firms still do.\"}},{\"@type\":\"Question\",\"name\":\"Can I brand it as my own firm?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Client Space is white-labeled with your logo, colors, and domain. To your clients, it looks and feels like your firm's own portal.\"}},{\"@type\":\"Question\",\"name\":\"What is Workspace, and do I need it?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Workspace is a separate product, your firm's internal back office for projects, finances, and billable time. You don't need it to use Client Space. Firms that want both can bundle Workspace and Client Space together for $24.99/month.\"}}]}]}</script><header class=\"fixed inset-x-0 top-0 z-[100] border-b transition-all duration-300 border-transparent bg-transparent\"><div class=\"wrap flex h-[68px] items-center justify-between\"><a class=\"flex items-center\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><div class=\"hidden h-full lg:flex lg:items-center\"><nav class=\"flex items-center gap-7 text-[15px] text-[#3a3a42]\"><a class=\"py-2 transition-colors hover:text-accent\" href=\"/clientspace/\">Clientspace</a><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Product<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Solutions<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Resources<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Compare<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></nav></div><div class=\"flex items-center gap-3\"><a href=\"https://app.pyngyn.ai/\" class=\"hidden text-[15px] font-semibold lg:inline \">Sign in</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"hidden px-4 py-2.5 lg:inline-flex btn btn-ghost\">Start free</a><a href=\"/demo\" class=\"hidden px-[18px] py-2.5 lg:inline-flex btn btn-primary\">Book a demo</a><button type=\"button\" class=\"grid h-10 w-10 place-items-center rounded-lg border lg:hidden border-line bg-white text-ink\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"mobile-menu\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"></path></svg></button></div></div></header><main id=\"main\"><section class=\"wrap pb-[56px] pt-[140px]\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>Client Space · the standalone client portal</span><h1 class=\"mt-4 max-w-[900px] font-display text-[clamp(34px,5.4vw,62px)] font-semibold leading-[1.03] tracking-[-0.027em]\">Your clients stop emailing.<br class=\"hidden sm:block\"/><span class=\"text-accent\">They just open their portal.</span></h1><p class=\"lead mt-5 max-w-[660px]\">Client Space gives every client a branded, secure portal where they see their status, documents, approvals, and invoices, 24/7. No more “did you get my email?”, no more being the bottleneck between your client and their own information.</p><div class=\"mt-8 flex flex-wrap gap-3\"><a href=\"/demo\" class=\"btn btn-accent\">Book a demo</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-primary\">Start free trial</a></div><p class=\"mt-4 text-[13px] text-muted\">From <strong class=\"text-ink\">$19 per client / month</strong> · standalone, no Workspace required · clients join with one click</p></section><section class=\"wrap pb-[72px]\"><div class=\"mx-auto max-w-[900px] overflow-hidden rounded-[22px] border border-line bg-white shadow-art\"><img alt=\"Client Space portal showing needs-your-attention items, active engagements, engagement value, and upcoming sessions for a client logging in\" width=\"1909\" height=\"940\" decoding=\"async\" data-nimg=\"1\" class=\"h-auto w-full\" style=\"color:transparent\" src=\"/screens/clientspace-space.webp\"/></div><p class=\"mt-3 text-center text-[13px] text-muted\">What your client sees when they log in, branded as your firm, updated automatically.</p></section><section class=\"section bg-[#fbfbfd]\"><div class=\"wrap\"><span class=\"eyebrow\">The problem</span><h2 class=\"mt-3 max-w-[720px] font-display text-[clamp(26px,3.4vw,42px)] font-semibold leading-tight tracking-[-0.025em]\">Your clients are in the dark, and it&#x27;s costing you.</h2><p class=\"lead mt-4 max-w-[620px]\">Most firms still run client communication through email. Clients can&#x27;t see anything without asking, so they ask constantly, and the work waits while you answer.</p><div class=\"mt-10 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-4\"><div class=\"card h-full\"><div class=\"font-display text-[20px] font-semibold leading-tight text-accent\">“Did you get my email?”</div><h3 class=\"mt-3 text-[15.5px] font-bold leading-snug\">Clients chase you for updates</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Every status request is an email, a call, or a text. You become the bottleneck between your client and their own information, and the work stops while you answer.</p></div><div class=\"card h-full\"><div class=\"font-display text-[20px] font-semibold leading-tight text-accent\">90%</div><h3 class=\"mt-3 text-[15.5px] font-bold leading-snug\">Email creates more work, not less</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Email threads generate far more back-and-forth than a portal, leave no audit trail, and bury the one document everyone needs under twenty replies.</p></div><div class=\"card h-full\"><div class=\"font-display text-[20px] font-semibold leading-tight text-accent\">Forgotten</div><h3 class=\"mt-3 text-[15.5px] font-bold leading-snug\">Clients leave because they feel ignored</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Clients rarely leave over the quality of your work. They leave because they feel forgotten between conversations, never sure what is happening or what comes next.</p></div><div class=\"card h-full\"><div class=\"font-display text-[20px] font-semibold leading-tight text-accent\">Risk</div><h3 class=\"mt-3 text-[15.5px] font-bold leading-snug\">Sensitive documents sent over email</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Financial records, legal documents, and signed agreements move through unsecured inboxes, no encryption, no access control, and no record of who saw what.</p></div></div><div class=\"mt-6 flex items-center justify-center gap-2 text-[14px]\"><span class=\"text-muted\">Curious what this actually costs your firm?</span><a class=\"font-semibold text-accent hover:text-accent-dk\" href=\"/tools/any-update-cost/\">Calculate it, free →</a></div></div></section><section class=\"section\"><div class=\"wrap\"><span class=\"eyebrow\">What clients get</span><h2 class=\"mt-3 max-w-[760px] font-display text-[clamp(26px,3.4vw,42px)] font-semibold leading-tight tracking-[-0.025em]\">A portal clients actually want to open.</h2><p class=\"lead mt-4 max-w-[640px]\">Everything a client needs to feel informed and in control, branded as your firm, secure by default, and effortless to use.</p><div class=\"mt-10 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-4\"><div class=\"card h-full\"><span class=\"text-[26px]\" aria-hidden=\"true\">🏷️</span><h3 class=\"mt-3 text-[15.5px] font-bold leading-snug\">Branded as your firm</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">White-labeled with your logo, colors, and domain. Clients land in a space that looks like yours, not like a generic tool you bolted on.</p></div><div class=\"card h-full\"><span class=\"text-[26px]\" aria-hidden=\"true\">📊</span><h3 class=\"mt-3 text-[15.5px] font-bold leading-snug\">Live status, 24/7</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Clients see exactly where their engagement stands (current phase, what&#x27;s done, what&#x27;s next, and key dates), without emailing anyone.</p></div><div class=\"card h-full\"><span class=\"text-[26px]\" aria-hidden=\"true\">🔒</span><h3 class=\"mt-3 text-[15.5px] font-bold leading-snug\">One isolated space per client</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Each client sees only their own engagement. Nothing leaks between clients. Bank-grade encryption and access control on every document.</p></div><div class=\"card h-full\"><span class=\"text-[26px]\" aria-hidden=\"true\">📎</span><h3 class=\"mt-3 text-[15.5px] font-bold leading-snug\">Secure documents &amp; e-signature</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Share, request, and sign documents inside the portal. Version-controlled, with a full audit trail, no more attachments lost in email.</p></div><div class=\"card h-full\"><span class=\"text-[26px]\" aria-hidden=\"true\">✅</span><h3 class=\"mt-3 text-[15.5px] font-bold leading-snug\">Approvals &amp; sign-off</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Clients review deliverables and approve them in the portal. Every decision is logged, so there&#x27;s never a &#x27;who approved what, when&#x27; dispute.</p></div><div class=\"card h-full\"><span class=\"text-[26px]\" aria-hidden=\"true\">🔗</span><h3 class=\"mt-3 text-[15.5px] font-bold leading-snug\">One-click, password-less access</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Clients join with a magic link, no password to remember, no login friction, no support tickets. The biggest reason portals fail, solved.</p></div><div class=\"card h-full\"><span class=\"text-[26px]\" aria-hidden=\"true\">💬</span><h3 class=\"mt-3 text-[15.5px] font-bold leading-snug\">Messaging in context</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Client questions and your answers live next to the work they&#x27;re about, not scattered across inboxes. Everyone sees the same thread.</p></div><div class=\"card h-full\"><span class=\"text-[26px]\" aria-hidden=\"true\">💳</span><h3 class=\"mt-3 text-[15.5px] font-bold leading-snug\">Invoices &amp; online payment</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Clients view invoices and pay inside the portal. Faster cash flow, fewer billing disputes, and no chasing.</p></div></div></div></section><section class=\"section bg-[#fbfbfd]\"><div class=\"wrap\"><div class=\"grid items-center gap-10 lg:grid-cols-2\"><div><span class=\"eyebrow\">Your side of the portal</span><h2 class=\"mt-3 font-display text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em]\">You see every engagement across every client, in one dashboard.</h2><p class=\"lead mt-4 max-w-[480px]\">While each client sees only their own Client Space, your team gets a portfolio view, realisation, engagement health, and the approvals only you can make, across every client at once.</p></div><div class=\"overflow-hidden rounded-[18px] border border-line bg-white shadow-art\"><img alt=\"Client Space director dashboard showing portfolio-wide revenue, realisation percentage, active engagements, CSAT, and engagement health across all clients\" loading=\"lazy\" width=\"1906\" height=\"949\" decoding=\"async\" data-nimg=\"1\" class=\"h-auto w-full\" style=\"color:transparent\" src=\"/screens/clientspace-director.webp\"/></div></div></div></section><section class=\"section bg-[#fbfbfd]\"><div class=\"wrap\"><span class=\"eyebrow\">How it works</span><h2 class=\"mt-3 max-w-[680px] font-display text-[clamp(26px,3.4vw,40px)] font-semibold leading-tight tracking-[-0.025em]\">Live for a client in minutes.</h2><div class=\"mt-10 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-4\"><div class=\"card h-full\"><div class=\"index-num\">01</div><h3 class=\"mt-3 text-[16px] font-bold\">Create the Client Space</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Spin up a branded portal for a client in a couple of clicks. Your logo, your colors, your domain.</p></div><div class=\"card h-full\"><div class=\"index-num\">02</div><h3 class=\"mt-3 text-[16px] font-bold\">Invite the client</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Send a magic link. They click once and they&#x27;re in, no password, no setup on their end.</p></div><div class=\"card h-full\"><div class=\"index-num\">03</div><h3 class=\"mt-3 text-[16px] font-bold\">They self-serve</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">Status, documents, approvals, and invoices are all there, 24/7. The &#x27;any update?&#x27; emails stop.</p></div><div class=\"card h-full\"><div class=\"index-num\">04</div><h3 class=\"mt-3 text-[16px] font-bold\">You stay in control</h3><p class=\"mt-2 text-[13.5px] leading-relaxed text-muted\">You decide exactly what each client sees. Internal work stays internal; clients see only their own engagement.</p></div></div></div></section><section class=\"section\"><div class=\"wrap\"><div class=\"rounded-[24px] border border-line bg-white p-8 shadow-card sm:p-10\"><div class=\"grid items-center gap-8 lg:grid-cols-[1.1fr_1fr]\"><div><span class=\"eyebrow\">Works standalone. Better together.</span><h2 class=\"mt-3 font-display text-[clamp(22px,3vw,32px)] font-semibold leading-tight tracking-[-0.02em]\">Client Space runs on its own.<br/>Add Workspace when you want the back office too.</h2><p class=\"mt-4 text-[15px] leading-relaxed text-muted\">Client Space is a complete, standalone product, you don&#x27;t need anything else to give clients a branded portal. If your firm also wants to run projects, finances, and billable time internally, Workspace is a separate product you can add, and the two bundle together for less than buying them apart.</p><div class=\"mt-6 flex flex-wrap gap-3\"><a class=\"btn btn-primary\" href=\"/workspace/\">Explore Workspace</a><a class=\"btn btn-ghost\" href=\"/pricing/\">See pricing</a></div></div><div class=\"rounded-[18px] border border-line bg-[#fbfbfd] p-6\"><div class=\"text-[12px] font-semibold uppercase tracking-wide text-muted\">The stack</div><div class=\"mt-4 space-y-3\"><div class=\"rounded-xl border border-accent/40 bg-white p-4\"><div class=\"flex items-center justify-between\"><span class=\"font-bold text-accent\">Client Space</span><span class=\"text-[13px] text-muted\">$19 / client · standalone</span></div><p class=\"mt-1 text-[12.5px] text-muted\">The branded portal your clients log into. Works on its own.</p></div><div class=\"flex justify-center text-muted\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 5v14M6 13l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></div><div class=\"rounded-xl border border-line bg-white p-4\"><div class=\"flex items-center justify-between\"><span class=\"font-bold\">Workspace</span><span class=\"text-[13px] text-muted\">$9 / seat · optional</span></div><p class=\"mt-1 text-[12.5px] text-muted\">Your firm&#x27;s optional back office. Bundle both for $24.99/mo.</p></div></div></div></div></div></div></section><section class=\"section bg-[#fbfbfd]\"><div class=\"wrap\"><span class=\"eyebrow\">Built for your firm</span><h2 class=\"mt-3 font-display text-[clamp(24px,3vw,34px)] font-semibold tracking-[-0.02em]\">A client portal that fits your practice.</h2><div class=\"mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5\"><a class=\"card group flex h-full flex-col transition-all hover:border-accent hover:shadow-soft\" href=\"/solutions/lawyers/\"><div class=\"font-semibold text-ink group-hover:text-accent transition-colors\">Law firms</div><p class=\"mt-1.5 flex-1 text-[13px] leading-relaxed text-muted\">Matter status, documents, and sign-off, without the phone tag.</p><span class=\"mt-3 text-[12.5px] font-semibold text-accent\">See how →</span></a><a class=\"card group flex h-full flex-col transition-all hover:border-accent hover:shadow-soft\" href=\"/solutions/accountants/\"><div class=\"font-semibold text-ink group-hover:text-accent transition-colors\">Accountants &amp; CAs</div><p class=\"mt-1.5 flex-1 text-[13px] leading-relaxed text-muted\">Secure document collection and approvals that beat unsecured email.</p><span class=\"mt-3 text-[12.5px] font-semibold text-accent\">See how →</span></a><a class=\"card group flex h-full flex-col transition-all hover:border-accent hover:shadow-soft\" href=\"/solutions/consultants/\"><div class=\"font-semibold text-ink group-hover:text-accent transition-colors\">Marketing consultants</div><p class=\"mt-1.5 flex-1 text-[13px] leading-relaxed text-muted\">Campaign status and approval rounds clients can actually follow.</p><span class=\"mt-3 text-[12.5px] font-semibold text-accent\">See how →</span></a><a class=\"card group flex h-full flex-col transition-all hover:border-accent hover:shadow-soft\" href=\"/solutions/creative-services/\"><div class=\"font-semibold text-ink group-hover:text-accent transition-colors\">Creative studios</div><p class=\"mt-1.5 flex-1 text-[13px] leading-relaxed text-muted\">Briefs, revisions, and sign-off with a versioned record.</p><span class=\"mt-3 text-[12.5px] font-semibold text-accent\">See how →</span></a><a class=\"card group flex h-full flex-col transition-all hover:border-accent hover:shadow-soft\" href=\"/solutions/architects/\"><div class=\"font-semibold text-ink group-hover:text-accent transition-colors\">Architects</div><p class=\"mt-1.5 flex-1 text-[13px] leading-relaxed text-muted\">Design phase status, drawings, and phase-gate approvals.</p><span class=\"mt-3 text-[12.5px] font-semibold text-accent\">See how →</span></a></div></div></section><section class=\"section\"><div class=\"wrap\"><div class=\"text-center\"><span class=\"eyebrow\">From discovery calls</span><h2 class=\"mt-3 font-display text-[clamp(24px,3vw,34px)] font-semibold tracking-[-0.02em]\">What firms tell us about client communication.</h2><p class=\"lead mx-auto mt-4 max-w-[640px]\">Anonymised observations from conversations with partners and client-services leads at services firms. Roles only, no names.</p></div><div class=\"mt-[46px] grid gap-[22px] md:grid-cols-3\"><figure class=\"card flex h-full flex-col\"><span class=\"font-mono text-[10.5px] font-semibold uppercase tracking-[0.14em] text-muted\">From a discovery call</span><blockquote class=\"mt-3 flex-1 text-[16.5px] leading-relaxed\">“<!-- -->Every Monday starts with the same five emails: any update on our filing? The answer exists, it just lives in our tracker, not anywhere the client can see.<!-- -->”</blockquote><figcaption class=\"mt-5 border-t border-line pt-3.5 text-[13.5px] text-muted\">Partner, CA firm</figcaption></figure><figure class=\"card flex h-full flex-col\"><span class=\"font-mono text-[10.5px] font-semibold uppercase tracking-[0.14em] text-muted\">From a discovery call</span><blockquote class=\"mt-3 flex-1 text-[16.5px] leading-relaxed\">“<!-- -->We look less organised than we are. The work is on track, but the client only ever sees silence between our fortnightly calls.<!-- -->”</blockquote><figcaption class=\"mt-5 border-t border-line pt-3.5 text-[13.5px] text-muted\">Client services lead, consulting firm</figcaption></figure><figure class=\"card flex h-full flex-col\"><span class=\"font-mono text-[10.5px] font-semibold uppercase tracking-[0.14em] text-muted\">From a discovery call</span><blockquote class=\"mt-3 flex-1 text-[16.5px] leading-relaxed\">“<!-- -->Sign-offs are our bottleneck. The engagement letter sits in someone&#x27;s inbox for a week, and nobody notices until the deadline is already at risk.<!-- -->”</blockquote><figcaption class=\"mt-5 border-t border-line pt-3.5 text-[13.5px] text-muted\">Practice manager, law firm</figcaption></figure></div></div></section><section class=\"section\"><div class=\"wrap\"><div class=\"rounded-[24px] border border-accent bg-accent/[0.04] p-8 text-center shadow-soft sm:p-12\"><span class=\"eyebrow\">Pricing</span><h2 class=\"mt-3 font-display text-[clamp(26px,3.4vw,40px)] font-semibold tracking-[-0.02em]\">$19 per client, standalone. That&#x27;s it.</h2><p class=\"lead mx-auto mt-4 max-w-[560px]\">No Workspace purchase required. Add Client Space for each client you bring in. Want Workspace too? Bundle both for $24.99/mo and save.</p><ul class=\"mx-auto mt-7 grid max-w-[640px] gap-2.5 text-left sm:grid-cols-2\"><li class=\"flex items-start gap-2.5 text-[14.5px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Branded, white-labeled portal</li><li class=\"flex items-start gap-2.5 text-[14.5px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Unlimited client guests per space</li><li class=\"flex items-start gap-2.5 text-[14.5px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Secure documents &amp; e-signature</li><li class=\"flex items-start gap-2.5 text-[14.5px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Approvals with full audit trail</li><li class=\"flex items-start gap-2.5 text-[14.5px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>One-click magic-link access</li><li class=\"flex items-start gap-2.5 text-[14.5px]\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mt-0.5 flex-none text-positive\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Invoices &amp; online payments</li></ul><div class=\"mt-8 flex flex-wrap justify-center gap-3\"><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-accent\">Start free trial</a><a href=\"/demo\" class=\"btn btn-primary\">Book a demo</a></div></div></div></section><section class=\"section bg-[#fbfbfd]\"><div class=\"wrap\"><span class=\"eyebrow\">FAQ</span><h2 class=\"mt-3 font-display text-[clamp(24px,3vw,32px)] font-semibold tracking-[-0.01em]\">Questions about Client Space.</h2><div class=\"mt-7 grid gap-[18px] md:grid-cols-2\"><div class=\"card h-full\"><h3 class=\"text-[16.5px] font-bold leading-snug\">What is Client Space?</h3><p class=\"mt-2.5 text-[14.5px] leading-relaxed text-muted\">Client Space is a branded client portal for your firm, sold on its own. Each client gets their own secure, isolated space showing the status of their engagement, their documents, approvals, and invoices, so they stop emailing you for updates and start self-serving 24/7.</p></div><div class=\"card h-full\"><h3 class=\"text-[16.5px] font-bold leading-snug\">How much does Client Space cost?</h3><p class=\"mt-2.5 text-[14.5px] leading-relaxed text-muted\">Client Space is $19 per client per month, standalone, you don&#x27;t need to buy Workspace to use it. If your firm also wants Workspace (your internal back office, $9 per seat/month), you can bundle both for $24.99/month.</p></div><div class=\"card h-full\"><h3 class=\"text-[16.5px] font-bold leading-snug\">Do my clients need to create an account or remember a password?</h3><p class=\"mt-2.5 text-[14.5px] leading-relaxed text-muted\">No. Clients join with a one-click magic link, no password to remember and no login friction. Login frustration is the number-one reason client portals go unused, so we removed it entirely.</p></div><div class=\"card h-full\"><h3 class=\"text-[16.5px] font-bold leading-snug\">Can clients see my other clients, or my internal work?</h3><p class=\"mt-2.5 text-[14.5px] leading-relaxed text-muted\">Never. Each Client Space is fully isolated. A client sees only their own engagement, never another client&#x27;s work, and never your internal operations. You control exactly what&#x27;s visible.</p></div><div class=\"card h-full\"><h3 class=\"text-[16.5px] font-bold leading-snug\">Is it secure enough for legal and financial documents?</h3><p class=\"mt-2.5 text-[14.5px] leading-relaxed text-muted\">Yes. Documents are encrypted in transit and at rest, access is controlled per client, and every action is logged in an audit trail, far safer than emailing sensitive records, which most firms still do.</p></div><div class=\"card h-full\"><h3 class=\"text-[16.5px] font-bold leading-snug\">Can I brand it as my own firm?</h3><p class=\"mt-2.5 text-[14.5px] leading-relaxed text-muted\">Yes. Client Space is white-labeled with your logo, colors, and domain. To your clients, it looks and feels like your firm&#x27;s own portal.</p></div><div class=\"card h-full\"><h3 class=\"text-[16.5px] font-bold leading-snug\">What is Workspace, and do I need it?</h3><p class=\"mt-2.5 text-[14.5px] leading-relaxed text-muted\">Workspace is a separate product, your firm&#x27;s internal back office for projects, finances, and billable time. You don&#x27;t need it to use Client Space. Firms that want both can bundle Workspace and Client Space together for $24.99/month.</p></div></div></div></section><section id=\"demo\" class=\"section\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"relative overflow-hidden rounded-[28px] border border-line bg-white px-7 py-[72px] text-center shadow-card\"><div class=\"pointer-events-none absolute -top-24 left-1/2 h-[420px] w-[420px] -translate-x-1/2 rounded-full bg-accent-lt opacity-70 blur-[80px]\" aria-hidden=\"true\"></div><span class=\"eyebrow relative\">Ready when you are</span><h2 class=\"title relative mx-auto mt-3.5 max-w-[680px] text-[clamp(30px,4.4vw,48px)]\">Give every client their own portal, not another email thread.</h2><p class=\"lead relative mx-auto mt-[18px]\">See Client Space set up on a real engagement in 30 minutes, branded portal, magic-link invite, live status from day one.</p><div class=\"relative mt-[30px] flex flex-wrap items-center justify-center gap-3.5\"><a href=\"/demo\" class=\"btn btn-primary\">Book a demo →</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-ghost\">Start free trial</a></div><p class=\"relative mt-4 text-sm text-muted\">30-minute walkthrough · Set up in minutes · No commitment</p></div></div></div></section></main><footer class=\"border-t border-line bg-white pt-16 pb-10 text-sm text-muted\"><div class=\"wrap\"><div class=\"grid gap-10 lg:grid-cols-[1.4fr_repeat(5,1fr)]\"><div><a class=\"mb-4 inline-block\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" loading=\"lazy\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><p class=\"max-w-[230px] leading-relaxed\">The operating system for professional-services firms.</p><a href=\"https://play.google.com/store/apps/details?id=com.pyngyn.io&amp;hl=en_IN\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"mt-5 inline-flex items-center gap-2.5 rounded-xl border border-line bg-white px-4 py-2.5 transition-colors hover:border-accent\" aria-label=\"Get PYNGYN on Google Play\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3.6 2.3 13 12 3.6 21.7a1.4 1.4 0 0 1-.6-1.2V3.5c0-.5.2-.9.6-1.2z\" fill=\"#34a853\"></path><path d=\"M16.8 8.6 13 12 3.6 2.3c.4-.3.9-.3 1.4 0l8.8 5z\" fill=\"#ea4335\"></path><path d=\"M16.8 15.4 5 22c-.5.3-1 .3-1.4 0L13 12z\" fill=\"#fbbc04\"></path><path d=\"m16.8 8.6 4 2.3c.7.4.7 1.4 0 1.8l-4 2.7L13 12z\" fill=\"#4285f4\"></path></svg><span class=\"flex flex-col leading-tight\"><span class=\"text-[10px] uppercase tracking-wide text-muted\">Get it on</span><span class=\"text-[14px] font-bold text-ink\">Google Play</span></span></a></div><div class=\"flex flex-col gap-8\"><div><h4 class=\"mb-3 text-[14px] font-bold text-ink\">Product</h4><div class=\"flex flex-col\"><a class=\"block py-1.5 hover:text-accent\