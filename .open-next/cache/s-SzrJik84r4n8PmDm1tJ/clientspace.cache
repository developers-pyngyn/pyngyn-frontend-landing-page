\\\"div\\\",null,{\\\"className\\\":\\\"mt-7 grid gap-[18px] md:grid-cols-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"What is Client Space?\\\",{\\\"className\\\":\\\"card h-full\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-[16.5px] font-bold leading-snug\\\",\\\"children\\\":\\\"What is Client Space?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2.5 text-[14.5px] leading-relaxed text-muted\\\",\\\"children\\\":\\\"Client Space is a branded client portal for your firm, sold on its own. Each client gets their own secure, isolated space showing the status of their engagement, their documents, approvals, and invoices, so they stop emailing you for updates and start self-serving 24/7.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"How much does Client Space cost?\\\",{\\\"className\\\":\\\"card h-full\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-[16.5px] font-bold leading-snug\\\",\\\"children\\\":\\\"How much does Client Space cost?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2.5 text-[14.5px] leading-relaxed text-muted\\\",\\\"children\\\":\\\"Client Space is $19 per client per month, standalone, you don't need to buy Workspace to use it. If your firm also wants Workspace (your internal back office, $9 per seat/month), you can bundle both for $24.99/month.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"Do my clients need to create an account or remember a password?\\\",{\\\"className\\\":\\\"card h-full\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-[16.5px] font-bold leading-snug\\\",\\\"children\\\":\\\"Do my clients need to create an account or remember a password?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2.5 text-[14.5px] leading-relaxed text-muted\\\",\\\"children\\\":\\\"No. Clients join with a one-click magic link, no password to remember and no login friction. Login frustration is the number-one reason client portals go unused, so we removed it entirely.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"Can clients see my other clients, or my internal work?\\\",{\\\"className\\\":\\\"card h-full\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-[16.5px] font-bold leading-snug\\\",\\\"children\\\":\\\"Can clients see my other clients, or my internal work?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2.5 text-[14.5px] leading-relaxed text-muted\\\",\\\"children\\\":\\\"Never. Each Client Space is fully isolated. A client sees only their own engagement, never another client's work, and never your internal operations. You control exactly what's visible.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"Is it secure enough for legal and financial documents?\\\",{\\\"className\\\":\\\"card h-full\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-[16.5px] font-bold leading-snug\\\",\\\"children\\\":\\\"Is it secure enough for legal and financial documents?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2.5 text-[14.5px] leading-relaxed text-muted\\\",\\\"children\\\":\\\"Yes. Documents are encrypted in transit and at rest, access is controlled per client, and every action is logged in an audit trail, far safer than emailing sensitive records, which most firms still do.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"Can I brand it as my own firm?\\\",{\\\"className\\\":\\\"card h-full\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-[16.5px] font-bold leading-snug\\\",\\\"children\\\":\\\"Can I brand it as my own firm?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2.5 text-[14.5px] leading-relaxed text-muted\\\",\\\"children\\\":\\\"Yes. Client Space is white-labeled with your logo, colors, and domain. To your clients, it looks and feels like your firm's own portal.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"What is Workspace, and do I need it?\\\",{\\\"className\\\":\\\"card h-full\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-[16.5px] font-bold leading-snug\\\",\\\"children\\\":\\\"What is Workspace, and do I need it?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2.5 text-[14.5px] leading-relaxed text-muted\\\",\\\"children\\\":\\\"Workspace is a separate product, your firm's internal back office for projects, finances, and billable time. You don't need it to use Client Space. Firms that want both can bundle Workspace and Client Space together for $24.99/month.\\\"}]]}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"29:[\\\"$\\\",\\\"$L2f\\\",null,{\\\"headline\\\":\\\"Give every client their own portal, not another email thread.\\\",\\\"body\\\":\\\"See Client Space set up on a real engagement in 30 minutes, branded portal, magic-link invite, live status from day one.\\\",\\\"secondaryLabel\\\":\\\"Start free trial\\\",\\\"note\\\":\\\"30-minute walkthrough · Set up in minutes · No commitment\\\"}]\\n2e:[\\\"$\\\",\\\"div\\\",\\\"Invoices \\u0026 online payment\\\",{\\\"className\\\":\\\"card h-full\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-[26px]\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":\\\"💳\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"mt-3 text-[15.5px] font-bold leading-snug\\\",\\\"children\\\":\\\"Invoices \\u0026 online payment\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 text-[13.5px] leading-relaxed text-muted\\\",\\\"children\\\":\\\"Clients view invoices and pay inside the portal. Faster cash flow, fewer billing disputes, and no chasing.\\\"}]]}]\\n18:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\n1b:[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"Client Space | PYNGYN, the standalone branded client portal for professional-services firms\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"descript