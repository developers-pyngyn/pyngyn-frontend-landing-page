 firms.\"/><meta property=\"og:url\" content=\"https://pyngyn.ai/\"/><meta property=\"og:site_name\" content=\"PYNGYN\"/><meta property=\"og:image\" content=\"https://pyngyn.ai/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"PYNGYN: Clientspace, a standalone branded client portal, and Workspace, a standalone back office for professional-services firms\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:site\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:creator\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:title\" content=\"PYNGYN: The operating system for professional-services firms\"/><meta name=\"twitter:description\" content=\"Run your firm and every client engagement in one place. The operating system for professional-services firms.\"/><meta name=\"twitter:image\" content=\"https://pyngyn.ai/og.png\"/><link rel=\"icon\" href=\"/icon.png\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png\"/><script type=\"application/ld+json\" id=\"ld-organization\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://pyngyn.ai/#organization\",\"name\":\"PYNGYN\",\"legalName\":\"VIMOVI GlobalTech Private Limited\",\"url\":\"https://pyngyn.ai/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://pyngyn.ai/logo.png\",\"width\":512,\"height\":512},\"image\":\"https://pyngyn.ai/icon.png\",\"description\":\"PYNGYN gives every client a branded Client Space (a standalone portal for status, documents, and approvals), with Workspace, the firm's back office for projects, finances, and billable time, available on its own or bundled together.\",\"sameAs\":[\"https://x.com/Pyngyn_Official\",\"https://www.linkedin.com/company/pyngyn/\",\"https://www.reddit.com/user/Pyngyn_Official/\",\"https://www.facebook.com/profile.php?id=61584474731354\",\"https://www.youtube.com/@PyngynOfficial\",\"https://instagram.com/pyngyn_official\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"customer support\",\"email\":\"support@pyngyn.com\",\"url\":\"https://pyngyn.ai/support\",\"availableLanguage\":[\"English\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"sales@pyngyn.com\",\"url\":\"https://pyngyn.ai/demo\",\"availableLanguage\":[\"English\"]}]}</script><script type=\"application/ld+json\" id=\"ld-website\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://pyngyn.ai/#website\",\"url\":\"https://pyngyn.ai/\",\"name\":\"PYNGYN\",\"description\":\"The operating system for professional-services firms. Run your firm and every client engagement in one place.\",\"publisher\":{\"@id\":\"https://pyngyn.ai/#organization\"},\"inLanguage\":\"en\"}</script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-sans\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main\" class=\"sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white\">Skip to content</a><header class=\"fixed inset-x-0 top-0 z-[100] border-b transition-all duration-300 border-transparent bg-transparent\"><div class=\"wrap flex h-[68px] items-center justify-between\"><a class=\"flex items-center\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><div class=\"hidden h-full lg:flex lg:items-center\"><nav class=\"flex items-center gap-7 text-[15px] text-[#3a3a42]\"><a class=\"py-2 transition-colors hover:text-accent\" href=\"/clientspace/\">Clientspace</a><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Product<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Solutions<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Resources<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Compare<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></nav></div><div class=\"flex items-center gap-3\"><a href=\"https://app.pyngyn.ai/\" class=\"hidden text-[15px] font-semibold lg:inline \">Sign in</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"hidden px-4 py-2.5 lg:inline-flex btn btn-ghost\">Start free</a><a href=\"/demo\" class=\"hidden px-[18px] py-2.5 lg:inline-flex btn btn-primary\">Book a demo</a><button type=\"button\" class=\"grid h-10 w-10 place-items-center rounded-lg border lg:hidden border-line bg-white text-ink\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"mobile-menu\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"></path></svg></button></div></div></header><main id=\"main\"><section class=\"relative overflow-hidden\"><div class=\"hero-grid pointer-events-none absolute inset-0 opacity-50\" aria-hidden=\"true\"></div><div class=\"pointer-events-none absolute -right-24 -top-24 h-[420px] w-[420px] rounded-full bg-accent/10 blur-3xl\" aria-hidden=\"true\"></div><div class=\"relative mx-auto w-full max-w-content px-5 pb-12 pt-[140px] sm:px-7 sm:pb-16 sm:pt-[160px]\"><div class=\"grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-16\"><div><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>Refer &amp; earn</span><h1 class=\"mt-4 max-w-[680px] font-display text-[clamp(36px,5.8vw,60px)] font-semibold leading-[1.02] tracking-[-0.035em]\">Share PYNGYN.<!-- --> <span class=\"bg-gradient-to-r from-accent to-accent-dk bg-clip-text text-transparent\">Everyone wins.</span></h1><p class=\"mt-5 max-w-[520px] text-[18px] leading-relaxed text-muted\">Refer a firm to PYNGYN and earn <strong class=\"text-ink\">20%</strong> of their annual plan. The firm you refer gets <strong class=\"text-ink\">20% off</strong> their first year. No cap, no catch.</p><div class=\"mt-8 grid gap-3 sm:grid-cols-2\"><div class=\"rounded-2xl border border-line bg-white p-5 shadow-card\"><div class=\"font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-muted\">You earn</div><div class=\"mt-1 font-display text-[36px] font-semibold leading-none tracking-[-0.03em] text-accent\">20%</div><p class=\"mt-2 text-[14px] leading-snug text-muted\">of every annual plan you refer, paid monthly.</p></div><div class=\"rounded-2xl border border-line bg-white p-5 shadow-card\"><div class=\"font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-muted\">They save</div><div class=\"mt-1 font-display text-[36px] font-semibold leading-none tracking-[-0.03em] text-accent\">20%</div><p class=\"mt-2 text-[14px] leading-snug text-muted\">off their first year on any annual plan.</p></div></div><div class=\"mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-[13.5px] font-medium text-muted\"><span class=\"flex items-center gap-1.5\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"text-accent\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg> No cap on earnings</span><span class=\"flex items-center gap-1.5\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"text-accent\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg> 90-day attribution</span><span class=\"flex items-center gap-1.5\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"text-accent\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg> Monthly payouts</span></div></div><div><div class=\"rounded-[20px] border border-line bg-white p-6 shadow-card sm:p-8\"><h3 class=\"font-display text-[22px] font-semibold tracking-[-0.015em]\">Get your referral link</h3><p class=\"mt-2 text-[15px] leading-relaxed text-muted\">Enter your email and we&#x27;ll create your unique link. Share it anywhere, you earn when a friend subscribes.</p><div class=\"mt-5 flex flex-col gap-2.5 sm:flex-row\"><input type=\"email\" placeholder=\"you@yourfirm.com\" aria-label=\"Your email\" class=\"w-full rounded-full border border-line bg-white px-5 py-3.5 text-[15px] outline-none focus-visible:border-accent\" value=\"\"/><button type=\"button\" class=\"flex-none rounded-full bg-accent px-6 py-3.5 text-[15px] font-semibold text-white shadow-cta transition-transform hover:-translate-y-0.5 hover:bg-accent-dk\">Get my link</button></div><p class=\"mt-3 text-[12.5px] text-muted\">No cost to join. Earn on every paid referral.</p></div></div></div></div></section><section class=\"mx-auto w-full max-w-content px-5 pb-12 pt-6 sm:px-7 sm:pb-16\"><div class=\"mb-2 flex items-end justify-between gap-6\"><h2 class=\"font-display text-[clamp(26px,3.6vw,38px)] font-semibold tracking-[-0.025em]\">How it works.</h2><span class=\"hidden font-mono text-[11.5px] font-semibold uppercase tracking-[0.14em] text-muted sm:block\">4 steps · 30 seconds</span></div><div class=\"mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-4\"><div class=\"rounded-2xl border border-line bg-white p-7 shadow-card\"><div class=\"font-mono text-[14px] font-semibold text-accent\">01</div><h3 class=\"mt-3 font-display text-[18px] font-semibold tracking-[-0.015em]\">Join in 30 seconds</h3><p class=\"mt-2 text-[14.5px] leading-relaxed text-muted\">Drop your email and we&#x27;ll generate your unique referral link. No application, no minimums.</p></div><div class=\"rounded-2xl border border-line bg-white p-7 shadow-card\"><div class=\"font-mono text-[14px] font-semibold text-accent\">02</div><h3 class=\"mt-3 font-display text-[18px] font-semibold tracking-[-0.015em]\">Share with your network</h3><p class=\"mt-2 text-[14.5px] leading-relaxed text-muted\">Send your link to peers, post it on LinkedIn, or include it in your newsletter.</p></div><div class=\"rounded-2xl border border-line bg-white p-7 shadow-card\"><div class=\"font-mono text-[14px] font-semibold text-accent\">03</div><h3 class=\"mt-3 font-display text-[18px] font-semibold tracking-[-0.015em]\">They get 20% off</h3><p class=\"mt-2 text-[14.5px] leading-relaxed text-muted\">Anyone who buys an annual plan through your link gets 20% off their first year, automatically.</p></div><div class=\"rounded-2xl border border-line bg-white p-7 shadow-card\"><div class=\"font-mono text-[14px] font-semibold text-accent\">04</div><h3 class=\"mt-3 font-display text-[18px] font-semibold tracking-[-0.015em]\">You earn 20%</h3><p class=\"mt-2 text-[14.5px] leading-relaxed text-muted\">You earn 20% of every referred annual plan, paid out monthly once they&#x27;re billed.</p></div></div></section><section class=\"mx-auto w-full max-w-content px-5 pb-12 sm:px-7 sm:pb-16\"><div class=\"overflow-hidden rounded-[28px] border border-line bg-white shadow-card\"><div class=\"grid lg:grid-cols-2\"><div class=\"p-8 sm:p-10 \"><div class=\"font-mono text-[11.5px] font-semibold uppercase tracking-[0.14em] text-muted\">For you</div><div class=\"mt-2 flex items-baseline gap-3\"><h3 class=\"font-display text-[22px] font-semibold tracking-[-0.015em]\">What you earn</h3><span class=\"font-display text-[28px] font-semibold tracking-[-0.02em] text-accent\">20%</span></div><dl class=\"mt-6 divide-y divide-line\"><div class=\"grid grid-cols-[140px_1fr] gap-4 py-3 text-[14.5px]\"><dt class=\"text-muted\">Commission</dt><dd class=\"font-medium text-ink\">20% of first-year annual subscription</dd></div><div class=\"grid grid-cols-[140px_1fr] gap-4 py-3 text-[14.5px]\"><dt class=\"text-muted\">Cap</dt><dd class=\"font-medium text-ink\">No cap on referrals or earnings</dd></div><div class=\"grid grid-cols-[140px_1fr] gap-4 py-3 text-[14.5px]\"><dt class=\"text-muted\">Attribution</dt><dd class=\"font-medium text-ink\">90 days from first click</dd></div><div class=\"grid grid-cols-[140px_1fr] gap-4 py-3 text-[14.5px]\"><dt class=\"text-muted\">Payout</dt><dd class=\"font-medium text-ink\">Monthly, bank transfer or PayPal</dd></div><div class=\"grid grid-cols-[140px_1fr] gap-4 py-3 text-[14.5px]\"><dt class=\"text-muted\">Eligibility</dt><dd class=\"font-medium text-ink\">Open to anyone, free to join</dd></div></dl></div><div class=\"border-t border-line lg:border-l lg:border-t-0\"><div class=\"p-8 sm:p-10 lg:bg-[#fbfbfd]\"><div class=\"font-mono text-[11.5px] font-semibold uppercase tracking-[0.14em] text-muted\">For your friend</div><div class=\"mt-2 flex items-baseline gap-3\"><h3 class=\"font-display text-[22px] font-semibold tracking-[-0.015em]\">What your friend gets</h3><span class=\"font-display text-[28px] font-semibold tracking-[-0.02em] text-accent\">20% off</span></div><dl class=\"mt-6 divide-y divide-line\"><div class=\"grid grid-cols-[140px_1fr] gap-4 py-3 text-[14.5px]\"><dt class=\"text-muted\">Discount</dt><dd class=\"font-medium text-ink\">20% off first year on any annual plan</dd></div><div class=\"grid grid-cols-[140px_1fr] gap-4 py-3 text-[14.5px]\"><dt class=\"text-muted\">Applies to</dt><dd class=\"font-medium text-ink\">All paid tiers, billed annually</dd></div><div class=\"grid grid-cols-[140px_1fr] gap-4 py-3 text-[14.5px]\"><dt class=\"text-muted\">How it works</dt><dd class=\"font-medium text-ink\">Discount auto-applied at checkout</dd></div><div class=\"grid grid-cols-[140px_1fr] gap-4 py-3 text-[14.5px]\"><dt class=\"text-muted\">Combinable</dt><dd class=\"font-medium text-ink\">Cannot stack with other promos</dd></div><div class=\"grid grid-cols-[140px_1fr] gap-4 py-3 text-[14.5px]\"><dt class=\"text-muted\">After year 1</dt><dd class=\"font-medium text-ink\">Renews at standard list price</dd></div></dl></div></div></div></div><p class=\"mt-4 text-center text-[13px] text-muted\">See current pricing on the <a class=\"font-semibold text-accent hover:underline\" href=\"/pricing/\">pricing page</a>.</p></section><section class=\"mx-auto w-full max-w-content px-5 pb-12 sm:px-7 sm:pb-16\"><h2 class=\"font-display text-[clamp(26px,3.6vw,38px)] font-semibold tracking-[-0.025em]\">Who this is for.</h2><p class=\"mt-3 max-w-[560px] text-[16px] text-muted\">Anyone can join. The program works especially well for these folks.</p><div class=\"mt-8 grid gap-4 sm:grid-cols-2\"><div class=\"flex gap-4 rounded-2xl border border-line bg-white p-6 shadow-card\"><div class=\"grid h-11 w-11 flex-none place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M16 18v-2a4 4 0 00-8 0v2M12 11a3 3 0 100-6 3 3 0 000 6M21 18v-1.5a3.5 3.5 0 00-3-3.4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></div><div><h3 class=\"font-display text-[18px] font-semibold tracking-[-0.015em]\">Consultants &amp; advisors</h3><p class=\"mt-1.5 text-[14.5px] leading-relaxed text-muted\">Your clients trust your stack recommendations. Get rewarded for sharing what already works.</p></div></div><div class=\"flex gap-4 rounded-2xl border border-line bg-white p-6 shadow-card\"><div class=\"grid h-11 w-11 flex-none place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></div><div><h3 class=\"font-display text-[18px] font-semibold tracking-[-0.015em]\">Existing PYNGYN customers</h3><p class=\"mt-1.5 text-[14.5px] leading-relaxed text-muted\">If you love how PYNGYN runs your firm, your peers will too. Earn while spreading the word.</p></div></div><div class=\"flex gap-4 rounded-2xl border border-line bg-white p-6 shadow-card\"><div class=\"grid h-11 w-11 flex-none place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 10v4h3l5 4V6L6 10H3zM16 8a4 4 0 010 8M19 5a8 8 0 010 14\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></div><div><h3 class=\"font-display text-[18px] font-semibold tracking-[-0.015em]\">Newsletter authors &amp; creators</h3><p class=\"mt-1.5 text-[14.5px] leading-relaxed text-muted\">Tools you actually use are the most credible. Monetize honest recommendations.</p></div></div><div class=\"flex gap-4 rounded-2xl border border-line bg-white p-6 shadow-card\"><div class=\"grid h-11 w-11 flex-none place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 21V7l8-4 8 4v14M9 21v-6h6v6M9 11h.01M15 11h.01\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></div><div><h3 class=\"font-display text-[18px] font-semibold tracking-[-0.015em]\">Agencies &amp; integrators</h3><p class=\"mt-1.5 text-[14.5px] leading-relaxed text-muted\">Plug PYNGYN into your client stack and build a recurring revenue line on top.</p></div></div></div></section><section class=\"mx-auto w-full max-w-content px-5 pb-16 sm:px-7 sm:pb-20\"><h2 class=\"font-display text-[clamp(26px,3.6vw,38px)] font-semibold tracking-[-0.025em]\">Common questions.</h2><div class=\"mx-auto mt-8 max-w-[820px] divide-y divide-line overflow-hidden rounded-2xl border border-line bg-white\"><details class=\"group p-6 transition-colors open:bg-canvas/40\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4\"><h3 class=\"font-display text-[17px] font-semibold tracking-[-0.01em]\">How much do I earn per referral?</h3><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"flex-none text-muted transition-transform group-open:rotate-180\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></summary><p class=\"mt-3 text-[15px] leading-relaxed text-muted\">You earn 20% of the first year&#x27;s annual subscription for every paid referral. Payouts are sent monthly after the customer is billed.</p></details><details class=\"group p-6 transition-colors open:bg-canvas/40\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4\"><h3 class=\"font-display text-[17px] font-semibold tracking-[-0.01em]\">How much does my friend save?</h3><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"flex-none text-muted transition-transform group-open:rotate-180\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></summary><p class=\"mt-3 text-[15px] leading-relaxed text-muted\">Anyone who signs up through your link gets a 20% discount on their first year of any annual plan. The discount is applied automatically at checkout.</p></details><details class=\"group p-6 transition-colors open:bg-canvas/40\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4\"><h3 class=\"font-display text-[17px] font-semibold tracking-[-0.01em]\">Is there a cap on what I can earn?</h3><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"flex-none text-muted transition-transform group-open:rotate-180\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></summary><p class=\"mt-3 text-[15px] leading-relaxed text-muted\">No cap. The more firms you refer, the more you earn. We do reserve the right to review unusually large or unusual patterns to make sure everything is genuine.</p></details><details class=\"group p-6 transition-colors open:bg-canvas/40\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4\"><h3 class=\"font-display text-[17px] font-semibold tracking-[-0.01em]\">How long does my link stay attributed?</h3><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"flex-none text-muted transition-transform group-open:rotate-180\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></summary><p class=\"mt-3 text-[15px] leading-relaxed text-muted\">When someone clicks your link, the attribution lasts for 90 days. If they sign up within that window, the referral counts to you.</p></details><details class=\"group p-6 transition-colors open:bg-canvas/40\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4\"><h3 class=\"font-display text-[17px] font-semibold tracking-[-0.01em]\">When and how do I get paid?</h3><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"flex-none text-muted transition-transform group-open:rotate-180\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></summary><p class=\"mt-3 text-[15px] leading-relaxed text-muted\">Payouts go out monthly via bank transfer or PayPal, once the referred customer&#x27;s first invoice is paid and clears the standard refund window.</p></details><details class=\"group p-6 transition-colors open:bg-canvas/40\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4\"><h3 class=\"font-display text-[17px] font-semibold tracking-[-0.01em]\">Does this work with monthly plans?</h3><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"flex-none text-muted transition-transform group-open:rotate-180\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></summary><p class=\"mt-3 text-[15px] leading-relaxed text-muted\">Today the program rewards annual plan subscriptions only, that&#x27;s how we can offer both sides 20%. Monthly customers can always upgrade later to qualify.</p></details><details class=\"group p-6 transition-colors open:bg-canvas/40\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4\"><h3 class=\"font-display text-[17px] font-semibold tracking-[-0.01em]\">Can I refer my own company or use my own link?</h3><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"flex-none text-muted transition-transform group-open:rotate-180\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></summary><p class=\"mt-3 text-[15px] leading-relaxed text-muted\">Self-referrals don&#x27;t qualify. The program is for genuine third-party referrals, your peers, network, or audience.</p></details><details class=\"group p-6 transition-colors open:bg-canvas/40\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4\"><h3 class=\"font-display text-[17px] font-semibold tracking-[-0.01em]\">What about taxes?</h3><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"flex-none text-muted transition-transform group-open:rotate-180\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></summary><p class=\"mt-3 text-[15px] leading-relaxed text-muted\">Referral earnings are income. We&#x27;ll send any tax documentation required in your country once you cross the relevant threshold.</p></details></div><p class=\"mx-auto mt-6 max-w-[820px] text-[13.5px] text-muted\">Have a different question?<!-- --> <a href=\"mailto:referrals@pyngyn.com\" class=\"font-semibold text-accent hover:underline\">referrals@pyngyn.com</a> <!-- -->or<!-- --> <a class=\"font-semibold text-accent hover:underline\" href=\"/support/\">contact support</a>.</p></section><section class=\"mx-auto w-full max-w-content px-5 pb-16 sm:px-7 sm:pb-20\"><div class=\"hero-dark relative overflow-hidden rounded-[28px] p-9 text-center sm:p-14\"><div class=\"hero-grid pointer-events-none absolute inset-0\" aria-hidden=\"true\"></div><div class=\"relative\"><h2 class=\"mx-auto max-w-[640px] font-display text-[clamp(26px,3.8vw,40px)] font-semibold leading-tight tracking-[-0.02em] text-white\">Ready to start earning?</h2><p class=\"mx-auto mt-3 max-w-[480px] text-[16px] leading-relaxed text-white/65\">Grab your link, share it, and we&#x27;ll handle the rest.</p><div class=\"mt-7 flex flex-wrap justify-center gap-3\"><a href=\"#main\" class=\"inline-flex items-center rounded-full bg-accent px-7 py-3.5 text-[15px] font-semibold text-white shadow-cta transition-transform hover:-translate-y-0.5 hover:bg-accent-dk\">Get my referral link ↑</a><a href=\"/demo\" class=\"inline-flex items-center rounded-full border border-white/20 bg-white/5 px-7 py-3.5 text-[15px] font-semibold text-white hover:bg-white/10\">See PYNGYN first</a></div></div></div></section><section class=\"mx-auto w-full max-w-content px-5 pb-20 sm:px-7\"><div class=\"mx-auto max-w-[820px] text-[12.5px] leading-relaxed text-muted\"><p class=\"font-semibold text-ink\">Program terms (summary):</p><p class=\"mt-2\">The PYNGYN referral program pays a 20% commission on the first-year annual subscription value of qualifying paid referrals. The referred customer receives a 20% discount on their first year. Self-referrals, payments via prepaid/promotional credit, refunded subscriptions, and trial-only signups do not qualify. PYNGYN reserves the right to update, modify, or end the program at any time, and to disqualify activity it determines to be fraudulent, in violation of these terms, or otherwise abusive. Full terms apply, see our<!-- --> <a class=\"font-semibold text-accent hover:underline\" href=\"/terms/\">Terms</a>.</p></div></section><section id=\"demo\" class=\"section\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"relative overflow-hidden rounded-[28px] border border-line bg-white px-7 py-[72px] text-center shadow-card\"><div class=\"pointer-events-none absolute -top-24 left-1/2 h-[420px] w-[420px] -translate-x-1/2 rounded-full bg-accent-lt opacity-70 blur-[80px]\" aria-hidden=\"true\"></div><span class=\"eyebrow relative\">Ready when you are</span><h2 class=\"title relative mx-auto mt-3.5 max-w-[680px] text-[clamp(30px,4.4vw,48px)]\">Stop managing the tool. Start shipping the work.</h2><p class=\"lead relative mx-auto mt-[18px]\">See PYNGYN run a real project in 30 minutes, and let AI handle the project management busywork.</p><div class=\"relative mt-[30px] flex flex-wrap items-center justify-center gap-3.5\"><a href=\"/demo\" class=\"btn btn-primary\">Book a demo →</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-ghost\">Start free</a></div><p class=\"relative mt-4 text-sm text-muted\">30-minute walkthrough · Tailored to your team · No commitment</p></div></div></div></section></main><footer class=\"border-t border-line bg-white pt-16 pb-10 text-sm text-muted\"><div class=\"wrap\"><div class=\"grid gap-10 lg:grid-cols-[1.4fr_repeat(5,1fr)]\"><div><a class=\"mb-4 inline-block\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" loading=\"lazy\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><p class=\"max-w-[230px] leading-relaxed\">The operating system for professional-services firms.</p><a href=\"https://play.google.com/store/apps/details?id=com.pyngyn.io&amp;hl=en_IN\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"mt-5 inline-flex items-center gap-2.5 rounded-xl border border-line bg-white px-4 py-2.5 transition-colors hover:border-accent\" aria-label=\"Get PYNGYN on Google Play\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3.6 2.3 13 12 3.6 21.7a1.4 1.4 0 0 1-.6-1.2V3.5c0-.5.2-.9.6-1.2z\" fill=\"#34a853\"></path><path d=\"M16.8 8.6 13 12 3.6 2.3c.4-.3.9-.3 1.4 0l8.8 5z\" fill=\"#ea4335\"></path><path d=\"M16.8 15.4 5 22c-.5.3-1 .3-1.4 0L13 12z\" fill=\"#fbbc04\"></path><path d=\"m16.8 8.6 4 2.3c.7.4.7 1.4 0 1.8l-4 2.7L13 12z\" fill=\"#4285f4\"></path></svg><span class=\"flex flex-col leading-tight\"><span class=\"text-[10px] uppercase tracking-wide text-muted\">Get it on</span><span class=\"text-[14px] font-bold text-ink\">Google Play</span></span></a></div><div class=\"flex flex-col gap-8\"><div><h4 class=\"mb-3 text-[14px] font-bold text-ink\">Product</h4><div class=\"flex flex-col\"><a class=\"block py-1.5 hover:text-accent\" href=\"/clientspace/\">Clientspace</a><a class=\"block py-1.5 hover:text-accent\" href=\"/workspace/\">Workspace</a><a class=\"block py-1.5 hover:text-accent\" href=\"/benefits/\">Benefits</a><a class=\"block py-1.5 hover:text-accent\" href=\"/pricing/\">Pricing</a><a class=\"block py-1.5 hover:text-accent\" href=\"/integrations/\">Integrations</a></div></div><div><h4 class=\"mb-3 text-[14px] font-bold text-ink\">Get started</h4><div class=\"flex flex-col\"><a class=\"block py-1.5 hover:text-accent\" href=\"/demo/\">Book a demo</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"block py-1.5 hover:text-accent\">Start free</a></div></div></div><div class=\"flex flex-col gap-8\"><div><h4 class=\"mb-3 text-[14px] font-bold text-ink\">Compare</h4><div class=\"flex flex-col\"><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/notion/\">vs Notion</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/sana-labs/\">vs Sana Labs</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/guru/\">vs Guru</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/atlas/\">vs Atlas</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/clickup/\">vs ClickUp</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/asana/\">vs Asana</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/jira/\">vs Jira</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/twenty/\">vs Twenty</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/wrike/\">vs Wrike</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/\">All comparisons</a></div></div></div><div 