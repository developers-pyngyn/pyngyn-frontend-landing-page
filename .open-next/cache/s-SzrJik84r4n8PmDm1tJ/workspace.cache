{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/workspace/layout,_N_T_/workspace/page,_N_T_/workspace"},"segmentPaths":["/_tree","/_full","/workspace/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"display_2a073e65-module__7MkqkG__variable jakarta_55fc869e-module__LB2P7q__variable mono_8ba1b3ff-module__cxzmQq__variable\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_400_normal-s.p.2_o2v7tpo0q5m.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_500_normal-s.p.3vqzgd2jdiw22.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_600_normal-s.p.3_r60-qkmao3a.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_700_normal-s.p.0rb33xx2bxpl8.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_400_normal-s.p.3crsbyy6lh6yf.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_500_normal-s.p.2h52d08o60qht.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_600_normal-s.p.2mm922pe315l1.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_400_normal-s.p.2ysn9gc82zk1v.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_500_normal-s.p.1evhelic1rxge.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_600_normal-s.p.0p6sew1q6gl7s.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_700_normal-s.p.1dulefe5e4s81.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"/logo.webp\"/><link rel=\"preload\" as=\"image\" href=\"/screens/workspace-dashboard.webp\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/02mkr0z8o939x.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1b-l3oagpuv39.js\"/><script src=\"/_next/static/chunks/11jq0c2_zavac.js\" async=\"\"></script><script src=\"/_next/static/chunks/4561u0v7ysn3r.js\" async=\"\"></script><script src=\"/_next/static/chunks/021sppg0zbt0v.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2pcc6e_qu_s3g.js\" async=\"\"></script><script src=\"/_next/static/chunks/0ht-3v40sanoo.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/1_7yxp1yolfg7.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/1_p0c8_mtfqqv.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/41mnvtr75by45.js\" async=\"\" crossorigin=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Workspace | PYNGYN, the operating system for your firm</title><meta name=\"description\" content=\"Workspace is PYNGYN&#x27;s operating system for professional-services firms. Run projects, track finances, log billable time, and let AI keep plans, status, and risk current automatically.\"/><meta name=\"author\" content=\"Nikunj Chugh\"/><meta name=\"creator\" content=\"Nikunj Chugh\"/><link rel=\"canonical\" href=\"https://pyngyn.ai/workspace/\"/><meta property=\"og:title\" content=\"Workspace | PYNGYN, the operating system for your firm\"/><meta property=\"og:description\" content=\"Run every engagement from one place: engagement health, request triage, change orders, approvals, and capacity, with AI doing the busywork.\"/><meta property=\"og:url\" content=\"https://pyngyn.ai/workspace/\"/><meta property=\"og:image\" content=\"https://pyngyn.ai/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"PYNGYN: Clientspace, a standalone branded client portal, and Workspace, a standalone back office for professional-services firms\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:site\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:creator\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:title\" content=\"PYNGYN: The operating system for professional-services firms\"/><meta name=\"twitter:description\" content=\"Run your firm and every client engagement in one place. The operating system for professional-services firms.\"/><meta name=\"twitter:image\" content=\"https://pyngyn.ai/og.png\"/><link rel=\"icon\" href=\"/icon.png\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png\"/><script type=\"application/ld+json\" id=\"ld-organization\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://pyngyn.ai/#organization\",\"name\":\"PYNGYN\",\"legalName\":\"VIMOVI GlobalTech Private Limited\",\"url\":\"https://pyngyn.ai/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://pyngyn.ai/logo.png\",\"width\":512,\"height\":512},\"image\":\"https://pyngyn.ai/icon.png\",\"description\":\"PYNGYN gives every client a branded Client Space (a standalone portal for status, documents, and approvals), with Workspace, the firm's back office for projects, finances, and billable time, available on its own or bundled together.\",\"sameAs\":[\"https://x.com/Pyngyn_Official\",\"https://www.linkedin.com/company/pyngyn/\",\"https://www.reddit.com/user/Pyngyn_Official/\",\"https://www.facebook.com/profile.php?id=61584474731354\",\"https://www.youtube.com/@PyngynOfficial\",\"https://instagram.com/pyngyn_official\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"customer support\",\"email\":\"support@pyngyn.com\",\"url\":\"https://pyngyn.ai/support\",\"availableLanguage\":[\"English\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"sales@pyngyn.com\",\"url\":\"https://pyngyn.ai/demo\",\"availableLanguage\":[\"English\"]}]}</script><script type=\"application/ld+json\" id=\"ld-website\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://pyngyn.ai/#website\",\"url\":\"https://pyngyn.ai/\",\"name\":\"PYNGYN\",\"description\":\"The operating system for professional-services firms. Run your firm and every client engagement in one place.\",\"publisher\":{\"@id\":\"https://pyngyn.ai/#organization\"},\"inLanguage\":\"en\"}</script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-sans\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main\" class=\"sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white\">Skip to content</a><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://pyngyn.ai/workspace#webpage\",\"url\":\"https://pyngyn.ai/workspace\",\"name\":\"Workspace, your internal delivery command center | PYNGYN\",\"description\":\"Workspace is PYNGYN's operating system for professional-services firms: projects, finances, billable timesheets, Business Brain AI, automations, and team management at $9 per seat.\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"breadcrumb\":{\"@id\":\"https://pyngyn.ai/workspace#breadcrumb\"},\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/workspace#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://pyngyn.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Workspace\",\"item\":\"https://pyngyn.ai/workspace\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://pyngyn.ai/workspace#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is Workspace client-facing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Workspace is your internal command center, only your team sees it. Client Space is a separate, standalone product for giving clients a portal of their own, you can add it, or use it without Workspace at all.\"}},{\"@type\":\"Question\",\"name\":\"How is Workspace different from Client Space?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Workspace is where your firm runs internal work: projects, finances, billable timesheets, Business Brain AI, automations, and team management, all at $9 per seat/month. Client Space is a standalone branded client portal at $19 per client/month, giving each client their own isolated space with client-visible tasks, approvals, and sign-off. Bundle both for $24.99/month.\"}},{\"@type\":\"Question\",\"name\":\"How many people can use Workspace?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Workspace is $9 per seat per month with no seat cap. Add as many directors, managers, and ICs as your firm needs. See the pricing page for the latest details.\"}},{\"@type\":\"Question\",\"name\":\"Can the AI draft client messages for a change request?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. When you review a change request, you can generate an AI draft of the client message, then edit it before anything is sent.\"}},{\"@type\":\"Question\",\"name\":\"What happens when a change request is approved?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"On approval it becomes a change order: it amends the statement of work and updates the engagement budget, so your numbers stay accurate without manual rework.\"}},{\"@type\":\"Question\",\"name\":\"How do I get my work into Workspace?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Start from your goal and let the AI draft the plan, or build engagements directly. The point is to be running real work the same day, not setting up for weeks.\"}},{\"@type\":\"Question\",\"name\":\"What happens after the free trial?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"You can keep your firm on Workspace at $9 per seat/month, and add Client Space at $19 per client whenever you want a client portal, or bundle both for $24.99/month. See the pricing page for what each plan includes.\"}},{\"@type\":\"Question\",\"name\":\"Do you help with onboarding and support?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Every plan includes support. Enterprise adds dedicated onboarding and migration, a named account manager, and a custom SLA.\"}}]}]}</script><header class=\"fixed inset-x-0 top-0 z-[100] border-b transition-all duration-300 border-transparent bg-transparent\"><div class=\"wrap flex h-[68px] items-center justify-between\"><a class=\"flex items-center\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><div class=\"hidden h-full lg:flex lg:items-center\"><nav class=\"flex items-center gap-7 text-[15px] text-[#3a3a42]\"><a class=\"py-2 transition-colors hover:text-accent\" href=\"/clientspace/\">Clientspace</a><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Product<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Solutions<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Resources<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Compare<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></nav></div><div class=\"flex items-center gap-3\"><a href=\"https://app.pyngyn.ai/\" class=\"hidden text-[15px] font-semibold lg:inline \">Sign in</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"hidden px-4 py-2.5 lg:inline-flex btn btn-ghost\">Start free</a><a href=\"/demo\" class=\"hidden px-[18px] py-2.5 lg:inline-flex btn btn-primary\">Book a demo</a><button type=\"button\" class=\"grid h-10 w-10 place-items-center rounded-lg border lg:hidden border-line bg-white text-ink\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"mobile-menu\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"></path></svg></button></div></div></header><main id=\"main\"><section class=\"wrap pb-[44px] pt-[150px]\"><div class=\"grid items-center gap-12 lg:grid-cols-[1.04fr_0.96fr]\"><div style=\"opacity:0;transform:translateY(26px)\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>Workspace</span><h1 class=\"mt-4 font-display text-[clamp(34px,4.6vw,56px)] font-semibold leading-[1.04] tracking-[-0.025em]\">Run every engagement <span class=\"text-accent\">from one place.</span></h1><p class=\"lead mt-5 max-w-[560px]\">Workspace is PYNGYN&#x27;s internal command center for managers and delivery leads. Track engagement health, balance your team&#x27;s capacity, triage requests, and turn change requests into change orders, all in one view.</p><div class=\"mt-7 flex flex-wrap items-center gap-3.5\"><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-primary px-[18px] py-2.5\">Start free trial</a><a href=\"/demo\" class=\"btn btn-ghost px-[18px] py-2.5\">Book a demo</a></div><p class=\"mt-4 text-[13.5px] text-muted\">$9 per seat / month · pair with Client Space at $19 per client, or bundle for $24.99/mo.<!-- --> <a class=\"font-semibold text-accent hover:underline\" href=\"/pricing/\">See pricing</a></p></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"overflow-hidden rounded-[18px] border border-line bg-white shadow-art\"><img alt=\"Workspace dashboard showing today&#x27;s schedule, priority action items, engagements awaiting review, and billable hours for a consultant\" width=\"1918\" height=\"943\" decoding=\"async\" data-nimg=\"1\" class=\"h-auto w-full\" style=\"color:transparent\" src=\"/screens/workspace-dashboard.webp\"/></div></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"mt-12 max-w-[720px] rounded-[20px] border border-accent/30 bg-accent-lt p-5 sm:p-6\"><div class=\"flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between\"><div><span class=\"inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.14em] text-accent\"><span class=\"h-1.5 w-1.5 rounded-full bg-accent\" aria-hidden=\"true\"></span>7-day free trial</span><p class=\"mt-1.5 text-[16px] font-bold text-ink\">Try Workspace on a real engagement first.</p><p class=\"text-[13.5px] text-muted\">No credit card required, cancel anytime before the trial ends.</p></div><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-accent flex-none px-[18px] py-2.5\">Start free trial</a></div></div></div></section><section class=\"section-tight\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"max-w-[720px]\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>The reality without it</span><h2 class=\"title mt-3\">Sound familiar?</h2><p class=\"lead mt-4\">Running client delivery on email, spreadsheets, and status meetings means the things that matter surface too late. Here is what that looks like day to day.</p></div></div><div class=\"mt-10 grid gap-5 sm:grid-cols-2\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card flex h-full gap-4 p-6\"><span class=\"grid h-11 w-11 flex-none place-items-center rounded-xl bg-[#fef2f2] text-[#dc2626]\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></circle><path d=\"M12 8v4l3 2\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><h3 class=\"text-[16px] font-bold\">Status is always a meeting behind</h3><p class=\"mt-1.5 text-[14px] leading-relaxed text-muted\">You chase the team for updates, and by the time the report is ready it is already out of date.</p></div></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card flex h-full gap-4 p-6\"><span class=\"grid h-11 w-11 flex-none place-items-center rounded-xl bg-[#fef2f2] text-[#dc2626]\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 3l9 16H3l9-16z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path><path d=\"M12 10v4M12 17h.01\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><h3 class=\"text-[16px] font-bold\">Budget overruns surface too late</h3><p class=\"mt-1.5 text-[14px] leading-relaxed text-muted\">An engagement slips past budget quietly, and you find out after the invoice, not before it.</p></div></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card flex h-full gap-4 p-6\"><span class=\"grid h-11 w-11 flex-none place-items-center rounded-xl bg-[#fef2f2] text-[#dc2626]\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 12h13M12 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><h3 class=\"text-[16px] font-bold\">Scope creep eats the margin</h3><p class=\"mt-1.5 text-[14px] leading-relaxed text-muted\">Clients ask for one more thing, and with no record of the cost it gets absorbed, not billed.</p></div></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card flex h-full gap-4 p-6\"><span class=\"grid h-11 w-11 flex-none place-items-center rounded-xl bg-[#fef2f2] text-[#dc2626]\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></rect><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></rect><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></rect><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></rect></svg></span><div><h3 class=\"text-[16px] font-bold\">The work is scattered</h3><p class=\"mt-1.5 text-[14px] leading-relaxed text-muted\">Requests in email, status in slides, approvals in chat. No single place shows where things stand.</p></div></div></div></div></div></section><section class=\"section-tight\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"max-w-[720px]\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>With Workspace</span><h2 class=\"title mt-3\">From firefighting to in control.</h2><p class=\"lead mt-4\">The same week, run on PYNGYN instead of email, spreadsheets, and status meetings.</p></div></div><div class=\"mt-10 overflow-hidden rounded-[22px] border border-line bg-white shadow-card\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"grid sm:grid-cols-2 border-b border-line\"><div class=\"flex items-start gap-3 bg-[#fff7f7] p-5\"><span class=\"mt-0.5 flex-none text-[15px] font-bold text-[#dc2626]\" aria-hidden=\"true\">✕</span><p class=\"text-[14px] leading-relaxed text-muted\">You chase the team for status updates.</p></div><div class=\"flex items-start gap-3 bg-accent-lt p-5\"><span class=\"mt-0.5 flex-none text-[15px] font-bold text-positive\" aria-hidden=\"true\">✓</span><p class=\"text-[14px] font-medium leading-relaxed text-ink\">AI drafts each update from live activity, ready before the meeting.</p></div></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"grid sm:grid-cols-2 border-b border-line\"><div class=\"flex items-start gap-3 bg-[#fff7f7] p-5\"><span class=\"mt-0.5 flex-none text-[15px] font-bold text-[#dc2626]\" aria-hidden=\"true\">✕</span><p class=\"text-[14px] leading-relaxed text-muted\">Budget overruns turn up after the invoice.</p></div><div class=\"flex items-start gap-3 bg-accent-lt p-5\"><span class=\"mt-0.5 flex-none text-[15px] font-bold text-positive\" aria-hidden=\"true\">✓</span><p class=\"text-[14px] font-medium leading-relaxed text-ink\">Engagements flag the moment they trend over budget.</p></div></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"grid sm:grid-cols-2 border-b border-line\"><div class=\"flex items-start gap-3 bg-[#fff7f7] p-5\"><span class=\"mt-0.5 flex-none text-[15px] font-bold text-[#dc2626]\" aria-hidden=\"true\">✕</span><p class=\"text-[14px] leading-relaxed text-muted\">Scope creep gets absorbed, not billed.</p></div><div class=\"flex items-start gap-3 bg-accent-lt p-5\"><span class=\"mt-0.5 flex-none text-[15px] font-bold text-positive\" aria-hidden=\"true\">✓</span><p class=\"text-[14px] font-medium leading-relaxed text-ink\">Every change request shows hours, cost, and timeline, then becomes a change order.</p></div></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"grid sm:grid-cols-2 \"><div class=\"flex items-start gap-3 bg-[#fff7f7] p-5\"><span class=\"mt-0.5 flex-none text-[15px] font-bold text-[#dc2626]\" aria-hidden=\"true\">✕</span><p class=\"text-[14px] leading-relaxed text-muted\">Work is spread across email, slides, and chat.</p></div><div class=\"flex items-start gap-3 bg-accent-lt p-5\"><span class=\"mt-0.5 flex-none text-[15px] font-bold text-positive\" aria-hidden=\"true\">✓</span><p class=\"text-[14px] font-medium leading-relaxed text-ink\">Requests, status, and approvals all live in one place.</p></div></div></div></div></div></section><section class=\"section-tight\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><p class=\"text-[12px] font-bold uppercase tracking-[0.14em] text-muted\">Opens on what needs attention</p><h2 class=\"title mt-3 max-w-[760px]\">Your day starts with the decisions, not the digging.</h2></div><div class=\"mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-11 w-11 place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></rect><path d=\"M7 9h10M7 13h7\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><h3 class=\"mt-4 text-[16px] font-bold\">Active engagements</h3><p class=\"mt-1.5 text-[14px] leading-relaxed text-muted\">Everything in flight, in one list you can act on.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-11 w-11 place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 3l9 16H3l9-16z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path><path d=\"M12 10v4M12 17h.01\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><h3 class=\"mt-4 text-[16px] font-bold\">At budget risk</h3><p class=\"mt-1.5 text-[14px] leading-relaxed text-muted\">Flagged the moment an engagement trends over budget.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-11 w-11 place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h11l-3-3M20 17H9l3 3\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><h3 class=\"mt-4 text-[16px] font-bold\">Open change requests</h3><p class=\"mt-1.5 text-[14px] leading-relaxed text-muted\">Scope changes tracked from request to change order.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-11 w-11 place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 12l2 2 4-4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path><circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></circle></svg></span><h3 class=\"mt-4 text-[16px] font-bold\">Pending approvals</h3><p class=\"mt-1.5 text-[14px] leading-relaxed text-muted\">What is waiting on a decision, and from whom.</p></div></div></div></div></section><section class=\"section\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"text-center\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>What Workspace does</span><h2 class=\"title mt-3\">Everything your team needs to run the work.</h2><p class=\"lead mx-auto mt-4 max-w-[640px]\">One internal home for delivery, from the first request to the final approval.</p></div></div><div class=\"mt-[46px] grid gap-5 md:grid-cols-2 lg:grid-cols-3\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-11 w-11 place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 12h4l3 7 4-14 3 7h4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><h3 class=\"mt-4 text-[17px] font-bold\">Engagement health at a glance</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Every engagement shows progress and budget used, with the lead named, so you see what is healthy and what is heading over before it slips.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-11 w-11 place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"4\" rx=\"1\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></rect><rect x=\"3\" y=\"10\" width=\"18\" height=\"4\" rx=\"1\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></rect><rect x=\"3\" y=\"16\" width=\"18\" height=\"4\" rx=\"1\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></rect></svg></span><h3 class=\"mt-4 text-[17px] font-bold\">Triage the request queue</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Incoming work lands in one queue with statuses and SLA timers, New, In progress, Awaiting client, Done, so nothing sits unanswered.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-11 w-11 place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></circle><path d=\"M3 20a6 6 0 0112 0\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path><path d=\"M16 8h5M18.5 5.5v5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><h3 class=\"mt-4 text-[17px] font-bold\">Balance team capacity</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">See who is working on what and distribute workload across the team, so no one is buried while someone else has room.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-11 w-11 place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><h3 class=\"mt-4 text-[17px] font-bold\">Keep approvals moving</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Pending approvals are tracked in one place so decisions do not stall in inboxes and chat threads.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-11 w-11 place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path><circle cx=\"12\" cy=\"12\" r=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></circle></svg></span><h3 class=\"mt-4 text-[17px] font-bold\">Role-aware views</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Switch perspective between consultant, manager, and director, so each person sees the slice of the work that matters to them.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-11 w-11 place-items-center rounded-xl bg-accent-lt text-accent\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 3v3M12 18v3M5 12H2M22 12h-3M6 6l-2-2M20 20l-2-2M6 18l-2 2M20 4l-2 2\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path><circle cx=\"12\" cy=\"12\" r=\"3.2\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></circle></svg></span><h3 class=\"mt-4 text-[17px] font-bold\">Business Brain AI</h3><p class=\"mt-2 text-[14px] leading-relaxed text-muted\">Expanded AI drafts your status updates and summaries, surfaces suggestions, and gives you workload insights, the busywork, handled.</p></div></div></div></div></section><section class=\"section\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"mx-auto max-w-[680px] text-center\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>Inside PYNGYN</span><h2 class=\"title mt-3\">The actual product. Not a mockup.</h2><p class=\"lead mx-auto mt-4\">Real screens from Clientspace and Workspace, the two products your firm and clients use every day.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><figure class=\"mx-auto mt-[46px] max-w-[1000px]\"><div class=\"overflow-hidden rounded-[16px] border border-line bg-white shadow-art\"><img alt=\"PYNGYN Clientspace showing a client&#x27;s branded portal with needs-your-attention items, active engagements, engagement value, and upcoming sessions at a glance\" loading=\"lazy\" width=\"1909\" height=\"940\" decoding=\"async\" data-nimg=\"1\" class=\"h-auto w-full\" style=\"color:transparent\" src=\"/screens/clientspace-space.webp\"/></div><figcaption class=\"mt-3 text-center text-[13px] text-muted\">Your client&#x27;s Clientspace: engagements, approvals, and status in one branded portal.</figcaption></figure></div><div class=\"mt-[72px] space-y-[72px]\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"grid items-center gap-8 md:grid-cols-2 md:gap-12\"><div class=\"md:order-2\"><span class=\"font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-accent\">Business Brain</span><h3 class=\"mt-2.5 font-display text-[clamp(24px,3vw,32px)] font-semibold leading-[1.1] tracking-[-0.02em]\">AI triages everything that needs you.</h3><p class=\"mt-3 max-w-[480px] text-[16px] leading-relaxed text-muted\">Smart Inbox sorts client replies, approvals, and updates into Needs response, FYI, and Low priority, each with a one-line reason, so partners spend their time deciding, not sifting through a feed.</p></div><div class=\"md:order-1\"><div class=\"overflow-hidden rounded-[16px] border border-line bg-white shadow-art\"><img alt=\"PYNGYN Smart Inbox, AI-triaged, sorting items into Needs response, FYI, and Low priority with a one-line reason and confidence score for each\" loading=\"lazy\" width=\"1920\" height=\"949\" decoding=\"async\" data-nimg=\"1\" class=\"h-auto w-full\" style=\"color:transparent\" src=\"/screens/smart-inbox.webp\"/></div></div></div></div></div></div></section><section class=\"section-tight\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"grid items-center gap-9 rounded-[28px] border border-line bg-white p-8 shadow-card lg:grid-cols-[1.05fr_1fr] lg:p-12\"><div><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>Change requests, handled</span><h2 class=\"title mt-3 text-[clamp(26px,3.4vw,38px)]\">Turn scope changes into change orders.</h2><p class=\"lead mt-4\">When a client asks for more, Workspace shows the implications up front, added hours, added cost, and timeline impact. Generate an AI draft of the client message, edit it, and send.</p><p class=\"mt-4 text-[14.5px] leading-relaxed text-muted\">On approval it becomes a change order: it amends the statement of work and updates the budget automatically, so your numbers never drift from reality.</p></div><div class=\"rounded-2xl border border-line bg-canvas p-6\"><div class=\"text-[13px] font-bold uppercase tracking-wider text-muted\">Review implications</div><div class=\"mt-4 grid grid-cols-3 gap-3\"><div class=\"rounded-xl border border-line bg-white p-3.5\"><div class=\"text-[12px] text-muted\">Added hours</div><div class=\"mt-1 text-[20px] font-bold\">+40h</div></div><div class=\"rounded-xl border border-line bg-white p-3.5\"><div class=\"text-[12px] text-muted\">Added cost</div><div class=\"mt-1 text-[20px] font-bold\">+ budget</div></div><div class=\"rounded-xl border border-line bg-white p-3.5\"><div class=\"text-[12px] text-muted\">Timeline</div><div class=\"mt-1 text-[20px] font-bold\">+2 wks</div></div></div><div class=\"mt-4 flex flex-wrap gap-2.5\"><span class=\"btn btn-accent px-4 py-2 text-[13.5px]\">Send to client</span><span class=\"btn btn-ghost px-4 py-2 text-[13.5px]\">Edit</span><span class=\"btn btn-ghost px-4 py-2 text-[13.5px]\">AI draft</span></div><p class=\"mt-3 text-[12.5px] italic text-muted\">Illustrative, your live numbers come from the engagement.</p></div></div></div></div></section><section class=\"section\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"text-center\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>Get started</span><h2 class=\"title mt-3\">Live in an afternoon, not a quarter.</h2><p class=\"lead mx-auto mt-4 max-w-[620px]\">No long rollout. Most teams are running their first engagement the same day.</p></div></div><div class=\"mt-[46px] grid gap-5 sm:grid-cols-2 lg:grid-cols-4\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-9 w-9 place-items-center rounded-full bg-accent text-[15px] font-bold text-white\">1</span><h3 class=\"mt-4 text-[16px] font-bold\">Create your workspace</h3><p class=\"mt-1.5 text-[14px] leading-relaxed text-muted\">Set up your firm&#x27;s workspace in a couple of clicks. No setup project required.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-9 w-9 place-items-center rounded-full bg-accent text-[15px] font-bold text-white\">2</span><h3 class=\"mt-4 text-[16px] font-bold\">Add your engagements</h3><p class=\"mt-1.5 text-[14px] leading-relaxed text-muted\">Build them directly, or let the AI draft the plan from your goal.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-9 w-9 place-items-center rounded-full bg-accent text-[15px] font-bold text-white\">3</span><h3 class=\"mt-4 text-[16px] font-bold\">Invite your firm</h3><p class=\"mt-1.5 text-[14px] leading-relaxed text-muted\">$9 per seat, no cap. Directors, managers, and ICs each see the work that matters to their role.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-6\"><span class=\"grid h-9 w-9 place-items-center rounded-full bg-accent text-[15px] font-bold text-white\">4</span><h3 class=\"mt-4 text-[16px] font-bold\">Let the AI take the busywork</h3><p class=\"mt-1.5 text-[14px] leading-relaxed text-muted\">Status updates, summaries, and risk flags are drafted for you from day one.</p></div></div></div></div></section><section class=\"section-tight\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"max-w-[720px]\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>Who it is for</span><h2 class=\"title mt-3\">Built for client-services firms.</h2><p class=\"lead mt-4\">If you bill for delivery and answer to clients, Workspace fits how you already work.</p></div></div><div class=\"mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-5\"><h3 class=\"text-[15px] font-bold\">Consultancies</h3><p class=\"mt-1.5 text-[13.5px] leading-relaxed text-muted\">Run multiple audits and advisory engagements without losing the thread on any of them.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-5\"><h3 class=\"text-[15px] font-bold\">Agencies</h3><p class=\"mt-1.5 text-[13.5px] leading-relaxed text-muted\">Keep retainers and project work on scope, on budget, and visible to the whole team.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-5\"><h3 class=\"text-[15px] font-bold\">Accounting</h3><p class=\"mt-1.5 text-[13.5px] leading-relaxed text-muted\">Filings, reviews, and approvals tracked with a clear trail for every client.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-5\"><h3 class=\"text-[15px] font-bold\">Legal</h3><p class=\"mt-1.5 text-[13.5px] leading-relaxed text-muted\">Matter work, redlines, and client sign-offs organized in one place.</p></div></div></div></div></section><section class=\"section\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"text-center\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>From discovery calls</span><h2 class=\"title mt-3\">What delivery leads tell us.</h2><p class=\"lead mx-auto mt-4 max-w-[640px]\">Anonymised observations from conversations with managers and delivery leads at services firms. Roles only, no names.</p></div></div><div class=\"mt-[46px] grid gap-[22px] md:grid-cols-3\"><div style=\"opacity:0;transform:translateY(26px)\"><figure class=\"card flex h-full flex-col\"><span class=\"font-mono text-[10.5px] font-semibold uppercase tracking-[0.14em] text-muted\">From a discovery call</span><blockquote class=\"mt-3 flex-1 text-[16.5px] leading-relaxed\">“<!-- -->Half my week goes to asking people for updates, just to build a status that is already stale by Friday.<!-- -->”</blockquote><figcaption class=\"mt-5 border-t border-line pt-3.5 text-[13.5px] text-muted\">Delivery manager, consulting firm</figcaption></figure></div><div style=\"opacity:0;transform:translateY(26px)\"><figure class=\"card flex h-full flex-col\"><span class=\"font-mono text-[10.5px] font-semibold uppercase tracking-[0.14em] text-muted\">From a discovery call</span><blockquote class=\"mt-3 flex-1 text-[16.5px] leading-relaxed\">“<!-- -->I find out an engagement blew its budget when finance flags the invoice, never in time to act on it.<!-- -->”</blockquote><figcaption class=\"mt-5 border-t border-line pt-3.5 text-[13.5px] text-muted\">Engagement lead, advisory firm</figcaption></figure></div><div style=\"opacity:0;transform:translateY(26px)\"><figure class=\"card flex h-full flex-col\"><span class=\"font-mono text-[10.5px] font-semibold uppercase tracking-[0.14em] text-muted\">From a discovery call</span><blockquote class=\"mt-3 flex-1 text-[16.5px] leading-relaxed\">“<!-- -->Scope changes live in email threads. By the time everyone agrees, we have already done the work for free.<!-- -->”</blockquote><figcaption class=\"mt-5 border-t border-line pt-3.5 text-[13.5px] text-muted\">Operations lead, professional-services firm</figcaption></figure></div></div></div></section><section class=\"section-tight\"><div class=\"wrap text-center\"><div style=\"opacity:0;transform:translateY(26px)\"><h2 class=\"title text-[clamp(26px,3vw,34px)]\">Works with the tools you already use.</h2></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"mt-[34px] flex flex-wrap items-center justify-center gap-x-10 gap-y-5 opacity-70\"><span class=\"text-[17px] font-bold tracking-wide text-[#9aa0ad]\">Slack</span><span class=\"text-[17px] font-bold tracking-wide text-[#9aa0ad]\">QuickBooks</span><span class=\"text-[17px] font-bold tracking-wide text-[#9aa0ad]\">Google</span><span class=\"text-[17px] font-bold tracking-wide text-[#9aa0ad]\">Figma</span><span class=\"text-[17px] font-bold tracking-wide text-[#9aa0ad]\">Zoom</span><span class=\"text-[17px] font-bold tracking-wide text-[#9aa0ad]\">Xero</span><span class=\"text-[17px] font-bold tracking-wide text-[#9aa0ad]\">Salesforce</span><span class=\"text-[17px] font-bold tracking-wide text-[#9aa0ad]\">DocuSign</span></div><a href=\"/integrations\" class=\"mt-7 inline-block font-semibold text-accent\">See all integrations →</a></div></div></section><section class=\"section\"><div class=\"wrap max-w-[800px] text-center\"><div style=\"opacity:0;transform:translateY(26px)\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>Security &amp; trust</span><h2 class=\"title mt-3 text-[clamp(26px,3vw,36px)]\">Enterprise-grade, by default.</h2><p class=\"lead mx-auto mt-4\">Your data is encrypted, never sold, and never used to train models without your consent.</p></div><div class=\"mt-[30px] flex flex-wrap items-center justify-center gap-3.5\"><div style=\"opacity:0;transform:translateY(26px)\"><span class=\"inline-flex items-center gap-2 rounded-full border border-line bg-white px-3.5 py-2 text-[13px] font-semibold text-ink shadow-card\"><span aria-hidden=\"true\" class=\"text-positive\">✓</span> <!-- -->SOC 2 aligned</span></div><div style=\"opacity:0;transform:translateY(26px)\"><span class=\"inline-flex items-center gap-2 rounded-full border border-line bg-white px-3.5 py-2 text-[13px] font-semibold text-ink shadow-card\"><span aria-hidden=\"true\" class=\"text-positive\">✓</span> <!-- -->GDPR compliant</span></div><div style=\"opacity:0;transform:translateY(26px)\"><span class=\"inline-flex items-center gap-2 rounded-full border border-line bg-white px-3.5 py-2 text-[13px] font-semibold text-ink shadow-card\"><span aria-hidden=\"true\" class=\"text-positive\">✓</span> <!-- -->Encrypted in transit &amp; at rest</span></div><div style=\"opacity:0;transform:translateY(26px)\"><span class=\"inline-flex items-center gap-2 rounded-full border border-line bg-white px-3.5 py-2 text-[13px] font-semibold text-ink shadow-card\"><span aria-hidden=\"true\" class=\"text-positive\">✓</span> <!-- -->SSO / SAML</span></div></div></div></section><section class=\"section-tight\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"text-center\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>Workspace or Client Space</span><h2 class=\"title mt-3\">Two standalone products. Use one, or bundle both.</h2></div></div><div class=\"mt-10 grid gap-5 lg:grid-cols-2\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full p-7\"><h3 class=\"text-[18px] font-bold\">Workspace</h3><p class=\"mt-1 text-[13px] text-muted\">Internal, not client-facing</p><ul class=\"mt-5 flex flex-col gap-2.5 text-[14px] text-ink\"><li class=\"flex gap-2.5\"><span class=\"mt-0.5 flex-none text-positive\" aria-hidden=\"true\">✓</span>Engagement health and budget tracking</li><li class=\"flex gap-2.5\"><span class=\"mt-0.5 flex-none text-positive\" aria-hidden=\"true\">✓</span>Team workload and capacity</li><li class=\"flex gap-2.5\"><span class=\"mt-0.5 flex-none text-positive\" aria-hidden=\"true\">✓</span>Request queue and change orders</li><li class=\"flex gap-2.5\"><span class=\"mt-0.5 flex-none text-positive\" aria-hidden=\"true\">✓</span>Approvals and reporting</li><li class=\"flex gap-2.5\"><span class=\"mt-0.5 flex-none text-positive\" aria-hidden=\"true\">✓</span>Business Brain AI</li></ul></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card h-full border-accent p-7 ring-1 ring-accent\"><div class=\"flex items-center gap-2\"><h3 class=\"text-[18px] font-bold\">Client Space</h3><span class=\"rounded-full bg-accent px-2.5 py-0.5 text-[11px] font-bold text-white\">Standalone</span></div><p class=\"mt-1 text-[13px] text-muted\">A branded client portal, works with or without Workspace</p><ul class=\"mt-5 flex flex-col gap-2.5 text-[14px] text-ink\"><li class=\"flex gap-2.5\"><span class=\"mt-0.5 flex-none text-accent\" aria-hidden=\"true\">✓</span>A client portal of their own</li><li class=\"flex gap-2.5\"><span class=\"mt-0.5 flex-none text-accent\" aria-hidden=\"true\">✓</span>Up to 50 clients</li><li class=\"flex gap-2.5\"><span class=\"mt-0.5 flex-none text-accent\" aria-hidden=\"true\">✓</span>Scope Guard (scope-change protection)</li><li class=\"flex gap-2.5\"><span class=\"mt-0.5 flex-none text-accent\" aria-hidden=\"true\">✓</span>Audit-trail approvals</li></ul></div></div></div><div class=\"mt-8 text-center\"><a class=\"btn btn-primary px-[18px] py-2.5\" href=\"/pricing/\">Compare plans</a></div></div></section><section class=\"section\"><div class=\"wrap max-w-[820px]\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"text-center\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>Questions</span><h2 class=\"title mt-3\">Workspace, answered.</h2></div></div><div class=\"mt-10 flex flex-col gap-3\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card p-6\"><h3 class=\"text-[16px] font-bold\">Is Workspace client-facing?</h3><p class=\"mt-2 text-[14.5px] leading-relaxed text-muted\">No. Workspace is your internal command center, only your team sees it. Client Space is a separate, standalone product for giving clients a portal of their own, you can add it, or use it without Workspace at all.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card p-6\"><h3 class=\"text-[16px] font-bold\">How is Workspace different from Client Space?</h3><p class=\"mt-2 text-[14.5px] leading-relaxed text-muted\">Workspace is where your firm runs internal work: projects, finances, billable timesheets, Business Brain AI, automations, and team management, all at $9 per seat/month. Client Space is a standalone branded client portal at $19 per client/month, giving each client their own isolated space with client-visible tasks, approvals, and sign-off. Bundle both for $24.99/month.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card p-6\"><h3 class=\"text-[16px] font-bold\">How many people can use Workspace?</h3><p class=\"mt-2 text-[14.5px] leading-relaxed text-muted\">Workspace is $9 per seat per month with no seat cap. Add as many directors, managers, and ICs as your firm needs. See the pricing page for the latest details.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card p-6\"><h3 class=\"text-[16px] font-bold\">Can the AI draft client messages for a change request?</h3><p class=\"mt-2 text-[14.5px] leading-relaxed text-muted\">Yes. When you review a change request, you can generate an AI draft of the client message, then edit it before anything is sent.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card p-6\"><h3 class=\"text-[16px] font-bold\">What happens when a change request is approved?</h3><p class=\"mt-2 text-[14.5px] leading-relaxed text-muted\">On approval it becomes a change order: it amends the statement of work and updates the engagement budget, so your numbers stay accurate without manual rework.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card p-6\"><h3 class=\"text-[16px] font-bold\">How do I get my work into Workspace?</h3><p class=\"mt-2 text-[14.5px] leading-relaxed text-muted\">Start from your goal and let the AI draft the plan, or build engagements directly. The point is to be running real work the same day, not setting up for weeks.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card p-6\"><h3 class=\"text-[16px] font-bold\">What happens after the free trial?</h3><p class=\"mt-2 text-[14.5px] leading-relaxed text-muted\">You can keep your firm on Workspace at $9 per seat/month, and add Client Space at $19 per client whenever you want a client portal, or bundle both for $24.99/month. See the pricing page for what each plan includes.</p></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"card p-6\"><h3 class=\"text-[16px] font-bold\">Do you help with onboarding and support?</h3><p class=\"mt-2 text-[14.5px] leading-relaxed text-muted\">Every plan includes support. Enterprise adds dedicated onboarding and migration, a named account manager, and a custom SLA.</p></div></div></div></div></section><section id=\"demo\" class=\"section\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"relative overflow-hidden rounded-[28px] border border-line bg-white px-7 py-[72px] text-center shadow-card\"><div class=\"pointer-events-none absolute -top-24 left-1/2 h-[420px] w-[420px] -translate-x-1/2 rounded-full bg-accent-lt opacity-70 blur-[80px]\" aria-hidden=\"true\"></div><span class=\"eyebrow relative\">Ready when you are</span><h2 class=\"title relative mx-auto mt-3.5 max-w-[680px] text-[clamp(30px,4.4vw,48px)]\">Stop managing the tool. Start shipping the work.</h2><p class=\"lead relative mx-auto mt-[18px]\">See PYNGYN run a real project in 30 minutes, and let AI handle the project management busywork.</p><div class=\"relative mt-[30px] flex flex-wrap items-center justify-center gap-3.5\"><a href=\"/demo\" class=\"btn btn-primary\">Book a demo →</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-ghost\">Start free</a></div><p class=\"relative mt-4 text-sm text-muted\">30-minute walkthrough · Tailored to your team · No commitment</p></div></div></div></section></main><div class=\"fixed inset-x-0 bottom-0 z-[70] border-t border-white/10 bg-ink text-white shadow-[0_-10px_30px_-14px_rgba(0,0,0,0.55)] transition-transform duration-300 translate-y-full pointer-events-none\" role=\"region\" aria-label=\"Start a free trial\" aria-hidden=\"true\"><div class=\"flex items-center justify-between gap-3 px-5 py-3 pl-[76px]\"><span class=\"text-[13.5px] font-semibold text-white/85\">7-day free trial · No credit card required</span><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-accent flex-none px-4 py-2 text-[13.5px]\">Start free trial</a></div></div><footer class=\"border-t border-line bg-white pt-16 pb-10 text-sm text-muted\"><div class=\"wrap\"><div class=\"grid gap-10 lg:grid-cols-[1.4fr_repeat(5,1fr)]\"><div><a class=\"mb-4 inline-block\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" loading=\"lazy\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><p class=\"max-w-[230px] leading-relaxed\">The operating system for professional-services firms.</p><a href=\"https://play.google.com/store/apps/details?id=com.pyngyn.io&amp;hl=en_IN\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"mt-5 inline-flex items-center gap-2.5 rounded-xl border border-line bg-white px-4 py-2.5 transition-colors hover:border-accent\" aria-label=\"Get PYNGYN on Google Play\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3.6 2.3 13 12 3.6 21.7a1.4 1.4 0 0 1-.6-1.2V3.5c0-.5.2-.9.6-1.2z\" fill=\"#34a853\"></path><path d=\"M16.8 8.6 13 12 3.6 2.3c.4-.3.9-.3 1.4 0l8.8 5z\" fill=\"#ea4335\"></path><path d=\"M16.8 15.4 5 22c-.5.3-1 .3-1.4 0L13 12z\" fill=\"#fbbc04\"></path><path d=\"m16.8 8.6 4 2.3c.7.4.7 1.4 0 1.8l-4 2.7L13 12z\" fill=\"#4285f4\"></path></svg><span class=\"flex flex-col leading-tight\"><span class=\"text-[10px] uppercase tracking-wide text-muted\">Get it on</span><span class=\"text-[14px] font-bold text-ink\">Google Play</span></span></a></div><div class=\"flex flex-col gap-8\"><div><h4 class=\"mb-3 text-[14px] font-bold text-ink\">Product</h4><div class=\"flex flex-col\"><a class=\"block py-1.5 hover:text-accent\" href=\"/clientspace/\">Clientspace</a><a class=\"block py-1.5 hover:text-accent\" href=\"/workspace/\">Workspace</a><a class=\"block py-1.5 hover:text-accent\" href=\"/benefits/\">Benefits</a><a class=\"block py-1.5 hover:text-accent\" href=\"/pricing/\">Pricing</a><a class=\"block py-1.5 hover:text-accent\" href=\"/integrations/\">Integrations</a></div></div><div><h4 class=\"mb-3 text-[14px] font-bold text-ink\">Get started</h4><div class=\"flex flex-col\"><a class=\"block py-1.5 hover:text-accent\" href=\"/demo/\">Book a demo</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"block py-1.5 hover:text-accent\">Start free</a></di