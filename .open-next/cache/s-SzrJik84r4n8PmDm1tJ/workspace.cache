\"i\":0,\"children\":[\"$\",\"div\",null,{\"className\":\"card p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16px] font-bold\",\"children\":\"Is Workspace client-facing?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-muted\",\"children\":\"No. Workspace is your internal command center, only your team sees it. Client Space is a separate, standalone product for giving clients a portal of their own, you can add it, or use it without Workspace at all.\"}]]}]}],[\"$\",\"$L1f\",\"How is Workspace different from Client Space?\",{\"i\":1,\"children\":[\"$\",\"div\",null,{\"className\":\"card p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16px] font-bold\",\"children\":\"How is Workspace different from Client Space?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Workspace is where your firm runs internal work: projects, finances, billable timesheets, Business Brain AI, automations, and team management, all at $9 per seat/month. Client Space is a standalone branded client portal at $19 per client/month, giving each client their own isolated space with client-visible tasks, approvals, and sign-off. Bundle both for $24.99/month.\"}]]}]}],[\"$\",\"$L1f\",\"How many people can use Workspace?\",{\"i\":2,\"children\":[\"$\",\"div\",null,{\"className\":\"card p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16px] font-bold\",\"children\":\"How many people can use Workspace?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Workspace is $9 per seat per month with no seat cap. Add as many directors, managers, and ICs as your firm needs. See the pricing page for the latest details.\"}]]}]}],[\"$\",\"$L1f\",\"Can the AI draft client messages for a change request?\",{\"i\":3,\"children\":[\"$\",\"div\",null,{\"className\":\"card p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16px] font-bold\",\"children\":\"Can the AI draft client messages for a change request?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Yes. When you review a change request, you can generate an AI draft of the client message, then edit it before anything is sent.\"}]]}]}],[\"$\",\"$L1f\",\"What happens when a change request is approved?\",{\"i\":4,\"children\":[\"$\",\"div\",null,{\"className\":\"card p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16px] font-bold\",\"children\":\"What happens when a change request is approved?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-muted\",\"children\":\"On approval it becomes a change order: it amends the statement of work and updates the engagement budget, so your numbers stay accurate without manual rework.\"}]]}]}],[\"$\",\"$L1f\",\"How do I get my work into Workspace?\",{\"i\":5,\"children\":[\"$\",\"div\",null,{\"className\":\"card p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16px] font-bold\",\"children\":\"How do I get my work into Workspace?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Start from your goal and let the AI draft the plan, or build engagements directly. The point is to be running real work the same day, not setting up for weeks.\"}]]}]}],[\"$\",\"$L1f\",\"What happens after the free trial?\",{\"i\":6,\"children\":[\"$\",\"div\",null,{\"className\":\"card p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16px] font-bold\",\"children\":\"What happens after the free trial?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-muted\",\"children\":\"You can keep your firm on Workspace at $9 per seat/month, and add Client Space at $19 per client whenever you want a client portal, or bundle both for $24.99/month. See the pricing page for what each plan includes.\"}]]}]}],\"$L3c\"]}]]}]}]\n33:[\"$\",\"$L3d\",null,{}]\