\",\"meta\",\"10\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:image:alt\",\"content\":\"PYNGYN: Clientspace, a standalone branded client portal, and Workspace, a standalone back office for professional-services firms\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:site\",\"content\":\"@Pyngyn_Official\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:creator\",\"content\":\"@Pyngyn_Official\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:title\",\"content\":\"PYNGYN: The operating system for professional-services firms\"}],[\"$\",\"meta\",\"17\",{\"name\":\"twitter:description\",\"content\":\"Run your firm and every client engagement in one place. The operating system for professional-services firms.\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:image\",\"content\":\"https://pyngyn.ai/og.png\"}],[\"$\",\"link\",\"19\",{\"rel\":\"icon\",\"href\":\"/icon.png\"}],[\"$\",\"link\",\"20\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png\"}],[\"$\",\"$L3e\",\"21\",{}]]\n37:null\n","/workspace/__PAGE__":"1:\"$Sreact.fragment\"\n2:Tcfd,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://pyngyn.ai/workspace#webpage\",\"url\":\"https://pyngyn.ai/workspace\",\"name\":\"Workspace, your internal delivery command center | PYNGYN\",\"description\":\"Workspace is PYNGYN's operating system for professional-services firms: projects, finances, billable timesheets, Business Brain AI, automations, and team management at $9 per seat.\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"breadcrumb\":{\"@id\":\"https://pyngyn.ai/workspace#breadcrumb\"},\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/workspace#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\"