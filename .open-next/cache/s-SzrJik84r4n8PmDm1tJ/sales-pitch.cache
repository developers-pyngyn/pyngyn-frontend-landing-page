{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/sales-pitch/layout,_N_T_/sales-pitch/page,_N_T_/sales-pitch"},"segmentPaths":["/_tree","/_full","/sales-pitch/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"display_2a073e65-module__7MkqkG__variable jakarta_55fc869e-module__LB2P7q__variable mono_8ba1b3ff-module__cxzmQq__variable\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_400_normal-s.p.2_o2v7tpo0q5m.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_500_normal-s.p.3vqzgd2jdiw22.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_600_normal-s.p.3_r60-qkmao3a.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_700_normal-s.p.0rb33xx2bxpl8.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_400_normal-s.p.3crsbyy6lh6yf.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_500_normal-s.p.2h52d08o60qht.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_600_normal-s.p.2mm922pe315l1.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_400_normal-s.p.2ysn9gc82zk1v.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_500_normal-s.p.1evhelic1rxge.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_600_normal-s.p.0p6sew1q6gl7s.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_700_normal-s.p.1dulefe5e4s81.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"/logo.webp\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/02mkr0z8o939x.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1b-l3oagpuv39.js\"/><script src=\"/_next/static/chunks/11jq0c2_zavac.js\" async=\"\"></script><script src=\"/_next/static/chunks/4561u0v7ysn3r.js\" async=\"\"></script><script src=\"/_next/static/chunks/021sppg0zbt0v.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2pcc6e_qu_s3g.js\" async=\"\"></script><script src=\"/_next/static/chunks/0ht-3v40sanoo.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/41mnvtr75by45.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/1_p0c8_mtfqqv.js\" async=\"\" crossorigin=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Your firm&#x27;s knowledge, finally working for you | Pyngyn</title><meta name=\"description\" content=\"Pyngyn is the operating system for professional services firms, built for 15–30 person consulting teams who are tired of juggling 5 platforms just to deliver one engagement. This is a 20-minute conversation, not a pitch.\"/><meta name=\"author\" content=\"Nikunj Chugh\"/><meta name=\"creator\" content=\"Nikunj Chugh\"/><link rel=\"canonical\" href=\"https://pyngyn.ai/sales-pitch/\"/><meta property=\"og:title\" content=\"Pyngyn for PS firms, your knowledge, working for you\"/><meta property=\"og:description\" content=\"Built for 15–30 person consulting teams who are tired of juggling 5 platforms just to deliver one engagement.\"/><meta property=\"og:url\" content=\"https://pyngyn.ai/sales-pitch/\"/><meta property=\"og:image\" content=\"https://pyngyn.ai/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"PYNGYN: Clientspace, a standalone branded client portal, and Workspace, a standalone back office for professional-services firms\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:site\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:creator\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:title\" content=\"PYNGYN: The operating system for professional-services firms\"/><meta name=\"twitter:description\" content=\"Run your firm and every client engagement in one place. The operating system for professional-services firms.\"/><meta name=\"twitter:image\" content=\"https://pyngyn.ai/og.png\"/><link rel=\"icon\" href=\"/icon.png\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png\"/><script type=\"application/ld+json\" id=\"ld-organization\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://pyngyn.ai/#organization\",\"name\":\"PYNGYN\",\"legalName\":\"VIMOVI GlobalTech Private Limited\",\"url\":\"https://pyngyn.ai/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://pyngyn.ai/logo.png\",\"width\":512,\"height\":512},\"image\":\"https://pyngyn.ai/icon.png\",\"description\":\"PYNGYN gives every client a branded Client Space (a standalone portal for status, documents, and approvals), with Workspace, the firm's back office for projects, finances, and billable time, available on its own or bundled together.\",\"sameAs\":[\"https://x.com/Pyngyn_Official\",\"https://www.linkedin.com/company/pyngyn/\",\"https://www.reddit.com/user/Pyngyn_Official/\",\"https://www.facebook.com/profile.php?id=61584474731354\",\"https://www.youtube.com/@PyngynOfficial\",\"https://instagram.com/pyngyn_official\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"customer support\",\"email\":\"support@pyngyn.com\",\"url\":\"https://pyngyn.ai/support\",\"availableLanguage\":[\"English\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"sales@pyngyn.com\",\"url\":\"https://pyngyn.ai/demo\",\"availableLanguage\":[\"English\"]}]}</script><script type=\"application/ld+json\" id=\"ld-website\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://pyngyn.ai/#website\",\"url\":\"https://pyngyn.ai/\",\"name\":\"PYNGYN\",\"description\":\"The operating system for professional-services firms. Run your firm and every client engagement in one place.\",\"publisher\":{\"@id\":\"https://pyngyn.ai/#organization\"},\"inLanguage\":\"en\"}</script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-sans\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main\" class=\"sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white\">Skip to content</a><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://pyngyn.ai/sales-pitch#webpage\",\"url\":\"https://pyngyn.ai/sales-pitch\",\"name\":\"Your firm's knowledge, finally working for you | Pyngyn\",\"description\":\"A 20-minute conversation, not a pitch. Pyngyn for 15–30 person professional services firms.\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"breadcrumb\":{\"@id\":\"https://pyngyn.ai/sales-pitch#breadcrumb\"},\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/sales-pitch#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://pyngyn.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Sales Pitch\",\"item\":\"https://pyngyn.ai/sales-pitch\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://pyngyn.ai/sales-pitch#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"We already use Notion / ClickUp.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Those tools store documents or manage tasks. Pyngyn connects both to your AI and makes SOPs active in workflow. You'd still be using 3–4 other tools. Pyngyn replaces all of them.\"}},{\"@type\":\"Question\",\"name\":\"My team won't adopt another tool.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We hear this every time. Pyngyn is designed for day-one productivity, no training sessions, no thick documentation. Hand it to a new hire and they're productive within the hour.\"}},{\"@type\":\"Question\",\"name\":\"Is our data safe?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your firm's data is encrypted, stored securely, and never used to train general AI models. Your knowledge stays yours, it only makes your Pyngyn smarter.\"}},{\"@type\":\"Question\",\"name\":\"Does PYNGYN pay for itself?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"20 consultants × 35% time saved = significant recoverable hours every week. PYNGYN pays for itself well within the first month for most firms.\"}}]}]}</script><header class=\"fixed inset-x-0 top-0 z-[100] border-b transition-all duration-300 border-transparent bg-transparent\"><div class=\"wrap flex h-[68px] items-center justify-between\"><a class=\"flex items-center\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><div class=\"hidden h-full lg:flex lg:items-center\"><nav class=\"flex items-center gap-7 text-[15px] text-[#3a3a42]\"><a class=\"py-2 transition-colors hover:text-accent\" href=\"/clientspace/\">Clientspace</a><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Product<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Solutions<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Resources<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Compare<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></nav></div><div class=\"flex items-center gap-3\"><a href=\"https://app.pyngyn.ai/\" class=\"hidden text-[15px] font-semibold lg:inline \">Sign in</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"hidden px-4 py-2.5 lg:inline-flex btn btn-ghost\">Start free</a><a href=\"/demo\" class=\"hidden px-[18px] py-2.5 lg:inline-flex btn btn-primary\">Book a demo</a><button type=\"button\" class=\"grid h-10 w-10 place-items-center rounded-lg border lg:hidden border-line bg-white text-ink\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"mobile-menu\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"></path></svg></button></div></div></header><main id=\"main\"><section class=\"wrap pb-[20px] pt-[150px]\"><span class=\"eyebrow\">Sales pitch · 20 min</span><h1 class=\"mt-3 max-w-[920px] font-display text-[clamp(34px,5.2vw,60px)] font-semibold leading-[1.04] tracking-[-0.025em]\">Your firm&#x27;s knowledge,<!-- --> <span class=\"text-accent\">finally working for you.</span></h1><p class=\"lead mt-5 max-w-[760px]\">Pyngyn is the operating system for professional services firms, built for 15–30 person consulting teams who are tired of juggling 5 platforms just to deliver one engagement.</p><p class=\"mt-3 max-w-[680px] text-[14.5px] text-muted\">This is a 20-minute conversation, not a pitch. Let me show you what your team&#x27;s day could look like.</p><div class=\"mt-7 flex flex-wrap items-center gap-3.5\"><a class=\"btn btn-primary\" href=\"/demo/\">Book a 30-min demo →</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-ghost\">Start a 30-day free trial</a></div><div class=\"mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4\"><div class=\"card\"><div class=\"font-display text-[30px] font-semibold leading-none tracking-[-0.02em]\">35%</div><div class=\"mt-2 text-[13.5px] text-muted\">Of your day lost to tool-switching</div></div><div class=\"card\"><div class=\"font-display text-[30px] font-semibold leading-none tracking-[-0.02em]\">5+</div><div class=\"mt-2 text-[13.5px] text-muted\">Platforms to complete one engagement</div></div><div class=\"card\"><div class=\"font-display text-[30px] font-semibold leading-none tracking-[-0.02em]\">2x</div><div class=\"mt-2 text-[13.5px] text-muted\">Task completion with Pyngyn</div></div><div class=\"card\"><div class=\"font-display text-[30px] font-semibold leading-none tracking-[-0.02em]\">$9</div><div class=\"mt-2 text-[13.5px] text-muted\">Per seat / month. Cancel anytime.</div></div></div><div class=\"mt-5 text-[13.5px] text-muted\">Vivek Pandey ·<!-- --> <a class=\"text-accent hover:underline\" href=\"mailto:vivek.pandey@pyngyn.com\">vivek.pandey@pyngyn.com</a> <!-- -->· pyngyn.ai</div></section><section class=\"wrap py-[40px]\"><span class=\"eyebrow\">Let&#x27;s start here</span><h2 class=\"mt-3 max-w-[820px] font-display text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em]\">Think about last Monday morning.</h2><ol class=\"mt-7 space-y-2.5\"><li class=\"flex items-start gap-4 rounded-2xl border border-line bg-white p-4 shadow-card\"><span class=\"w-[78px] flex-none text-[13px] font-mono font-semibold uppercase tracking-wide text-muted\">8:45 am</span><span class=\"text-[18px]\" aria-hidden=\"true\">📱</span><span class=\"text-[14.5px] leading-relaxed text-ink\">Opened WhatsApp to find 47 messages from 3 different client threads.</span></li><li class=\"flex items-start gap-4 rounded-2xl border border-line bg-white p-4 shadow-card\"><span class=\"w-[78px] flex-none text-[13px] font-mono font-semibold uppercase tracking-wide text-muted\">9:10 am</span><span class=\"text-[18px]\" aria-hidden=\"true\">💻</span><span class=\"text-[14.5px] leading-relaxed text-ink\">Spent 20 minutes hunting for the proposal draft, was it in Google Drive, Notion, or email?</span></li><li class=\"flex items-start gap-4 rounded-2xl border border-line bg-white p-4 shadow-card\"><span class=\"w-[78px] flex-none text-[13px] font-mono font-semibold uppercase tracking-wide text-muted\">9:35 am</span><span class=\"text-[18px]\" aria-hidden=\"true\">🔄</span><span class=\"text-[14.5px] leading-relaxed text-ink\">New consultant asked where the SOPs are. You said &#x27;check Notion&#x27;, they&#x27;re outdated.</span></li><li class=\"flex items-start gap-4 rounded-2xl border border-line bg-white p-4 shadow-card\"><span class=\"w-[78px] flex-none text-[13px] font-mono font-semibold uppercase tracking-wide text-muted\">10:00 am</span><span class=\"text-[18px]\" aria-hidden=\"true\">📊</span><span class=\"text-[14.5px] leading-relaxed text-ink\">Client asked for a status update. You had to ping 3 people to piece together an answer.</span></li><li class=\"flex items-start gap-4 rounded-2xl border border-line bg-white p-4 shadow-card\"><span class=\"w-[78px] flex-none text-[13px] font-mono font-semibold uppercase tracking-wide text-muted\">10:30 am</span><span class=\"text-[18px]\" aria-hidden=\"true\">😤</span><span class=\"text-[14.5px] leading-relaxed text-ink\">First 2 hours gone. Zero billable work done. This is the fragmentation tax.</span></li></ol></section><section class=\"wrap py-[40px]\"><span class=\"eyebrow\">The real cost</span><h2 class=\"mt-3 max-w-[820px] font-display text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em]\">This isn&#x27;t a productivity problem.<!-- --> <span class=\"text-accent\">It&#x27;s a fragmentation tax.</span></h2><div class=\"mt-7 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-4\"><div class=\"card h-full\"><div class=\"font-display text-[30px] font-semibold leading-none tracking-[-0.02em] text-accent\">35%</div><div class=\"mt-3 text-[15px] font-bold text-ink\">Of every workday</div><div class=\"mt-1.5 text-[13.5px] leading-relaxed text-muted\">Lost to switching between tools, searching for context, and repeating information across platforms.</div></div><div class=\"card h-full\"><div class=\"font-display text-[30px] font-semibold leading-none tracking-[-0.02em] text-accent\">35%</div><div class=\"mt-3 text-[15px] font-bold text-ink\">Hours lost per week</div><div class=\"mt-1.5 text-[13.5px] leading-relaxed text-muted\">At a blended billing rate of $150/hour × 35% time lost, a 20-person firm loses over $200K in recoverable hours annually.</div></div><div class=\"card h-full\"><div class=\"font-display text-[30px] font-semibold leading-none tracking-[-0.02em] text-accent\">95%</div><div class=\"mt-3 text-[15px] font-bold text-ink\">Team misalignment</div><div class=\"mt-1.5 text-[13.5px] leading-relaxed text-muted\">Teams work from different versions of the same information. Proposals, SOPs, client history, all fragmented.</div></div><div class=\"card h-full\"><div class=\"font-display text-[30px] font-semibold leading-none tracking-[-0.02em] text-accent\">30%</div><div class=\"mt-3 text-[15px] font-bold text-ink\">Tool adoption rate</div><div class=\"mt-1.5 text-[13.5px] leading-relaxed text-muted\">Of the enterprise tools firms invest in, only 30% of the team actively uses them after 3 months.</div></div></div></section><section class=\"wrap py-[40px]\"><span class=\"eyebrow\">The solution</span><h2 class=\"mt-3 max-w-[820px] font-display text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em]\">One place for everything your firm knows and does.</h2><div class=\"mt-8 grid gap-[22px] md:grid-cols-3\"><div class=\"card h-full\"><div class=\"inline-flex h-8 items-center rounded-md bg-accent-lt px-2.5 font-mono text-[12px] font-bold tracking-[0.12em] text-accent-dk\">KM</div><h3 class=\"mt-3 text-[18px] font-bold\">Knowledge management</h3><div class=\"text-[13.5px] font-semibold text-accent\">Your firm&#x27;s brain, always on.</div><p class=\"mt-3 text-[14.5px] leading-relaxed text-muted\">Every proposal, SOP, framework, and client history, organized and searchable. The new consultant finds it in 30 seconds, not 30 minutes.</p><div class=\"mt-5 grid grid-cols-2 gap-3\"><div class=\"rounded-xl border border-line bg-[#fbfbfd] p-3\"><div class=\"text-[11px] font-semibold uppercase tracking-wide text-muted\">Before</div><div class=\"mt-1 text-[13px] text-ink\">SOPs in Notion nobody reads</div></div><div class=\"rounded-xl border border-accent/30 bg-accent-lt p-3\"><div class=\"text-[11px] font-semibold uppercase tracking-wide text-accent-dk\">After</div><div class=\"mt-1 text-[13px] text-ink\">SOPs that surface when needed</div></div></div></div><div class=\"card h-full\"><div class=\"inline-flex h-8 items-center rounded-md bg-accent-lt px-2.5 font-mono text-[12px] font-bold tracking-[0.12em] text-accent-dk\">AI</div><h3 class=\"mt-3 text-[18px] font-bold\">AI that knows your firm</h3><div class=\"text-[13.5px] font-semibold text-accent\">Not ChatGPT. Your co-pilot.</div><p class=\"mt-3 text-[14.5px] leading-relaxed text-muted\">AI trained on your own SOPs, client history, and workflows, not generic prompts. It knows your firm, your clients, your way of working.</p><div class=\"mt-5 grid grid-cols-2 gap-3\"><div class=\"rounded-xl border border-line bg-[#fbfbfd] p-3\"><div class=\"text-[11px] font-semibold uppercase tracking-wide text-muted\">Before</div><div class=\"mt-1 text-[13px] text-ink\">Generic AI that knows nothing</div></div><div class=\"rounded-xl border border-accent/30 bg-accent-lt p-3\"><div class=\"text-[11px] font-semibold uppercase tracking-wide text-accent-dk\">After</div><div class=\"mt-1 text-[13px] text-ink\">AI trained on your context</div></div></div></div><div class=\"card h-full\"><div class=\"inline-flex h-8 items-center rounded-md bg-accent-lt px-2.5 font-mono text-[12px] font-bold tracking-[0.12em] text-accent-dk\">CO</div><h3 class=\"mt-3 text-[18px] font-bold\">Collaboration</h3><div class=\"text-[13.5px] font-semibold text-accent\">One source of truth. Always.</div><p class=\"mt-3 text-[14.5px] leading-relaxed text-muted\">Tasks, updates, and decisions in one shared space. Every consultant aligned, without pinging 3 people for a status update.</p><div class=\"mt-5 grid grid-cols-2 gap-3\"><div class=\"rounded-xl border border-line bg-[#fbfbfd] p-3\"><div class=\"text-[11px] font-semibold uppercase tracking-wide text-muted\">Before</div><div class=\"mt-1 text-[13px] text-ink\">WhatsApp + email + Slack</div></div><div class=\"rounded-xl border border-accent/30 bg-accent-lt p-3\"><div class=\"text-[11px] font-semibold uppercase tracking-wide text-accent-dk\">After</div><div class=\"mt-1 text-[13px] text-ink\">One place. Everyone aligned.</div></div></div></div></div><p class=\"mt-6 text-[14px] text-muted\">Built specifically for 15–30 person professional services and consulting firms. Not another horizontal tool.</p></section><section class=\"wrap py-[40px]\"><span class=\"eyebrow\">What your Monday looks like with Pyngyn</span><h2 class=\"mt-3 max-w-[820px] font-display text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em]\">Same team. Same clients. Zero fragmentation.</h2><ol class=\"mt-7 space-y-2.5\"><li class=\"flex items-start gap-4 rounded-2xl border border-line bg-white p-4 shadow-card\"><span class=\"w-[78px] flex-none text-[13px] font-mono font-semibold uppercase tracking-wide text-muted\">8:45 am</span><span class=\"grid h-6 w-6 flex-none place-items-center rounded-full bg-positive/10 text-[12px] font-bold text-positive\">✓</span><span class=\"text-[14.5px] leading-relaxed text-ink\">Open Pyngyn. One dashboard shows all active engagements, pending tasks, and team updates. No WhatsApp hunting.</span></li><li class=\"flex items-start gap-4 rounded-2xl border border-line bg-white p-4 shadow-card\"><span class=\"w-[78px] flex-none text-[13px] font-mono font-semibold uppercase tracking-wide text-muted\">9:05 am</span><span class=\"grid h-6 w-6 flex-none place-items-center rounded-full bg-positive/10 text-[12px] font-bold text-positive\">✓</span><span class=\"text-[14.5px] leading-relaxed text-ink\">New consultant onboards. Finds all SOPs, client history, and playbooks in one place. Productive in 2 hours, not 2 weeks.</span></li><li class=\"flex items-start gap-4 rounded-2xl border border-line bg-white p-4 shadow-card\"><span class=\"w-[78px] flex-none text-[13px] font-mono font-semibold uppercase tracking-wide text-muted\">9:25 am</span><span class=\"grid h-6 w-6 flex-none place-items-center rounded-full bg-positive/10 text-[12px] font-bold text-positive\">✓</span><span class=\"text-[14.5px] leading-relaxed text-ink\">Client asks for status update. You open the engagement view, everything is there. Answer in 60 seconds.</span></li><li class=\"flex items-start gap-4 rounded-2xl border border-line bg-white p-4 shadow-card\"><span class=\"w-[78px] flex-none text-[13px] font-mono font-semibold uppercase tracking-wide text-muted\">9:45 am</span><span class=\"grid h-6 w-6 flex-none place-items-center rounded-full bg-positive/10 text-[12px] font-bold text-positive\">✓</span><span class=\"text-[14.5px] leading-relaxed text-ink\">AI suggests the right SOP as you create a new task. It already knows your firm&#x27;s way of handling this type of engagement.</span></li><li class=\"flex items-start gap-4 rounded-2xl border border-line bg-white p-4 shadow-card\"><span class=\"w-[78px] flex-none text-[13px] font-mono font-semibold uppercase tracking-wide text-muted\">10:00 am</span><span class=\"grid h-6 w-6 flex-none place-items-center rounded-full bg-positive/10 text-[12px] font-bold text-positive\">🐧</span><span class=\"text-[14.5px] leading-relaxed text-ink\">Entire team is aligned. Knowledge is live. First 2 hours = 2 hours of billable work. That&#x27;s the Pyngyn difference.</span></li></ol></section><section class=\"wrap py-[40px]\"><span class=\"eyebrow\">Why not Notion, ClickUp or others?</span><h2 class=\"mt-3 max-w-[820px] font-display text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em]\">They built for everyone. We built for you.</h2><div class=\"mt-7 overflow-hidden rounded-2xl border border-line bg-white shadow-card\"><div class=\"overflow-x-auto\"><table class=\"w-full min-w-[680px] text-left text-[14.5px]\"><thead class=\"bg-[#fbfbfd] text-[12px] uppercase tracking-wide text-muted\"><tr><th class=\"px-5 py-3 font-semibold \">What you need</th><th class=\"px-5 py-3 font-semibold text-accent-dk\">Pyngyn</th><th class=\"px-5 py-3 font-semibold \">Notion</th><th class=\"px-5 py-3 font