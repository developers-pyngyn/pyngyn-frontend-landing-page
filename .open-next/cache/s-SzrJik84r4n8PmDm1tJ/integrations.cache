ools your firm already runs on. Plans, status, and approvals flow in automatically, and the result shows up live in your clients' Clientspace, no manual updates required.\"}]]}],[\"$\",\"$L1e\",null,{}],[\"$\",\"section\",null,{\"className\":\"section-tight\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap max-w-[820px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-[22px] border border-accent/30 bg-accent-lt px-7 py-9 sm:px-9\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dot\",\"aria-hidden\":\"true\"}],\"How it fits together\"]}],[\"$\",\"h2\",null,{\"className\":\"mt-3 font-display text-[22px] font-semibold leading-snug tracking-[-0.01em] sm:text-[26px]\",\"children\":\"Integrations feed Workspace. Workspace feeds Clientspace.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 max-w-[640px] text-[15px] leading-relaxed text-muted\",\"children\":\"A signed DocuSign envelope, a synced QuickBooks invoice, a Slack update, all of it lands in Workspace first. From there it surfaces automatically in the specific client's Clientspace, standalone or bundled, so nobody on your team has to re-type a status update just because the source system changed.\"}]]}]}]}],[\"$\",\"$L1f\",null,{}]]}]\n13:[\"$\",\"$L20\",null,{}]\n14:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/42f271k5brces.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n15:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n16:[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/41mnvtr75by45.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n17:[\"$\",\"$L21\",null,{\"children\":[\"$\",\"$1b\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@22\"}]}]\n19:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n23:I[27201,[\"/_next/st