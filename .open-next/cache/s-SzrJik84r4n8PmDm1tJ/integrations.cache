y=\"10\" width=\"32\" height=\"30\" rx=\"3\" fill=\"#fff\" stroke=\"#4285f4\" stroke-width=\"3\"></rect><rect x=\"8\" y=\"10\" width=\"32\" height=\"8\" rx=\"3\" fill=\"#4285f4\"></rect><text x=\"24\" y=\"34\" text-anchor=\"middle\" fill=\"#4285f4\" font-size=\"14\" font-weight=\"700\" font-family=\"Arial\">31</text></svg></span>Google Calendar</span><span class=\"flex items-center gap-2 rounded-full border border-line bg-white px-3.5 py-2 text-[14px] font-semibold shadow-card\"><span class=\"grid h-5 w-5 place-items-center\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 100 20 10 10 0 000-20zM8 9l8 6M16 9l-8 6\" stroke=\"#13b5ea\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span>Xero</span><span class=\"flex items-center gap-2 rounded-full border border-line bg-white px-3.5 py-2 text-[14px] font-semibold shadow-card\"><span class=\"grid h-5 w-5 place-items-center\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7 12h3M14 8.5l3 2.2M14 15.5l3-2.2\" stroke=\"#ea4b71\" stroke-width=\"1.6\" stroke-linecap=\"round\" fill=\"none\"></path><circle cx=\"5\" cy=\"12\" r=\"2.4\" fill=\"#ea4b71\"></circle><circle cx=\"12\" cy=\"7\" r=\"2.4\" fill=\"#ea4b71\"></circle><circle cx=\"12\" cy=\"17\" r=\"2.4\" fill=\"#ea4b71\"></circle><circle cx=\"19\" cy=\"12\" r=\"2.4\" fill=\"#ea4b71\"></circle></svg></span>n8n</span></div></div><div class=\"mt-10 flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between\"><div class=\"relative w-full lg:max-w-[340px]\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" class=\"pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-muted\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\" stroke=\"currentColor\" stroke-width=\"2\"></circle><path d=\"M20 20l-3-3\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"></path></svg><input type=\"text\" placeholder=\"Search integrations\" aria-label=\"Search integrations\" class=\"w-full rounded-full border border-line bg-white py-3 pl-11 pr-4 text-[15px] outline-none focus-visible:border-accent\" value=\"\"/></div></div><div class=\"mt-5 flex flex-wrap gap-2\"><button type=\"button\" class=\"rounded-full border px-3.5 py-1.5 text-[13px] font-semibold transition-colors border-ink bg-ink text-white\">All</button><button type=\"button\" class=\"rounded-full border px-3.5 py-1.5 text-[13px] font-semibold transition-colors border-line bg-white text-muted hover:border-accent hover:text-accent\">Communication</button><button type=\"button\" class=\"rounded-full border px-3.5 py-1.5 text-[13px] font-semibold transition-colors border-line bg-white text-muted hover:border-accent hover:text-accent\">Files</button><button type=\"button\" class=\"rounded-full border px-3.5 py-1.5 text-[13px] font-semibold transition-colors border-line bg-white text-muted hover:border-accent hover:text-accent\">Calendar</button><button type=\"button\" class=\"rounded-full border px-3.5 py-1.5 text-[13px] font-semibold transition-colors border-line bg-white text-muted hover:border-accent hover:text-accent\">Accounting &amp; Billing</button><button type=\"button\" class=\"rounded-full border px-3.5 py-1.5 text-[13px] font-semibold transition-colors border-line bg-white text-muted hover:border-accent hover:text-accent\">Productivity</button><button type=\"button\" class=\"rounded-full border px-3.5 py-1.5 text-[13px] font-semibold transition-colors border-line bg-white text-muted hover:border-accent hover:text-accent\">CRM &amp; Sales</button><button type=\"button\" class=\"rounded-full border px-3.5 py-1.5 text-[13px] font-semibold transition-colors border-line bg-white text-muted hover:border-accent hover:text-accent\">Analytics</button><button type=\"button\" class=\"rounded-full border px-3.5 py-1.5 text-[13px] font-semibold transition-colors border-line bg-white text-muted hover:border-accent hover:text-accent\">Automation</button></div><div class=\"mt-8 text-[13px] text-muted\">26<!-- --> integrations</div><div class=\"mt-4 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-3\"><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"#36c5f0\" d=\"M6.8 14.7a2 2 0 11-2-2h2v2zm1 0a2 2 0 014 0v5a2 2 0 11-4 0v-5z\"></path><path fill=\"#2eb67d\" d=\"M9.8 6.8a2 2 0 11-2-2 2 2 0 012 2zm0 1a2 2 0 010 4h-5a2 2 0 110-4h5z\"></path><path fill=\"#ecb22e\" d=\"M17.2 9.8a2 2 0 112-2v2h-2zm-1 0a2 2 0 01-4 0v-5a2 2 0 114 0v5z\"></path><path fill=\"#e01e5a\" d=\"M14.2 17.2a2 2 0 112 2 2 2 0 01-2-2zm0-1a2 2 0 010-4h5a2 2 0 110 4h-5z\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Slack</div><div class=\"text-[12px] text-muted\">Communication</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Turn requests and action items from Slack into trackable tasks, and push status back.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"#4285f4\" d=\"M21.4 19h-2.9V9.9l-6.5 4.9-6.5-4.9V19H2.6c-.6 0-1-.5-1-1V6c0-.7.8-1.1 1.4-.7l9 6.8 9-6.8c.6-.4 1.4 0 1.4.7v12c0 .5-.4 1-1 1z\"></path><path fill=\"#34a853\" d=\"M1.6 18V6.6L5.5 9.5V19H2.6c-.6 0-1-.4-1-1z\"></path><path fill=\"#fbbc04\" d=\"M22.4 18c0 .6-.4 1-1 1h-2.9V9.5l3.9-2.9z\"></path><path fill=\"#ea4335\" d=\"M1.6 6c0-.7.8-1.1 1.4-.7l9 6.8 9-6.8c.6-.4 1.4 0 1.4.7l-1.4 1L12 14.8 2.6 6.7z\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Gmail</div><div class=\"text-[12px] text-muted\">Communication</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Turn emails into tasks without leaving your inbox, and keep status in sync.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 100 20 10 10 0 000-20zm1 4v2.2a3.8 3.8 0 010 7.4V18h-2v-2.2a3.8 3.8 0 010-7.4V6z\" stroke=\"#2ca01c\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">QuickBooks</div><div class=\"text-[12px] text-muted\">Accounting &amp; Billing</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Sync clients, invoices, and time entries so billable work flows into your books, and invoice status appears in the client&#x27;s Clientspace automatically.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7 3h7l4 4v14H7zM14 3v4h4M9 11h6M9 15h4\" stroke=\"#e42527\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Zoho Books</div><div class=\"text-[12px] text-muted\">Accounting &amp; Billing</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Sync clients, invoices, and payments with Zoho Books so billable work stays reconciled, and invoice status appears in the client&#x27;s Clientspace automatically.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7 3h7l4 4v14H7zM14 3v4h4M9 15l2 2 4-5\" stroke=\"#0b5cab\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Computax</div><div class=\"text-[12px] text-muted\">Accounting &amp; Billing</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Keep return filings and computation status tied to the underlying engagement, so your team and the client both see where a filing stands.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 48 48\" aria-hidden=\"true\"><rect x=\"8\" y=\"10\" width=\"32\" height=\"30\" rx=\"3\" fill=\"#fff\" stroke=\"#4285f4\" stroke-width=\"3\"></rect><rect x=\"8\" y=\"10\" width=\"32\" height=\"8\" rx=\"3\" fill=\"#4285f4\"></rect><text x=\"24\" y=\"34\" text-anchor=\"middle\" fill=\"#4285f4\" font-size=\"14\" font-weight=\"700\" font-family=\"Arial\">31</text></svg></span><div><div class=\"text-[16px] font-bold\">Google Calendar</div><div class=\"text-[12px] text-muted\">Calendar</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Sync deadlines and client milestones so timelines live where your firm plans the day, and upcoming sessions appear automatically in the client&#x27;s Clientspace.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 100 20 10 10 0 000-20zM8 9l8 6M16 9l-8 6\" stroke=\"#13b5ea\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Xero</div><div class=\"text-[12px] text-muted\">Accounting &amp; Billing</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Push approved time and expenses to Xero and keep invoicing in sync with delivered work, visible to the client in Clientspace as soon as it&#x27;s approved.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 5h16v10H8l-4 4V5z\" stroke=\"#4f46e5\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Microsoft Teams</div><div class=\"text-[12px] text-muted\">Communication</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Bring conversations into actionable items and post status to your channels.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 6h18v12H3V6zm0 1l9 6 9-6\" stroke=\"#4f46e5\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Outlook</div><div class=\"text-[12px] text-muted\">Communication, Calendar</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Turn emails into work and sync meetings and deadlines to your plan.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M8 4h8l4 7-4 7H8l-4-7z\" stroke=\"#6b7280\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Google Drive</div><div class=\"text-[12px] text-muted\">Files</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Attach Drive files to tasks and keep work and docs connected.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M6 4l6 4-6 4-6-4zM18 4l6 4-6 4-6-4M6 12l6 4-6 4-6-4M18 12l6 4-6 4-6-4\" stroke=\"#6b7280\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Dropbox</div><div class=\"text-[12px] text-muted\">Files</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Attach Dropbox files to tasks and automate uploads with rules.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7 3h7l4 4v14H7zM14 3v4h4M9 14c2-3 4 3 6 0\" stroke=\"#d4b106\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">DocuSign</div><div class=\"text-[12px] text-muted\">Files</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Send engagement letters and approvals for e-signature. Status tracks against the matter in Workspace and updates the client&#x27;s Clientspace the moment it&#x27;s signed.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h11v10H4zM15 10l5-3v10l-5-3z\" stroke=\"#4f46e5\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Zoom</div><div class=\"text-[12px] text-muted\">Communication</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Make meetings actionable with tasks and searchable transcripts.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 2a3 3 0 000 6 3 3 0 100 6 3 3 0 100 6M12 2a3 3 0 010 6M12 8a3 3 0 110 6\" stroke=\"#6b7280\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Figma</div><div class=\"text-[12px] text-muted\">Productivity</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Share design work with live Figma embeds inside your tasks.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7 14a4 4 0 01.5-8 5 5 0 019.3-1A4 4 0 1118 17H8a3 3 0 01-1-3z\" stroke=\"#4f46e5\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Salesforce</div><div class=\"text-[12px] text-muted\">CRM &amp; Sales</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Streamline collaboration across the sales cycle and sync key records.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 7v4m0 0a3 3 0 103 3M12 11a3 3 0 11-3 3M12 3v2M12 5a2 2 0 100 4 2 2 0 000-4z\" stroke=\"#4f46e5\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">HubSpot</div><div class=\"text-[12px] text-muted\">CRM &amp; Sales</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">View deals and campaign info in tasks and automate updates.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 8h14M5 12h14M5 16h9\" stroke=\"#635bff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Stripe</div><div class=\"text-[12px] text-muted\">Accounting &amp; Billing</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Bill clients and collect retainer and invoice payments, with status synced back to the engagement.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 3v18M3 12h18M6 6l12 12M18 6L6 18\" stroke=\"#4f46e5\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Zapier</div><div class=\"text-[12px] text-muted\">Automation</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Connect PYNGYN to thousands of apps and automate repetitive work.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7 12h3M14 8.5l3 2.2M14 15.5l3-2.2\" stroke=\"#ea4b71\" stroke-width=\"1.6\" stroke-linecap=\"round\" fill=\"none\"></path><circle cx=\"5\" cy=\"12\" r=\"2.4\" fill=\"#ea4b71\"></circle><circle cx=\"12\" cy=\"7\" r=\"2.4\" fill=\"#ea4b71\"></circle><circle cx=\"12\" cy=\"17\" r=\"2.4\" fill=\"#ea4b71\"></circle><circle cx=\"19\" cy=\"12\" r=\"2.4\" fill=\"#ea4b71\"></circle></svg></span><div><div class=\"text-[16px] font-bold\">n8n</div><div class=\"text-[12px] text-muted\">Automation</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Self-host or cloud, wire PYNGYN into 400+ apps with branching workflows, custom code, and webhooks. Built for teams that want to own their automations.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 12l3-6 4 12 4-12 3 6\" stroke=\"#6b7280\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Make</div><div class=\"text-[12px] text-muted\">Automation</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Build visual automations between PYNGYN and the tools you use.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7 3h7l4 4v14H7zM14 3v4h4M9 12h6M9 16h6\" stroke=\"#0f9d58\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Google Sheets</div><div class=\"text-[12px] text-muted\">Analytics, Productivity</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Sync project data to Sheets and build custom reports.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 20V10M10 20V4M15 20v-8M20 20V7\" stroke=\"#f2b900\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Power BI</div><div class=\"text-[12px] text-muted\">Analytics</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Bring your team&#x27;s project data to life with live dashboards.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 3v18M3 12h18M7 7v10M17 7v10\" stroke=\"#4f46e5\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Tableau</div><div class=\"text-[12px] text-muted\">Analytics</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Explore and share real-time analytics from your project data.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 12a3 3 0 116 0M12 9V3M5 19l4-7M19 19l-4-7\" stroke=\"#6b7280\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Webhooks</div><div class=\"text-[12px] text-muted\">Automation</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Trigger your own services on any event with outgoing webhooks.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7 3h7l4 4v14H7zM14 3v4h4M9 12h6M9 16h4\" stroke=\"#4285f4\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Google Docs</div><div class=\"text-[12px] text-muted\">Files, Productivity</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Add context from Docs right into the flow of your work.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div><div class=\"flex h-full flex-col rounded-[18px] border border-line bg-white p-5 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft\"><div class=\"flex items-center gap-3\"><span class=\"grid h-11 w-11 place-items-center rounded-xl border border-line\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 6h16v14H4zM4 10h16M8 3v4M16 3v4\" stroke=\"#4f46e5\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span><div><div class=\"text-[16px] font-bold\">Calendly</div><div class=\"text-[12px] text-muted\">Calendar</div></div></div><p class=\"mt-3.5 flex-1 text-[14px] leading-relaxed text-muted\">Turn booked meetings into scheduled work automatically.</p><a href=\"/demo\" class=\"mt-4 inline-flex items-center gap-1 text-[14px] font-semibold text-accent\">Learn more →</a></div></div><div class=\"mt-14 flex flex-col items-center gap-4 rounded-[22px] border border-line bg-[#fbfbfd] p-10 text-center\"><h2 class=\"font-display text-[26px] font-semibold tracking-[-0.02em]\">Don&#x27;t see your tool?</h2><p class=\"max-w-[460px] text-[15px] text-muted\">We&#x27;re adding integrations all the time, and our API lets you connect anything. Tell us what you use and we&#x27;ll help you wire it up.</p><a href=\"/demo\" class=\"btn btn-primary mt-1\">Talk to us →</a></div></div><section class=\"section-tight\"><div class=\"wrap max-w-[820px]\"><div class=\"rounded-[22px] border border-accent/30 bg-accent-lt px-7 py-9 sm:px-9\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>How it fits together</span><h2 class=\"mt-3 font-display text-[22px] font-semibold leading-snug tracking-[-0.01em] sm:text-[26px]\">Integrations feed Workspace. Workspace feeds Clientspace.</h2><p class=\"mt-3 max-w-[640px] text-[15px] leading-relaxed text-muted\">A signed DocuSign envelope, a synced QuickBooks invoice, a Slack update, all of it lands in Workspace first. From there it surfaces automatically in the specific client&#x27;s Clientspace, standalone or bundled, so nobody on your team has to re-type a status update just because the source system changed.</p></div></div></section><section id=\"demo\" class=\"section\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"relative overflow-hidden rounded-[28px] border border-line bg-white px-7 py-[72px] text-center shadow-card\"><div class=\"pointer-events-none absolute -top-24 left-1/2 h-[420px] w-[420px] -translate-x-1/2 rounded-full bg-accent-lt opacity-70 blur-[80px]\" aria-hidden=\"true\"></div><span class=\"eyebrow relative\">Ready when you are</span><h2 class=\"title relative mx-auto mt-3.5 max-w-[680px] text-[clamp(30px,4.4vw,48px)]\">Stop managing the tool. Start shipping the work.</h2><p class=\"lead relative mx-auto mt-[18px]\">See PYNGYN run a real project in 30 minutes, and let AI handle the project management busywork.</p><div class=\"relative mt-[30px] flex flex-wrap items-center justify-center gap-3.5\"><a href=\"/demo\" class=\"btn btn-primary\">Book a demo →</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-ghost\">Start free</a></div><p class=\"relative mt-4 text-sm text-muted\">30-minute walkthrough · Tailored to your team · No commitment</p></div></div></div></section></main><footer class=\"border-t border-line bg-white pt-16 pb-10 text-sm text-muted\"><div class=\"wrap\"><div class=\"grid gap-10 lg:grid-cols-[1.4fr_repeat(5,1fr)]\"><div><a class=\"mb-4 inline-block\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" loading=\"lazy\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><p class=\"max-w-[230px] leading-relaxed\">The operating system for professional-services firms.</p><a href=\"https://play.google.com/store/apps/details?id=com.pyngyn.io&amp;hl=en_IN\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"mt-5 inline-flex items-center gap-2.5 rounded-xl border border-line bg-white px-4 py-2.5 transition-colors hover:border-accent\" aria-label=\"Get PYNGYN on Google Play\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3.6 2.3 13 12 3.6 21.7a1.4 1.4 0 0 1-.6-1.2V3.5c0-.5.2-.9.6-1.2z\" fill=\"#34a853\"></path><path d=\"M16.8 8.6 13 12 3.6 2.3c.4-.3.9-.3 1.4 0l8.8 5z\" fill=\"#ea4335\"></path><path d=\"M16.8 15.4 5 22c-.5.3-1 .3-1.4 0L13 12z\" fill=\"#fbbc04\"></path><path d=\"m16.8 8.6 4 2.3c.7.4.7 1.4 0 1.8l-4 2.7L13 12z\" fill=\"#4285f4\"></path></svg><span class=\"flex flex-col leading-tight\"><span class=\"text-[10px] uppercase tracking-wide text-muted\">Get it on</span><span class=\"text-[14px] font-bold text-ink\">Google Play</span></span></a></div><div class=\"flex flex-col gap-8\"><div><h4 class=\"mb-3 text-[14px] font-bold text-ink\">Product</h4><div class=\"flex flex-col\"><a class=\"block py-1.5 hover:text-accent\" href=\"/clientspace/\">Clientspace</a><a class=\"block py-1.5 hover:text-accent\" href=\"/workspace/\">Workspace</a><a class=\"block py-1.5 hover:text-accent\" href=\"/benefits/\">Benefits</a><a class=\"block py-1.5 hover:text-accent\" href=\"/pricing/\">Pricing</a><a class=\"block py-1.5 hover:text-accent\" href=\"/integrations/\">Integrations</a></div></div><div><h4 class=\"mb-3 text-[14px] font-bold text-ink\">Get started</h4><div class=\"flex flex-col\"><a class=\"block py-1.5 hover:text-accent\" href=\"/demo/\">Book a demo</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"block py-1.5 hover:text-accent\">Start free</a></div></div></div><div class=\"flex flex-col gap-8\"><div><h4 class=\"mb-3 text-[14px] font-bold text-ink\">Compare</h4><div class=\"flex flex-col\"><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/notion/\">vs Notion</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/sana-labs/\">vs Sana Labs</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/guru/\">vs Guru</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/atlas/\">vs Atlas</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/clickup/\">vs ClickUp</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/asana/\">vs Asana</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/jira/\">vs Jira</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/twenty/\">vs Twenty</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/wrike/\">vs Wrike</a><a class=\"block py-1.5 hover:text-accent\" href=\"/compare/\">All comparisons</a></div></div></div><div class=\"flex flex-col gap-8\"><div><h4 class=\"mb-3 text-[14px] font-bold text-ink\">Solutions</h4><div class=\"flex flex-col\"><a class=\"block py-1.5 hover:text-accent\" href=\"/solutions/lawyers/\">Lawyers</a><a class=\"block py-1.5 hover:text-accent\" href=\"/solutions/accountants/\">Accountants &amp; CAs</a><a class=\"block py-1.5 hover:text-accent\" href=\"/solutions/consultants/\">Marketing Consultants</a><a class=\"block py-1.5 hover:text-accent\" href=\"/solutions/creative-services/\">Creative Services</a><a class=\"block py-1.5 hover:text-accent\" hr