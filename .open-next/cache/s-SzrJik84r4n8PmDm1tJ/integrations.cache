stOrderAscending\",\"numberOfItems\":26,\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Slack\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Turn requests and action items from Slack into trackable tasks, and push status back.\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Gmail\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Turn emails into tasks without leaving your inbox, and keep status in sync.\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"QuickBooks\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Sync clients, invoices, and time entries so billable work flows into your books, and invoice status appears in the client's Clientspace automatically.\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Zoho Books\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Sync clients, invoices, and payments with Zoho Books so billable work stays reconciled, and invoice status appears in the client's Clientspace automatically.\"},{\"@type\":\"ListItem\",\"position\":5,\"name\":\"Computax\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Keep return filings and computation status tied to the underlying engagement, so your team and the client both see where a filing stands.\"},{\"@type\":\"ListItem\",\"position\":6,\"name\":\"Google Calendar\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Sync deadlines and client milestones so timelines live where your firm plans the day, and upcoming sessions appear automatically in the client's Clientspace.\"},{\"@type\":\"ListItem\",\"position\":7,\"name\":\"Xero\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Push approved time and expenses to Xero and keep invoicing in sync with delivered work, visible to the client in Clientspace as soon as it's approved.\"},{\"@type\":\"ListItem\",\"position\":8,\"name\":\"Microsoft Teams\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Bring conversations into actionable items and post status to your channels.\"},{\"@type\":\"ListItem\",\"position\":9,\"name\":\"Outlook\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Turn emails into work and sync meetings and deadlines to your plan.\"},{\"@type\":\"ListItem\",\"position\":10,\"name\":\"Google Drive\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Attach Drive files to tasks and keep work and docs connected.\"},{\"@type\":\"ListItem\",\"position\":11,\"name\":\"Dropbox\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Attach Dropbox files to tasks and automate uploads with rules.\"},{\"@type\":\"ListItem\",\"position\":12,\"name\":\"DocuSign\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Send engagement letters and approvals for e-signature. Status tracks against the matter in Workspace and updates the client's Clientspace the moment it's signed.\"},{\"@type\":\"ListItem\",\"position\":13,\"name\":\"Zoom\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Make meetings actionable with tasks and searchable transcripts.\"},{\"@type\":\"ListItem\",\"position\":14,\"name\":\"Figma\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Share design work with live Figma embeds inside your tasks.\"},{\"@type\":\"ListItem\",\"position\":15,\"name\":\"Salesforce\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Streamline collaboration across the sales cycle and sync key records.\"},{\"@type\":\"ListItem\",\"position\":16,\"name\":\"HubSpot\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"View deals and campaign info in tasks and automate updates.\"},{\"@type\":\"ListItem\",\"position\":17,\"name\":\"Stripe\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Bill clients and collect retainer and invoice payments, with status synced back to the engagement.\"},{\"@type\":\"ListItem\",\"position\":18,\"name\":\"Zapier\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Connect PYNGYN to thousands of apps and automate repetitive work.\"},{\"@type\":\"ListItem\",\"position\":19,\"name\":\"n8n\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Self-host or cloud, wire PYNGYN into 400+ apps with branching workflows, custom code, and webhooks. Built for teams that want to own their automations.\"},{\"@type\":\"ListItem\",\"position\":20,\"name\":\"Make\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Build visual automations between PYNGYN and the tools you use.\"},{\"@type\":\"ListItem\",\"position\":21,\"name\":\"Google Sheets\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Sync project data to Sheets and build custom reports.\"},{\"@type\":\"ListItem\",\"position\":22,\"name\":\"Power BI\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Bring your team's project data to life with live dashboards.\"},{\"@type\":\"ListItem\",\"position\":23,\"name\":\"Tableau\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Explore and share real-time analytics from your project data.\"},{\"@type\":\"ListItem\",\"position\":24,\"name\":\"Webhooks\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Trigger your own services on any event with outgoing webhooks.\"},{\"@type\":\"ListItem\",\"position\":25,\"name\":\"Google Docs\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Add context from Docs right into the flow of your work.\"},{\"@type\":\"ListItem\",\"position\":26,\"name\":\"Calendly\",\"url\":\"https://pyngyn.ai/integrations\",\"description\":\"Turn booked meetings into scheduled work automatically.\"}]}]}9:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"id\":\"$undefined\",\"dangerouslySetInnerHTML\":{\"__html\":\"$10\"}}],\"$L11\",\"$L12\",\"$L13\"],[\"$L14\",\"$L15\",\"$L16\"],\"$L17\"]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L18\",null,{\"children\":\"$L19\"}],[\"$\",\"d