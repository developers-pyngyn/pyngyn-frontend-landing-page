t\"]\n12:I[62319,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/2ku0n70s0e1dn.js\",\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"/_next/static/chunks/41mnvtr75by45.js\"],\"Navbar\"]\n1c:I[97367,[\"/_next/static/chunks/0ht-3v40sanoo.js\"],\"ViewportBoundary\"]\n1e:I[97367,[\"/_next/static/chunks/0ht-3v40sanoo.js\"],\"MetadataBoundary\"]\n1f:\"$Sreact.suspense\"\n6:[\"$\",\"$Lf\",null,{}]\n7:[\"$\",\"$L10\",null,{}]\n8:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n9:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n11:Ta5b,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://pyngyn.ai/tools/any-update-cost#webpage\",\"url\":\"https://pyngyn.ai/tools/any-update-cost\",\"name\":\"\\\"Any Update?\\\" Cost Calculator | PYNGYN\",\"description\":\"See what answering client status requests costs your firm every year, and how much a client portal could win back.\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"breadcrumb\":{\"@id\":\"https://pyngyn.ai/tools/any-update-cost#breadcrumb\"},\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/tools/any-update-cost#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://pyngyn.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tools\",\"item\":\"https://pyngyn.ai/tools\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"\\\"Any Update?\\\" Cost Calculator\",\"item\":\"https://pyngyn.ai/tools/any-update-cost\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://pyngyn.ai/tools/any-update-cost#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What does this calculator measure?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It estimates the annual cost of answering client status requests, emails, calls, and Slack pings asking where things stand, priced at your billable rate. It then shows how much of that you could win back with a client portal and the resulting return on investment.\"}},{\"@type\":\"Question\",\"name\":\"Where do the default numbers come from?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The defaults (1.5 status touches per client per week, 12 minutes per touch) reflect a typical services firm. Every input, including your billable rate and client count, is yours to adjust so the result reflects your firm.\"}},{\"@type\":\"Question\",\"name\":\"Why does the tool cost default to a per-client price instead of per-seat?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"This calculator models Clientspace, which is priced and sold per client, standalone, not per internal seat. That's different from PYNGYN's other free tools, which model Workspace at its per-seat price.\"}},{\"@type\":\"Question\",\"name\":\"Is the self-serve recovery rate realistic?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It's an assumption you control. The default of 70% is deliberately achievable, not every status question disappears, but most routine \\\"any update?\\\" asks do once clients can check their own portal. Lower it for a cautious estimate.\"}},{\"@type\":\"Question\",\"name\":\"Is the calculator free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, free with no signup. Adjust the inputs as many times as you like and copy a summary of the result. To see Clientspace set up on a real engagement of yours, book a demo.\"}}]}]}a:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"id\":\"$undefined\",\"dangerouslySetInnerHTML\":{\"__html\":\"$11\"}}],[\"$\",\"$L12\",null,{}],[\"$\",\"main\",null,{\"id\":\"main\",\"children\":[[\"$\",\"section\",null,{\"className\":\"wrap pb-[10px] pt-[140px] text-center\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dot\",\"aria-hidden\":\"true\"}],\"Free tool\"]}],[\"$\",\"h1\",null,{\"className\":\"mx-auto mt-3 max-w-[820px] font-display text-[clamp(34px,5vw,58px)] font-semibold leading-[1.04] tracking-[-0.025em]\",\"children\":\"What is “any update?” costing your firm?\"}],[\"$\",\"p\",null,{\"className\":\"lead mx-auto mt-5\",\"children\":\"Every client email and call asking for status is billable time spent on something other than the work. Put a number on it, then see what a client portal could win back. Free, no signup.\"}],\"$L13\"]}],\"$L14\",\"$L15\",\"$L16\"]}],\"$L17\"],[\"$L18\",\"$L19\",\"$L1a\"],\"$L1b\"]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L1c\",null,{\"children\":\"$L1d\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L1e\",null,{\"children\":[\"$\",\"$1f\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L20\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\ne:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/02mkr0z8o939x.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n21:I[30066,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/2ku0n70s0e1dn.js\",\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"/_next/static/chunks/41mnvtr75by45.js\"],\"AnyUpdateCostCalculator\"]\n23:I[56691,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/2ku0n70s0e1dn.js\",\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"