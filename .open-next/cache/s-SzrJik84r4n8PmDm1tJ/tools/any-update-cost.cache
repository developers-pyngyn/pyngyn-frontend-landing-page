 gap-6 border-t border-line pt-8\"><div class=\"flex items-center gap-3\"><a href=\"https://x.com/Pyngyn_Official\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"X (formerly Twitter)\" class=\"grid h-9 w-9 place-items-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-accent\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"></path></svg></a><a href=\"https://www.linkedin.com/company/pyngyn/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"LinkedIn\" class=\"grid h-9 w-9 place-items-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-accent\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M4.98 3.5a2 2 0 11-.02 4 2 2 0 01.02-4zM3 8.98h4V21H3zM10 8.98h3.8v1.64h.05c.53-1 1.83-2.06 3.76-2.06 4.02 0 4.76 2.65 4.76 6.1V21h-4v-5.36c0-1.28-.02-2.92-1.78-2.92-1.78 0-2.05 1.39-2.05 2.83V21h-4z\"></path></svg></a><a href=\"https://www.reddit.com/user/Pyngyn_Official/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Reddit\" class=\"grid h-9 w-9 place-items-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-accent\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M22 12a2.06 2.06 0 00-3.5-1.43 10 10 0 00-5.2-1.65l.9-4.16 2.9.65a1.5 1.5 0 101.5-1.55 1.5 1.5 0 00-1.34.83l-3.24-.72a.4.4 0 00-.47.3l-1 4.65a10.1 10.1 0 00-5.27 1.65 2.06 2.06 0 10-2.27 3.4 4 4 0 00-.05.6c0 3.04 3.54 5.5 7.9 5.5s7.9-2.46 7.9-5.5a4 4 0 00-.05-.6A2.06 2.06 0 0022 12zM7 13.5a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zm8.3 4.05c-1 1-3.07 1.08-3.3 1.08-.23 0-2.3-.07-3.3-1.08a.4.4 0 01.57-.57c.63.63 2 .86 2.73.