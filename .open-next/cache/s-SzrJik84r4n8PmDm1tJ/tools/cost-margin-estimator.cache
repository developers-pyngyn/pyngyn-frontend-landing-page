\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n9:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n11:Tc19,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://pyngyn.ai/tools/cost-margin-estimator#webpage\",\"url\":\"https://pyngyn.ai/tools/cost-margin-estimator\",\"name\":\"Project Cost & Margin Estimator | PYNGYN\",\"description\":\"Estimate cost to deliver, blended rate, and gross margin for a fixed-fee engagement before you quote.\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"breadcrumb\":{\"@id\":\"https://pyngyn.ai/tools/cost-margin-estimator#breadcrumb\"},\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/tools/cost-margin-estimator#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://pyngyn.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tools\",\"item\":\"https://pyngyn.ai/tools\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Project Cost & Margin Estimator\",\"item\":\"https://pyngyn.ai/tools/cost-margin-estimator\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://pyngyn.ai/tools/cost-margin-estimator#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What does the cost and margin estimator do?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It estimates the cost to deliver a fixed-fee engagement from the hours and cost rates of each role, adds any overhead and pass-through costs, and compares the total to your quoted fee. It returns gross margin in money and percent, your blended bill rate, and the breakeven fee.\"}},{\"@type\":\"Question\",\"name\":\"What is the difference between cost rate and bill rate?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Cost rate is what a person costs your firm per hour, fully loaded. Bill rate is what you would charge a client per hour on time and materials. Margin lives in the gap between them, and the tool also shows how much your fixed fee discounts off the same work priced at bill rates.\"}},{\"@type\":\"Question\",\"name\":\"How is gross margin calculated?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Labor cost is each role's hours times its cost rate, summed. Add optional overhead on labor and any other costs to get the cost to deliver. Gross margin is the quoted fee minus that cost, and the percentage is margin divided by fee.\"}},{\"@type\":\"Question\",\"name\":\"What is the breakeven fee?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It is the fee at which margin is zero, equal to the total cost to deliver. Quoting below it means the engagement loses money before you have done any work. It is a useful floor when you are negotiating.\"}},{\"@type\":\"Question\",\"name\":\"Why does the effort overrun slider matter?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Fixed-fee work carries the risk of scope creep. If the team spends more hours than planned, the extra cost comes straight out of your margin. The slider shows how quickly margin erodes, which is the single biggest reason fixed-fee projects underperform.\"}},{\"@type\":\"Question\",\"name\":\"Is the estimator free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, it is free with no signup. Add as many roles as you like, adjust every rate, and copy a summary of the result. To track effort against the estimate once the work starts, book a demo.\"}}]}]}a:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"id\":\"$undefined\",\"dangerouslySetInnerHTML\":{\"