egoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\"100vh\",\"textAlign\":\"center\",\"display\":\"flex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]]}],[\"$\",\"$L2b\",null,{}],[\"$\",\"$L2c\",null,{}]]}]]}]]}]\n2d:I[56691,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/3j04mm_z0avq9.js\",\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"/_next/static/chunks/41mnvtr75by45.js\"],\"FinalCTA\"]\n19:[\"$\",\"div\",\"What is the difference between cost rate and bill rate?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"What is the difference between cost rate and bill rate?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"Cost rate is what a person costs your firm per hour, fully loaded. Bill rate is what you would charge a client per hour on time and materials. Margin lives in the gap between them, and the tool also shows how much your fixed fee discounts off the same work priced at bill rates.\"}]]}]\n1a:[\"$\",\"div\",\"How is gross margin calculated?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"How is gross margin calculated?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"Labor cost is each role's hours times its cost rate, summed. Add optional overhead on labor and any other costs to get the cost to deliver. Gross margin is the quoted fee minus that cost, and the percentage is margin divided by fee.\"}]]}]\n1b:[\"$\",\"div\",\"What is the breakeven fee?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"What is the breakeven fee?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"It is the fee at which margin is zero, equal to the total cost to deliver. Quoting below it means the engagement loses money before you have done any work. It is a useful floor when you are negotiating.\"}]]}]\n1c:[\"$\",\"div\",\"Why does the effort overrun slider matter?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"Why does the effort overrun slider matter?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"Fixed-fee work carries the risk of scope creep. If the team spends more hours than planned, the extra cost comes straight out of your margin. The slider shows how quickly margin erodes, which is the single biggest reason fixed-fee projects underperform.\"}]]}]\n1d:[\"$\",\"div\",\"Is the estimator free?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"Is the estimator free?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"Yes, it is free with no signup. Add as many roles as you like, adjust every rate, and copy a summary of the result. To track effort against the estimate once the work starts, book a demo.\"}]]}]\n1e:[\"$\",\"section\",null,{\"className\":\"section-tight\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap max-w-[820px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-[22px] border border-accent/30 bg-accent-lt px-7 py-9 sm:px-9\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dot\",\"aria-hidden\":\"true\"}],\"From this tool to your firm\"]}],[\"$\",\"h2\",null,{\"className\":\"mt-3 font-display text-[22px] font-semibold leading-snug tracking-[-0.01em] sm:text-[26px]\",\"children\":\"Stop estimating overrun after the fact. Workspace tracks it live.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 max-w-[640px] text-[15px] leading-relaxed text-muted\",\"children\":\"Workspace logs billable vs. non-billable time against the plan as work happens, so margin erosion shows up while there's still time to act, not at invoicing. Pair it with Clientspace to share progress with the client without exposing your internal margin.\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 flex flex-wrap items-center gap-3\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://app.pyngyn.ai/?signup=true\",\"className\":\"btn btn-accent\",\"children\":[\"Start free trial\",\" →\"]}],[\"$\",\"a\",null,{\"href\":\"/demo\",\"className\":\"btn btn-ghost bg-white\",\"children\":\"Book a demo\"}]]}]]}]}]}]\n1f:[\"$\",\"$L2d\",null,{}]\n23:null\n16:true\nb:300\nb:C\n15:0\nd:\"$undefined\"\nf:\"$undefined\"\n12:\"$undefined\"\n14:\"$undefined\"\na:\"$undefined\"\n"}}