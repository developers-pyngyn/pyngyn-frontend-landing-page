ex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1.5 w-1.5 rounded-full bg-accent\",\"aria-hidden\":\"true\"}],\"USD or INR\"]}],[\"$\",\"span\",\"Built for services firms\",{\"className\":\"inline-flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1.5 w-1.5 rounded-full bg-accent\",\"aria-hidden\":\"true\"}],\"Built for services firms\"]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"pt-12\",\"children\":[\"$\",\"$L18\",null,{}]}],[\"$\",\"section\",null,{\"className\":\"section-tight\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap max-w-[820px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dot\",\"aria-hidden\":\"true\"}],\"The method\"]}],[\"$\",\"h2\",null,{\"className\":\"title mt-3\",\"children\":\"Honest math, your inputs.\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 space-y-4 text-[16px] leading-relaxed text-muted\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Most fixed-fee proposals are priced on instinct, then the margin is discovered after delivery. The model here is deliberately transparent. For each role you estimate the hours and a cost rate, and the sum is your labor cost. Add an optional overhead uplift if your cost rates are not already fully loaded, plus any pass-through costs like travel or subcontractors, and you have the true cost to deliver.\"}],[\"$\",\"p\",null,{\"children\":\"Gross margin is simply the quoted fee minus that cost. The tool also turns the fee into a blended bill rate so you can sanity-check it against your usual rates, and it shows how far the fixed fee sits below the same work priced on time and materials. The breakeven fee, the point where margin reaches zero, is the floor you should never quote beneath.\"}],[\"$\",\"p\",null,{\"children\":[\"The overrun slider is the part worth watching. Fixed-fee margin rarely dies at pricing; it dies in delivery, when the work takes more hours than planned. Treat the output as a directional estimate, not a quote, and use it to price with your eyes open. When you want to track real effort against the estimate,\",\" \",[\"$\",\"a\",null,{\"href\":\"/demo\",\"className\":\"font-semibold text-accent hover:text-accent-dk\",\"children\":\"book a demo\"}],\".\"]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dot\",\"aria-hidden\":\"true\"}],\"FAQ\"]}],[\"$\",\"h2\",null,{\"className\":\"title mt-3\",\"children\":\"Questions, answered.\"}],[\"$\",\"dl\",null,{\"className\":\"mt-6 divide-y divide-line\",\"children\":[[\"$\",\"div\",\"What does the cost and margin estimator do?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"What does the cost and margin estimator do?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"It estimates the cost to deliver a fixed-fee engagement from the hours and cost rates of each role, adds any overhead and pass-through costs, and compares the total to your quoted fee. It returns gross margin in money and percent, your blended bill rate, and the breakeven fee.\"}]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"]}]]}]]}]}],\"$L1e\",\"$L1f\"]}]\n5:[\"$\",\"$L20\",null,{}]\n6:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3j04mm_z0avq9.js\",\"async\":true}]\n7:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"async\":true}]\n8:[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/41mnvtr75by45.js\",\"async\":true}]\n9:[\"$\",\"$L21\",null,{\"children\":[\"$\",\"$22\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@23\"}]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L24\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\