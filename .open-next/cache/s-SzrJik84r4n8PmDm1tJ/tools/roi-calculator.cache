],[\"$\",\"div\",null,{\"className\":\"mt-6 space-y-4 text-[16px] leading-relaxed text-muted\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Most firms feel the drag of coordination but never price it. The model here is simple and transparent on purpose. Annual billing per person is your day rate times your billable days. The share of that time lost to status updates, tool-switching, and searching for context becomes lost value per person, and across the team it is your firm-wide cost of chaos.\"}],[\"$\",\"p\",null,{\"children\":\"The recoverable figure is deliberately conservative. It applies a win-back rate that you set, because no tool reclaims every lost minute. From there the calculator compares the recovered value against an editable tool cost to show net annual gain, return on investment, and how quickly the spend pays for itself.\"}],[\"$\",\"p\",null,{\"children\":[\"Treat the output as a directional estimate, not a quote. The point is not a precise figure, it is to make a hidden cost visible so you can decide whether it is worth fixing. When you want to model your firm properly,\",\" \",[\"$\",\"a\",null,{\"href\":\"/demo\",\"className\":\"font-semibold text-accent hover:text-accent-dk\",\"children\":\"book a demo\"}],\".\"]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dot\",\"aria-hidden\":\"true\"}],\"FAQ\"]}],[\"$\",\"h2\",null,{\"className\":\"title mt-3\",\"children\":\"Questions, answered.\"}],[\"$\",\"dl\",null,{\"className\":\"mt-6 divide-y divide-line\",\"children\":[[\"$\",\"div\",\"What does the ROI calculator measure?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"What does the ROI calculator measure?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"It estimates the annual cost of coordination overhead at a services firm: the billable time lost to status-chasing, tool-switching, and hunting for context. It then shows how much of that you could realistically win back and the resulting return on investment and payback period.\"}]]}],[\"$\",\"div\",\"Where do the default numbers come from?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"Where do the default numbers come from?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"The 35% time-lost default reflects commonly cited figures for time knowledge workers spend on coordination rather than billable work. Every input, including day rate, billable days, time lost, and win-back rate, is yours to adjust so the result reflects your firm.\"}]]}],[\"$\",\"div\",\"How is the cost of chaos calculated?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"How is the cost of chaos calculated?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"Annual billing per person equals day rate times billable days. Multiply by the percentage of time lost to get the lost value per person, then by headcount for the firm-wide cost. The recoverable figure applies your chosen win-back rate to that total.\"}]]}],[\"$\",\"div\",\"Is the win-back rate realistic?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"Is the win-back rate realistic?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"It is an assumption you control. The default of 50% is deliberately conservative: no tool recovers every lost minute. Lower it for a cautious estimate or raise it to model a best case.\"}]]}],\"$L23\"]}]]}]]}]}]\n16:[\"$\",\"section\",null,{\"className\":\"section