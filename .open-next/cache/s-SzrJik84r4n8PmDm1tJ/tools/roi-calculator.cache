\\\",\\\"c\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L4\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined\\\",\\\"errorStyles\\\":\\\"$undefined\\\",\\\"errorScripts\\\":\\\"$undefined\\\",\\\"template\\\":[\\\"$\\\",\\\"$L5\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":\\\"$undefined\\\",\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]]}]\\n9:[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L4\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined\\\",\\\"errorStyles\\\":\\\"$undefined\\\",\\\"errorScripts\\\":\\\"$undefined\\\",\\\"template\\\":[\\\"$\\\",\\\"$L5\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":\\\"$undefined\\\",\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]]}]\\n11:Ta23,{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@graph\\\":[{\\\"@type\\\":\\\"WebPage\\\",\\\"@id\\\":\\\"https://pyngyn.ai/tools/roi-calculator#webpage\\\",\\\"url\\\":\\\"https://pyngyn.ai/tools/roi-calculator\\\",\\\"name\\\":\\\"Cost of Chaos ROI Calculator | PYNGYN\\\",\\\"description\\\":\\\"See what coordination overhead costs your firm every year, and how much you could win back.\\\",\\\"isPartOf\\\":{\\\"@id\\\":\\\"https://pyngyn.ai/#website\\\"},\\\"breadcrumb\\\":{\\\"@id\\\":\\\"https://pyngyn.ai/tools/roi-calculator#breadcrumb\\\"},\\\"inLanguage\\\":\\\"en\\\"},{\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"@id\\\":\\\"https://pyngyn.ai/tools/roi-calculator#breadcrumb\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://pyngyn.ai/\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Tools\\\",\\\"item\\\":\\\"https://pyngyn.ai/tools\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"ROI Calculator\\\",\\\"item\\\":\\\"https://pyngyn.ai/tools/roi-calculator\\\"}]},{\\\"@type\\\":\\\"FAQPage\\\",\\\"@id\\\":\\\"https://pyngyn.ai/tools/roi-calculator#faq\\\",\\\"mainEntity\\\":[{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"What does the ROI calculator measure?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"It estimates the annual cost of coordination overhead at a services firm: the billable time lost to status-chasing, tool-switching, and hunting for context. It then shows how much of that you could realistically win back and the resulting return on investment and payback period.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Where do the default numbers come from?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"The 35% time-lost default reflects commonly cited figures for time knowledge workers spend on coordination rather than billable work. Every input, including day rate, billable days, time lost, and win-back rate, is yours to adjust so the result reflects your firm.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"How is the cost of chaos calculated?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Annual billing per person equals day rate times billable days. Multiply by the percentage of time lost to get the lost value per person, then by headcount for the firm-wide cost. The recoverable figure applies your chosen win-back rate to that total.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Is the win-back rate realistic?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"It is an assumption you control. The default of 50% is deliberately conservative: no tool recovers every lost minute. Lower it for a cautious estimate or raise it to model a best case.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Is the calculator free?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Yes, it is free with no signup. Adjust the inputs as many times as you like and copy a summary of the result. To model your firm in detail, book a demo.\\\"}}]}]}a:[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"id\\\":\\\"$undefined\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$11\\\"}}],[\\\"$\\\",\\\"$L12\\\",null,{}],[\\\"$\\\",\\\"main\\\",null,{\\\"id\\\":\\\"main\\\",\\\"children\\\":[[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"wrap pb-[10px] pt-[140px] text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"eyebrow\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"eyebrow-dot\\\",\\\"aria-hidden\\\":\\\"true\\\"}],\\\"Free tool\\\"]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"mx-auto mt-3 max-w-[820px] font-display text-[clamp(34px,5vw,58px)] font-semibold leading-[1.04] tracking-[-0.025em]\\\",\\\"children\\\":\\\"What is project chaos costing your firm?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"lead mx-auto mt-5\\\",\\\"children\\\":\\\"Status-chasing, tool-switching, and hunting for context quietly eat billable hours. Put a number on it, then see how much you could win back. Free, no signup.\\\"}],\\\"$L13\\\"]}],\\\"$L14\\\",\\\"$L15\\\",\\\"$L16\\\",\\\"$L17\\\"]}],\\\"$L18\\\"],[\\\"$L19\\\",\\\"$L1a\\\",\\\"$L1b\\\"],\\\"$L1c\\\"]}]\\nc:[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L1d\\\",null,{\\\"children\\\":\\\"$L1e\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$L1f\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$20\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$L21\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}]\\ne:[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/02mkr0z8o939x.css