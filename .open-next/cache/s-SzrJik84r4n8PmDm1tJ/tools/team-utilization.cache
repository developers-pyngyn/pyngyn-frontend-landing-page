 inputs as many times as you like and copy a summary of the result. To model your firm in detail, book a demo.\"}}]}]}12:X\n17:X\n17:C\n0:{\"buildId\":\"s-SzrJik84r4n8PmDm1tJ\",\"data\":[{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],[\"$\",\"$L3\",null,{}],[\"$\",\"main\",null,{\"id\":\"main\",\"children\":[[\"$\",\"section\",null,{\"className\":\"wrap pb-[10px] pt-[140px] text-center\",\"children\":[\"$L4\",\"$L5\",\"$L6\",\"$L7\"]}],\"$L8\",\"$L9\",\"$La\",\"$Lb\"]}],\"$Lc\"],[\"$Ld\",\"$Le\",\"$Lf\"],\"$L10\"]}],\"isPartial\":\"$@11\",\"staleTime\":\"$12\",\"varyParams\":null},{\"rsc\":\"$L13\",\"isPartial\":\"$@14\",\"staleTime\":\"$12\",\"varyParams\":null},{\"rsc\":\"$L15\",\"isPartial\":\"$@16\",\"staleTime\":\"$12\",\"varyParams\":\"$17\"},{\"rsc\":\"$L18\",\"isPartial\":\"$@19\",\"staleTime\":\"$12\",\"varyParams\":\"$17\"},{\"rsc\":\"$L1a\",\"isPartial\":\"$@1b\",\"staleTime\":\"$12\",\"varyParams\":null}],\"isUpgradeableISRFallback\":false,\"a\":\"$@1c\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@1d\"}\n1e:I[39372,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/2a2r_ezcb6klj.js\",\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"/_next/static/chunks/41mnvtr75by45.js\"],\"TeamUtilizationCalculator\"]\n23:I[56691,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/2a2r_ezcb6klj.js\",\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"/_next/static/chunks/41mnvtr75by45.js\"],\"FinalCTA\"]\n24:I[56691,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/2a2r_ezcb6klj.js\",\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"/_next/static/chunks/41mnvtr75by45.js\"],\"Footer\"]\n25:I[97367,[\"/_next/static/chunks/0ht-3v40sanoo.js\"],\"OutletBoundary\"]\n26:\"$Sreact.suspense\"\n28:I[97367,[\"/_next/static/chunks/0ht-3v40sanoo.js\"],\"ViewportBoundary\"]\n29:I[97367,[\"/_next/static/chunks/0ht-3v40sanoo.js\"],\"MetadataBoundary