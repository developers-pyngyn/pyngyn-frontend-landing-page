,null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n9:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n11:Tbe4,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://pyngyn.ai/tools/team-utilization#webpage\",\"url\":\"https://pyngyn.ai/tools/team-utilization\",\"name\":\"Team Utilization Calculator | PYNGYN\",\"description\":\"Measure billable utilization across your bench and find the revenue upside of hitting target.\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"breadcrumb\":{\"@id\":\"https://pyngyn.ai/tools/team-utilization#breadcrumb\"},\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/tools/team-utilization#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://pyngyn.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tools\",\"item\":\"https://pyngyn.ai/tools\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Team Utilization Calculator\",\"item\":\"https://pyngyn.ai/tools/team-utilization\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://pyngyn.ai/tools/team-utilization#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What does the team utilization calculator measure?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It estimates billable utilization for a services team: the share of your people's working capacity that is billed to clients. It then shows what that utilization is worth in revenue, and the upside of reaching the target you set.\"}},{\"@type\":\"Question\",\"name\":\"How is utilization calculated?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Capacity per person is hours per week times working weeks per year, after PTO and holidays. Current utilization is the share of that capacity billed to clients. Multiply capacity by utilization and by your billable rate to get revenue, then compare current and target to find the gap.\"}},{\"@type\":\"Question\",\"name\":\"What is a good utilization target?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It varies by firm and role. For client-facing consultants, 70 to 80% is a common healthy range; the rest goes to sales, internal work, learning, and rest. Senior and leadership roles usually carry lower billable targets. Set the target to match how your firm actually runs.\"}},{\"@type\":\"Question\",\"name\":\"What does the consultant-equivalent figure mean?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It converts the gap to your target into whole people. If the firm-wide shortfall equals two consultants' worth of annual capacity, you are effectively employing two billable people you are not yet billing. It is a quick way to feel the size of the gap.\"}},{\"@type\":\"Question\",\"name\":\"Should I aim for 100% utilization?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Full utilization leaves no room for business development, internal projects, training, or recovery, and it tends to drive burnout and attrition. The calculator deliberately compares against a target you choose, not against 100%.\"}},{\"@type\":\"Question\",\"name\":\"Is the calculator free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, it is free with no signup. Adjust the inputs as many times as you like and copy a summary of the result. To model your firm in detail, book a demo.\"}}]}]}a:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"id\":\"$undefined\",\"dangerouslySetInnerHTML\":{\"__html\":\"$11\"}}],[\"$\",\"$L12\",null,{}],[\"$\",\"main\",null,{\"id\":\"main\",\"children\":[[\"$\",\"section\",null,{\"className\":\"wrap pb-[10px] pt-[140px] text-center\",\"children\":[\"$L13\",\"$L14\",\"$L15\",\"$L16\"]}],\"$L17\",\"$L18\",\"$L19\",\"$L1a\"]}],\"$L1b\"],[\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L20\",null,{\"children\":\"$L21\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L22\",null,{\"children\":[\"$\",\"$23\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L24\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\ne:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/02mkr0z8o939x.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n25:I[39372,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/2a2r_ezcb6klj.js\",\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"/_next/static/chunks/41mnvtr75by45.js\"],\"TeamUtilizationCalculator\"]\n2a:I[56691,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/2a2r_ezcb6klj.js\",\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"/_next/static/chunks/41mnvtr75by45.js\"],\"FinalCTA\"]\n2b:I[56691,[\"/_next/static/chunks/0ht-3v40sanoo.js\",\"/_next/static/chunks/2a2r_ezcb6klj.js\",\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"/_next/static/chunks/41mnvtr75by45.js\"],\"Footer\"]\n2c:I[97367,[\"/_next/static/chunks/0ht-3v40sanoo.js\"],\"OutletBoundary\"]\nb:C\n13:[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dot\",\"aria-hidden\":\"true\"}],\"Free tool\"]}]\n14:[\"$\",\"h1\",null,{\"className\":\"mx-auto mt-3 max-w-[820px] font-display text-[clamp(34px,5vw,58px)] font-semibold leading-[1.04] tracking-[-0.025em]\",\"children\":\"How much of your team is actually billing?\"}]\n15:[\"$\",\"p\",null,{\"className\":\"lead mx-auto mt-5\",\"children\":\"Bench time, half-staffed projects, and unevenly loaded consultants quietly cap revenue. Measure your billable utilization, then see what hitting target is worth. Free, no signup.\"}]\n16:[\"$\",\"div\",null,{\"className\":\"mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 font-mono text-[12px] uppercase tracking-[0.12em] text-muted\",\"children\":[[\"$\",\"span\",\"No signup\",{\"className\":\"inline-flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1.5 w-1.5 rounded-full bg-accent\",\"aria-hidden\":\"true\"}],\"No signup\"]}],[\"$\",\"span\",\"USD or INR\",{\"className\":\"inline-flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1.5 w-1.5 rounded-full bg-accent\",\"aria-hidden\":\"true\"}],\"USD or INR\"]}],[\"$\",\"span\",\"Built for services firms\",{\"className\":\"inline-flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1.5 w-1.5 rounded-full bg-accent\",\"aria-hidden\":\"true\"}],\"Built for services firms\"]}]]}]\n17:[\"$\",\"div\",null,{\"className\":\"pt-12\",\"children\":[\"$\",\"$L25\",null,{}]}]\n18:[\"$\",\"section\",null,{\"className\":\"section-tight\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap max-w-[820px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dot\",\"aria-hidden\":\"true\"}],\"The method\"]}],[\"$\",\"h2\",null,{\"className\":\"title mt-3\",\"children\":\"Honest math, your inputs.\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 space-y-4 text-[16px] leading-relaxed text-muted\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Utilization is the simplest read on whether a services team is loaded well. The model here is deliberately transparent. Capacity per person is your working hours per week times your working weeks per year, after holidays and time off. Current utilization is the share of that capacity billed to clients, and multiplying by your rate turns hours into revenue.\"}],[\"$\",\"p\",null,{\"children\":\"The opportunity is measured against a target you set, not against a theoretical 100%. Full utilization is neither realistic nor healthy, since people also sell, learn, run internal work, and rest. The gap between current and target, priced at your rate, is the revenue you could win back by loading the bench more evenly, and it is also expressed as whole consultants of capacity so the size is easy to feel.\"}],[\"$\",\"p\",null,{\"children\":[\"Treat the output as a directional estimate, not a quote. Averages hide a lot: two people at 90% and two at 30% read the same as four at 60%. The point is to make hidden idle capacity visible so you can decide whether it is worth addressing. When you want to model your firm properly,\",\" \",[\"$\",\"a\",null,{\"href\":\"/demo\",\"className\":\"font-semibold text-accent hover:text-accent-dk\",\"children\":\"book a demo\"}],\".\"]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dot\",\"aria-hidden\":\"true\"}],\"FAQ\"]}],[\"$\",\"h2\",null,{\"className\":\"title mt-3\",\"children\":\"Questions, answered.\"}],[\"$\",\"dl\",null,{\"className\":\"mt-6 divide-y divide-line\",\"children\":[[\"$\",\"div\",\"What does the team utilization calculator measure?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"What does the team utilization calculator measure?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"It estimates billable utilization for a services team: the share of your people's working capacity that is billed to clients. It then shows what that utilization is worth in revenue, and the upside of reaching the target you set.\"}]]}],[\"$\",\"div\",\"How is utilization calculated?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"How is utilization calculated?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"Capacity per person is hours per week times working weeks per year, after PTO and holidays. Current utilization is the share of that capacity billed to clients. Multiply capacity by utilization and by your billable rate to get revenue, then compare current and target to find the gap.\"}]]}],[\"$\",\"div\",\"What is a good utilization target?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"What is a good utilization target?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"It varies by firm and role. For client-facing consultants, 70 to 80% is a common healthy range; the rest goes to sales, internal work, learning, and rest. Senior and leadership roles usually carry lower billable targets. Set the target to match how your firm actually runs.\"}]]}],[\"$\",\"div\",\"What does the consultant-equivalent figure mean?\",{\"className\":\"py-5\",\"children\":[\"$L26\",\"$L27\"]}],\"$L28\",\"$L29\"]}]]}]]}]}]\n19:[\"$\",\"section\",null,{\"className\":\"section-tight\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap max-w-[820px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-[22px] border border-accent/30 bg-accent-lt px-7 py-9 sm:px-9\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dot\",\"aria-hidden\":\"true\"}],\"From this tool to your firm\"]}],[\"$\",\"h2\",null,{\"className\":\"mt-3 font-display text-[22px] font-semibold leading-snug tracking-[-0.01em] sm:text-[26px]\",\"children\":\"See utilization live, per person, per engagement, in Workspace.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 max-w-[640px] text-[15px] leading-relaxed text-muted\",\"children\":\"This calculator works from averages you enter by hand. Workspace tracks billable time per person and per engagement automatically, so the idle bench and the overloaded one both show up before quarter-end, not after.\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 flex flex-wrap items-center gap-3\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://app.pyngyn.ai/?signup=true\",\"className\":\"btn btn-accent\",\"children\":[\"Start free trial\",\" →\"]}],[\"$\",\"a\",null,{\"href\":\"/demo\",\"className\":\"btn btn-ghost bg-white\",\"children\":\"Book a demo\"}]]}]]}]}]}]\n1a:[\"$\",\"$L2a\",null,{}]\n1b:[\"$\",\"$L2b\",null,{}]\n1c:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/2a2r_ezcb6klj.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n1d:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n1e:[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/41mnvtr75by45.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n1f:[\"$\",\"$L2c\",null,{\"children\":[\"$\",\"$23\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@2d\"}]}]\n26:[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"What does the consultant-equivalent figure mean?\"}]\n27:[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"It converts the gap to your target into whole people. If the firm-wide shortfall equals two consultants' worth of annual capacity, you are effectively employing two billable people you are not yet billing. It is a quick way to feel the size of the gap.\"}]\n28:[\"$\",\"div\",\"Should I aim for 100% utilization?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"Should I aim for 100% utilization?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"No. Full utilization leaves no room for business development, internal projects, training, or recovery, and it tends to drive burnout and attrition. The calculator deliberately compares against a target you choose, not against 100%.\"}]]}]\n29:[\"$\",\"div\",\"Is the calculator free?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"Is the calculator free?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"Yes, it is free with no signup. Adjust the inputs as many times as you like and copy a summary of the result. To model your firm in detail, book a demo.\"}]]}]\n21:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n2e:I[27201,[\"/_next/static/chunks/0ht-3v40sanoo.js\"],\"IconMark\"]\n24:[[\"$\",\"title\",\"0\",{\"children\":\"Team Utilization Calculator | PYNGYN\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Work out billable utilization across your bench, see what your current rate is worth, and find the revenue upside of hitting your target. Free, no signup. Built for professional-services teams.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"author\",\"content\":\"Nikunj Chugh\"}],[\"$\",\"meta\",\"3\",{\"name\":\"creator\",\"content\":\"Nikunj Chugh\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://pyngyn.ai/tools/team-utilization/\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Team Utilization Calculator | PYNGYN\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Measure billable utilization across your team and spot where capacity is being lost. Free, no signup.\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:url\",\"content\":\"https://pyngyn.ai/tools/team-utilization/\"}],[\"$\