\"div\",null,{\"className\":\"pt-12\",\"children\":[\"$\",\"$L1e\",null,{}]}]\n9:[\"$\",\"section\",null,{\"className\":\"section-tight\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap max-w-[820px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dot\",\"aria-hidden\":\"true\"}],\"The method\"]}],[\"$\",\"h2\",null,{\"className\":\"title mt-3\",\"children\":\"Honest math, your inputs.\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 space-y-4 text-[16px] leading-relaxed text-muted\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Utilization is the simplest read on whether a services team is loaded well. The model here is deliberately transparent. Capacity per person is your working hours per week times your working weeks per year, after holidays and time off. Current utilization is the share of that capacity billed to clients, and multiplying by your rate turns hours into revenue.\"}],[\"$\",\"p\",null,{\"children\":\"The opportunity is measured against a target you set, not against a theoretical 100%. Full utilization is neither realistic nor healthy, since people also sell, learn, run internal work, and rest. The gap between current and target, priced at your rate, is the revenue you could win back by loading the bench more evenly, and it is also expressed as whole consultants of capacity so the size is easy to feel.\"}],[\"$\",\"p\",null,{\"children\":[\"Treat the output as a directional estimate, not a quote. Averages hide a lot: two people at 90% and two at 30% read the same as four at 60%. The point is to make hidden idle capacity visible so you can decide whether it is worth addressing. When you want to model your firm properly,\",\" \",[\"$\",\"a\",null,{\"href\":\"/demo\",\"className\":\"font-semibold text-accent hover:text-accent-dk\",\"children\":\"book a demo\"}],\".\"]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dot\",\"aria-hidden\":\"true\"}],\"FAQ\"]}],[\"$\",\"h2\",null,{\"className\":\"title mt-3\",\"children\":\"Questions, answered.\"}],[\"$\",\"dl\",null,{\"className\":\"mt-6 divide-y divide-line\",\"children\":[[\"$\",\"div\",\"What does the team utilization calculator measure?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"What does the team utilization calculator measure?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"It estimates billable utilization for a services team: the share of your people's working capacity that is billed to clients. It then shows what that utilization is worth in revenue, and the upside of reaching the target you set.\"}]]}],[\"$\",\"div\",\"How is utilization calculated?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"How is utilization calculated?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"Capacity per person is hours per week times working weeks per year, after PTO and holidays. Current utilization is the share of that capacity billed to clients. Multiply capacity by utilization and by your billable rate to get revenue, then compare current and target to find the gap.\"}]]}],[\"$\",\"div\",\"What is a good utilization target?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[17px] font-semibold text-ink\",\"children\":\"What is a good utilization target?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[15px] leading-relaxed text-muted\",\"children\":\"It varies by firm and role. For client-facing consultants, 70 to 80% is a common healthy range; the rest goes to sales, internal work, learning, and rest. Senior and leadership roles usually carry lower billable targets. Set the target to match how your firm actually runs.\"}]]}],[\"$\",\"div\",\"What does the consultant-equivalent figure mean?\",{\"className\":\"py-5\",\"children\":[\"$L1f\",\"$L20\"]}],\"$L21\",\"$L22\"]}]]}]]}]}]\na:[\"$\",\"section\",null,{\"className\":\"section-tight\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap max-w-[820px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-[22px] border border-accent/30 bg-accent-lt px-7 py-9 sm:px-9\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dot\",\"aria-hidden\":\"true\"}],\"From this tool to your firm\"]}],[\"$\",\"h2\",null,{\"className\":\"mt-3 font-display text-[22px] font-semibold leading-snug tracking-[-0.01em] sm:text-[26px]\",\"children\":\"See utilization live, per person, per engagement, in Workspace.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 max-w-[640px] text-[15px] leading-relaxed text-muted\",\"children\":\"This calculator works from averages you enter by hand. Workspace tracks billable time per person and per engagement automatically, so the idle bench and the overloaded one both show up before quarter-end, not after.\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 flex flex-wrap items-center gap-3\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://app.pyngyn.ai/?signup=true\",\"className\":\"btn btn-accent\",\"children\":[\"Start free trial\",\" →\"]}],[\"$\",\"a\",null,{\"href\":\"/demo\",\"className\":\"btn btn-ghost bg-white\",\"children\":\"Book a demo\"}]]}]]}]}]}]\nb:[\"$\",\"$L23\",null,{}]\nc:[\"$\",\"$L24\",null,{}]\nd:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/2a2r_ezcb6klj.js\",\"async\":true}]\ne:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1_p0c8_mtfqqv.js\",\"async\":true}]\nf:[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/41mnvtr75by45.js\",\"async\":true}]\n10:[\"$\",\"$L25\",null,{\"children\":[\"$\",\"$26\",null,{\"name\":\"Next.Meta