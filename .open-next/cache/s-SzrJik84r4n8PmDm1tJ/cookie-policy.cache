{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/cookie-policy/layout,_N_T_/cookie-policy/page,_N_T_/cookie-policy"},"segmentPaths":["/_tree","/_full","/cookie-policy/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"display_2a073e65-module__7MkqkG__variable jakarta_55fc869e-module__LB2P7q__variable mono_8ba1b3ff-module__cxzmQq__variable\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_400_normal-s.p.2_o2v7tpo0q5m.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_500_normal-s.p.3vqzgd2jdiw22.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_600_normal-s.p.3_r60-qkmao3a.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bricolage_grotesque_latin_700_normal-s.p.0rb33xx2bxpl8.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_400_normal-s.p.3crsbyy6lh6yf.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_500_normal-s.p.2h52d08o60qht.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/jetbrains_mono_latin_600_normal-s.p.2mm922pe315l1.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_400_normal-s.p.2ysn9gc82zk1v.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_500_normal-s.p.1evhelic1rxge.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_600_normal-s.p.0p6sew1q6gl7s.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/plus_jakarta_sans_latin_700_normal-s.p.1dulefe5e4s81.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"/logo.webp\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/02mkr0z8o939x.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1b-l3oagpuv39.js\"/><script src=\"/_next/static/chunks/11jq0c2_zavac.js\" async=\"\"></script><script src=\"/_next/static/chunks/4561u0v7ysn3r.js\" async=\"\"></script><script src=\"/_next/static/chunks/021sppg0zbt0v.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2pcc6e_qu_s3g.js\" async=\"\"></script><script src=\"/_next/static/chunks/0ht-3v40sanoo.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/41mnvtr75by45.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/1_p0c8_mtfqqv.js\" async=\"\" crossorigin=\"\"></script><title>Cookie Policy | PYNGYN</title><meta name=\"description\" content=\"How Pyngyn uses cookies, web beacons, browser storage, and similar technologies.\"/><meta name=\"author\" content=\"Nikunj Chugh\"/><meta name=\"creator\" content=\"Nikunj Chugh\"/><link rel=\"canonical\" href=\"https://pyngyn.ai/cookie-policy/\"/><meta property=\"og:title\" content=\"PYNGYN: The operating system for professional-services firms\"/><meta property=\"og:description\" content=\"Run your firm and every client engagement in one place. The operating system for professional-services firms.\"/><meta property=\"og:url\" content=\"https://pyngyn.ai/\"/><meta property=\"og:site_name\" content=\"PYNGYN\"/><meta property=\"og:image\" content=\"https://pyngyn.ai/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"PYNGYN: Clientspace, a standalone branded client portal, and Workspace, a standalone back office for professional-services firms\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:site\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:creator\" content=\"@Pyngyn_Official\"/><meta name=\"twitter:title\" content=\"PYNGYN: The operating system for professional-services firms\"/><meta name=\"twitter:description\" content=\"Run your firm and every client engagement in one place. The operating system for professional-services firms.\"/><meta name=\"twitter:image\" content=\"https://pyngyn.ai/og.png\"/><link rel=\"icon\" href=\"/icon.png\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png\"/><meta name=\"next-size-adjust\" content=\"\"/><script type=\"application/ld+json\" id=\"ld-organization\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://pyngyn.ai/#organization\",\"name\":\"PYNGYN\",\"legalName\":\"VIMOVI GlobalTech Private Limited\",\"url\":\"https://pyngyn.ai/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://pyngyn.ai/logo.png\",\"width\":512,\"height\":512},\"image\":\"https://pyngyn.ai/icon.png\",\"description\":\"PYNGYN gives every client a branded Client Space (a standalone portal for status, documents, and approvals), with Workspace, the firm's back office for projects, finances, and billable time, available on its own or bundled together.\",\"sameAs\":[\"https://x.com/Pyngyn_Official\",\"https://www.linkedin.com/company/pyngyn/\",\"https://www.reddit.com/user/Pyngyn_Official/\",\"https://www.facebook.com/profile.php?id=61584474731354\",\"https://www.youtube.com/@PyngynOfficial\",\"https://instagram.com/pyngyn_official\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"customer support\",\"email\":\"support@pyngyn.com\",\"url\":\"https://pyngyn.ai/support\",\"availableLanguage\":[\"English\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"sales@pyngyn.com\",\"url\":\"https://pyngyn.ai/demo\",\"availableLanguage\":[\"English\"]}]}</script><script type=\"application/ld+json\" id=\"ld-website\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://pyngyn.ai/#website\",\"url\":\"https://pyngyn.ai/\",\"name\":\"PYNGYN\",\"description\":\"The operating system for professional-services firms. Run your firm and every client engagement in one place.\",\"publisher\":{\"@id\":\"https://pyngyn.ai/#organization\"},\"inLanguage\":\"en\"}</script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-sans\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main\" class=\"sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white\">Skip to content</a><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://pyngyn.ai/cookie-policy#webpage\",\"url\":\"https://pyngyn.ai/cookie-policy\",\"name\":\"Cookie Policy | PYNGYN\",\"description\":\"Hi, we're Pyngyn. You're probably here because you're interested to know more about how we use cookies, web beacons, browser storage, and other similar technologies. As part of our commitment to upholding a high standard of transparency in our [Privacy Policy](/privacy), we've created this guide to explain the tracking technologies we use across our marketing site at [pyngyn.ai](https://pyngyn.ai) and our product application at [app.pyngyn.ai](https://app.pyngyn.ai).\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"breadcrumb\":{\"@id\":\"https://pyngyn.ai/cookie-policy#breadcrumb\"},\"dateModified\":\"June 24, 2026\",\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/cookie-policy#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://pyngyn.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Cookie Policy\",\"item\":\"https://pyngyn.ai/cookie-policy\"}]}]}</script><header class=\"fixed inset-x-0 top-0 z-[100] border-b transition-all duration-300 border-transparent bg-transparent\"><div class=\"wrap flex h-[68px] items-center justify-between\"><a class=\"flex items-center\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><div class=\"hidden h-full lg:flex lg:items-center\"><nav class=\"flex items-center gap-7 text-[15px] text-[#3a3a42]\"><a class=\"py-2 transition-colors hover:text-accent\" href=\"/clientspace/\">Clientspace</a><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Product<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Solutions<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Resources<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Compare<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></nav></div><div class=\"flex items-center gap-3\"><a href=\"https://app.pyngyn.ai/\" class=\"hidden text-[15px] font-semibold lg:inline \">Sign in</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"hidden px-4 py-2.5 lg:inline-flex btn btn-ghost\">Start free</a><a href=\"/demo\" class=\"hidden px-[18px] py-2.5 lg:inline-flex btn btn-primary\">Book a demo</a><button type=\"button\" class=\"grid h-10 w-10 place-items-center rounded-lg border lg:hidden border-line bg-white text-ink\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"mobile-menu\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"></path></svg></button></div></div></header><main id=\"main\" class=\"wrap pb-[104px] pt-[150px]\"><article class=\"mx-auto max-w-[820px]\"><h1 class=\"font-display text-[clamp(32px,4.4vw,48px)] font-semibold leading-[1.08] tracking-[-0.025em]\">Cookie Policy</h1><p class=\"mt-3 text-[14px] text-muted\">Last updated: <!-- -->June 24, 2026</p><p class=\"mt-1.5 text-[14px] text-muted\"><span>Read alongside our </span><a class=\"text-accent underline underline-offset-2 hover:text-ink\" href=\"/privacy/\">Privacy Policy</a><span>.</span></p><p class=\"mt-6 text-[17px] leading-[1.7] text-ink\"><span>Hi, we&#x27;re Pyngyn. You&#x27;re probably here because you&#x27;re interested to know more about how we use cookies, web beacons, browser storage, and other similar technologies. As part of our commitment to upholding a high standard of transparency in our </span><a class=\"text-accent underline underline-offset-2 hover:text-ink\" href=\"/privacy/\">Privacy Policy</a><span>, we&#x27;ve created this guide to explain the tracking technologies we use across our marketing site at </span><a href=\"https://pyngyn.ai\" class=\"text-accent underline underline-offset-2 hover:text-ink\">pyngyn.ai</a><span> and our product application at </span><a href=\"https://app.pyngyn.ai\" class=\"text-accent underline underline-offset-2 hover:text-ink\">app.pyngyn.ai</a><span>.</span></p><div class=\"mt-10 flex flex-col gap-9\"><section><h2 class=\"font-display text-[22px] font-semibold tracking-[-0.01em]\">1. What are cookies, web beacons, and similar technologies?</h2><div class=\"mt-3 flex flex-col gap-3.5\"><p class=\"text-[16px] leading-[1.7] text-ink\"><span>Typically, there are two types of tracking technologies we might use on our sites:</span></p><ul class=\"flex flex-col gap-2\"><li class=\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\"><span class=\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\" aria-hidden=\"true\"></span><span><strong>Cookies:</strong><span> these aren&#x27;t the type you eat. They&#x27;re actually a small data file sent from a server to your web browser or mobile device, then stored in your browser cache or device memory. There are ways you can control your cookie preferences and set whether you want to accept or reject cookies (see what your options are below).</span></span></li><li class=\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\"><span class=\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\" aria-hidden=\"true\"></span><span><strong>Browser storage:</strong><span> some of the data we describe in this policy isn&#x27;t a traditional cookie at all, it&#x27;s stored using your browser&#x27;s </span><strong>localStorage</strong><span> or held only in page memory. This data never leaves your browser and is never transmitted to our servers.</span></span></li></ul></div></section><section><h2 class=\"font-display text-[22px] font-semibold tracking-[-0.01em]\">2. What do we do with these technologies?</h2><div class=\"mt-3 flex flex-col gap-3.5\"><p class=\"text-[16px] leading-[1.7] text-ink\"><span>We use these tracking technologies for a few general purposes:</span></p><ul class=\"flex flex-col gap-2\"><li class=\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\"><span class=\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\" aria-hidden=\"true\"></span><span><span>To allow our sites and product application to function correctly, including keeping you securely logged in to your workspace.</span></span></li><li class=\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\"><span class=\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\" aria-hidden=\"true\"></span><span><span>To understand how our marketing site is performing and to inform improvements to our content and user experience.</span></span></li><li class=\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\"><span class=\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\" aria-hidden=\"true\"></span><span><span>To enhance your experience on our sites and provide functionality, for example, so you don&#x27;t have to reset your interface preferences each time you visit.</span></span></li><li class=\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\"><span class=\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\" aria-hidden=\"true\"></span><span><span>To gather relevant, aggregated data that helps us measure marketing performance and the content that&#x27;s relevant to your interests.</span></span></li></ul><p class=\"text-[16px] leading-[1.7] text-ink\"><span>We sometimes partner with trusted third-party services that use their own tracking technologies to provide certain features on our site, such as analytics, on-site messaging, or scheduling. These third-party services may use cookies to anonymously collect data and allow them to recognize your computer or mobile device each time you visit any of our sites. No personally identifiable information is collected by these cookies for our own use, and the anonymous data they collect is kept separate from any personal information about you that we collect directly.</span></p></div></section><section><h2 class=\"font-display text-[22px] font-semibold tracking-[-0.01em]\">3. The categories of cookies we use</h2><div class=\"mt-3 flex flex-col gap-3.5\"><p class=\"text-[16px] leading-[1.7] text-ink\"><span>Here&#x27;s a breakdown of how we classify the cookies, scripts, and local storage mechanisms across our sites:</span></p><div class=\"overflow-x-auto rounded-[14px] border border-line\"><table class=\"w-full min-w-[560px] border-collapse text-left text-[14px]\"><thead><tr class=\"bg-[#fbfbfd]\"><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Category</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">What it does</th><th class=\"border-b border-line px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-muted\">Lifespan</th></tr></thead><tbody><tr class=\"border-b border-line\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Strictly Necessary</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Keeps you logged in to app.pyngyn.ai, protects against CSRF and DDoS, and runs core UI features on the marketing site (promo timers, offer countdowns, roadmap votes). Always active, cannot be disabled.</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Session-based or short-lived</span></td></tr><tr class=\"border-b border-line\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Functional</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Remembers your dashboard preferences, dark mode, sidebar state, default workspace view, and language selection.</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Persistent, until cleared</span></td></tr><tr class=\"border-b border-line\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Analytics &amp; Performance</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Google Tag Manager and Google Analytics (GA4) on our marketing site, page views, load times, error rates, and referral paths. Aggregated and anonymized; blocked until you consent.</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Up to 1 year</span></td></tr><tr class=\"\"><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Marketing &amp; Targeting</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Meta/Facebook Pixel, deployed via GTM on the marketing site only, to measure campaign performance and conversions. Never used inside app.pyngyn.ai. Disabled until you consent.</span></td><td class=\"px-4 py-3 align-top leading-[1.6] text-ink\"><span>Varies by provider</span></td></tr></tbody></table></div></div></section><section><h2 class=\"font-display text-[22px] font-semibold tracking-[-0.01em]\">4. Third-party integrations on our sites</h2><div class=\"mt-3 flex flex-col gap-3.5\"><p class=\"text-[16px] leading-[1.7] text-ink\"><strong>Calendly (Demo bookings)</strong></p><p class=\"text-[16px] leading-[1.7] text-ink\"><span>When you visit our </span><strong>/demo</strong><span> scheduling page to book time with our team, Calendly powers the booking experience. Calendly may set its own cookies to secure the booking form, prevent duplicate submissions, and remember your selected time slot. Information you submit there (such as your name, email, and meeting time) goes directly to our Calendly account and does not pass through Pyngyn&#x27;s application database. Calendly&#x27;s use of cookies is governed by its own privacy policy.</span></p><p class=\"text-[16px] leading-[1.7] text-ink\"><strong>Anthropic (AI-powered features)</strong></p><p class=\"text-[16px] leading-[1.7] text-ink\"><span>AI-powered features within app.pyngyn.ai (including task generation, support assistance, organizational reporting, workload recommendations, and project insights) send the information you submit to Anthropic, our AI processing partner, to generate outputs. This processing happens transiently; per our current implementation, these submissions are not stored in our own database. Anthropic does not use this exchange to set persistent advertising cookies or trackers on your device.</span></p><p class=\"text-[16px] leading-[1.7] text-ink\"><strong>Google Tag Manager, Google Analytics &amp; Meta Pixel</strong></p><p class=\"text-[16px] leading-[1.7] text-ink\"><span>These are loaded only on our public marketing site, and only after you consent through our cookie banner. They are never active inside the authenticated app.pyngyn.ai product.</span></p><p class=\"text-[16px] leading-[1.7] text-ink\"><strong>Google Fonts</strong></p><p class=\"text-[16px] leading-[1.7] text-ink\"><span>Our sites may load typefaces from Google Fonts. Loading a font can share your IP address with Google as part of that request, in the same way it would for any resource fetched from a third-party server.</span></p></div></section><section><h2 class=\"font-display text-[22px] font-semibold tracking-[-0.01em]\">5. Your options when it comes to cookies, web beacons, and similar technologies</h2><div class=\"mt-3 flex flex-col gap-3.5\"><p class=\"text-[16px] leading-[1.7] text-ink\"><span>You can change your web browser&#x27;s settings to reflect your cookie preferences. Use these links to find out more information about cookie settings for common browsers:</span></p><ul class=\"flex flex-col gap-2\"><li class=\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\"><span class=\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\" aria-hidden=\"true\"></span><span><a href=\"https://support.google.com/chrome/answer/95647\" class=\"text-accent underline underline-offset-2 hover:text-ink\">Chrome</a></span></li><li class=\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\"><span class=\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\" aria-hidden=\"true\"></span><span><a href=\"https://support.mozilla.org/en-US/kb/clear-cookies-and-site-data-firefox\" class=\"text-accent underline underline-offset-2 hover:text-ink\">Firefox</a></span></li><li class=\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\"><span class=\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\" aria-hidden=\"true\"></span><span><a href=\"https://support.apple.com/guide/safari/manage-cookies-sfri11471/mac\" class=\"text-accent underline underline-offset-2 hover:text-ink\">Safari</a></span></li><li class=\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\"><span class=\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\" aria-hidden=\"true\"></span><span><a href=\"https://support.microsoft.com/en-us/microsoft-edge/delete-cookies-in-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09\" class=\"text-accent underline underline-offset-2 hover:text-ink\">Microsoft Edge</a></span></li></ul><p class=\"text-[16px] leading-[1.7] text-ink\"><span>When you first visit our marketing website, you&#x27;ll see a cookie banner letting you accept all tracking technologies, reject all non-essential analytics and marketing tags, or customize your preferences in detail. If you click &quot;Reject All&quot;, or simply close the banner without acting, Google Analytics and the Meta Pixel will remain completely uninitialized.</span></p><p class=\"text-[16px] leading-[1.7] text-ink\"><strong>Please keep in mind:</strong><span> if you disable Strictly Necessary cookies through your browser settings, you won&#x27;t be able to log in to app.pyngyn.ai or maintain a workspace session, and some marketing site features may not work or operate correctly.</span></p></div></section><section><h2 class=\"font-display text-[22px] font-semibold tracking-[-0.01em]\">6. Updates to this policy</h2><div class=\"mt-3 flex flex-col gap-3.5\"><p class=\"text-[16px] leading-[1.7] text-ink\"><span>We may update this Cookie Policy periodically to reflect changes in our technology, hosting infrastructure, partner integrations, or applicable privacy regulations. The effective date at the top of this document will always reflect our most recent update.</span></p></div></section><section><h2 class=\"font-display text-[22px] font-semibold tracking-[-0.01em]\">7. Contact us</h2><div class=\"mt-3 flex flex-col gap-3.5\"><p class=\"text-[16px] leading-[1.7] text-ink\"><span>If you have any questions about our use of cookies, browser storage, or this policy, please contact our privacy team at </span><strong>[vivek.pandey@pyngyn.com](mailto:vivek.pandey@pyngyn.com)</strong><span>, or write to us at:</span></p><div class=\"rounded-[14px] border border-line bg-[#fbfbfd] p-5\"><div class=\"mb-1.5 text-[14px] font-bold text-ink\">Vimovi Global Tech, Privacy &amp; Compliance Team</div><div class=\"flex flex-col gap-1 text-[14.5px] leading-[1.6] text-ink\"><div><span>Email: </span><strong>[vivek.pandey@pyngyn.com](mailto:vivek.pandey@pyngyn.com)</strong></div><div><span>Website: </span><strong>[pyngyn.ai](https://pyngyn.ai)</strong></div></div></div></div></section></div></article></main><footer class=\"border-t border-line bg-white pt-16 pb-10 text-sm text-muted\"><div class=\"wrap\"><div class=\"grid gap-10 lg:grid-cols-[1.4fr_repeat(5,1fr)]\"><div><a class=\"mb-4 inline-block\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" loading=\"lazy\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><p class=\"max-w-[230px] leading-relaxed\">The operating system f