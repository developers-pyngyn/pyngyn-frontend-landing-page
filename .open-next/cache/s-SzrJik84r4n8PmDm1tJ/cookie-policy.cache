px] leading-[1.7] text-ink\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",\\\"0\\\",{\\\"children\\\":\\\"Our sites may load typefaces from Google Fonts. Loading a font can share your IP address with Google as part of that request, in the same way it would for any resource fetched from a third-party server.\\\"}]]}]]}]]}]\\n19:[\\\"$\\\",\\\"section\\\",\\\"4\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-[22px] font-semibold tracking-[-0.01em]\\\",\\\"children\\\":\\\"5. Your options when it comes to cookies, web beacons, and similar technologies\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-3 flex flex-col gap-3.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"text-[16px] leading-[1.7] text-ink\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",\\\"0\\\",{\\\"children\\\":\\\"You can change your web browser's settings to reflect your cookie preferences. Use these links to find out more information about cookie settings for common browsers:\\\"}]]}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"flex flex-col gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"className\\\":\\\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"a\\\",\\\"0\\\",{\\\"href\\\":\\\"https://support.google.com/chrome/answer/95647\\\",\\\"className\\\":\\\"text-accent underline underline-offset-2 hover:text-ink\\\",\\\"children\\\":\\\"Chrome\\\"}]]}]]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"className\\\":\\\"flex gap-2.5 text-[16px] leading-[1.6] text-ink\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"mt-[9px] h-[5px] w-[5px] flex-none rounded-full bg-muted\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"childre