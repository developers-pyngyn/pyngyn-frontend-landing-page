-3 font-display text-[16px] font-medium leading-[1.45] tracking-[-0.005em] text-white\",\"children\":[\"“\",\"We only learn a project was unprofitable after the invoice goes out. Live engagement health would change how we sell.\",\"”\"]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-4 border-t border-white/10 pt-3 text-[12.5px] text-white/65\",\"children\":\"Partner, advisory firm\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono text-[10px] font-semibold uppercase tracking-wider text-white/60\",\"children\":\"From a discovery call\"}],[\"$\",\"blockquote\",null,{\"className\":\"mt-3 font-display text-[16px] font-medium leading-[1.45] tracking-[-0.005em] text-white\",\"children\":[\"“\",\"Our partner reviews are a Friday meeting. By Monday the status is already stale. We need a system that updates itself.\",\"”\"]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-4 border-t border-white/10 pt-3 text-[12.5px] text-white/65\",\"children\":\"Operations lead, marketing agency\"}]]}]]}]]}]\n12:[\"$\",\"section\",null,{\"className\":\"mx-auto w-full max-w-[1180px] px-5 py-20 sm:px-7 sm:py-24\",\"children\":[[\"$\",\"div\",null,{\"className\":\"max-w-[640px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-2 font-mono text-[11.5px] font-semibold uppercase tracking-[0.14em] text-accent\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1.5 w-1.5 rounded-full bg-accent\"}],\" \",\"What teams ask us first\"]}],[\"$\",\"h2\",null,{\"className\":\"mt-4 font-display text-[clamp(28px,4vw,42px)] font-semibold leading-[1.05] tracking-[-0.03em] text-white\",\"children\":\"The honest answers to the obvious questions.\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-10 grid gap-4 lg:grid-cols-2\",\"children\":[[\"$\",\"div\",\"We already use WhatsApp and spreadsheets. Why change?\",{\"className\":\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-display text-[17.5px] font-semibold leading-tight tracking-[-0.015em] text-white\",\"children\":\"We already use WhatsApp and spreadsheets. Why change?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[14.5px] leading-relaxed text-white/65\",\"children\":\"Both are great until the firm grows past about 20 people. Then status fragments, accountability drifts, and you stop trusting the numbers. PYNGYN is the layer you needed when scattered tools started costing you margin.\"}]]}],[\"$\",\"div\",\"Our team will not adopt another tool.\",{\"className\":\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-display text-[17.5px] font-semibold leading-tight tracking-[-0.015em] text-white\",\"children\":\"Our team will not adopt another tool.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[14.5px] leading-relaxed text-white/65\",\"children\":\"PYNGYN replaces work, not adds to it. Status updates, follow-ups, and Friday roll-ups happen automatically, so adopting means doing less, not more. Firms typically have most of the team live in under two weeks.\"}]]}],[\"$\",\"div\",\"Setup sounds complicated.\",{\"className\":\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-display text-[17.5px] font-semibold leading-tight tracking-[-0.015em] text-white\",\"children\":\"Setup sounds complicated.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[14.5px] leading-relaxed text-white/65\",\"children\":\"It is not. A typical mid-market firm onboards in days, not months. We model one of your real engagements live in the demo so you see exactly what week one looks like.\"}]]}],[\"$\",\"div\",\"We already use another PM tool.\",{\"className\":\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-display text-[17.5px] font-semibold leading-tight tracking-[-0.015em] text-white\",\"children\":\"We already use another PM tool.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[14.5px] leading-relaxed text-white/65\",\"children\":\"Most firms already do. PYNGYN slots over the top: it can import projects, talk to the tools you keep, and replace the ones causing the most pain. You decide the pace.\"}]]}]]}]]}]\n13:[\"$\",\"section\",null,{\"className\":\"mx-auto w-full max-w-[820px] px-5 py-20 sm:px-7 sm:py-24\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-center\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-2 font-mono text-[11.5px] font-semibold uppercase tracking-[0.14em] text-accent\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1.5 w-1.5 rounded-full bg-accent\"}],\" \",\"FAQ\"]}],[\"$\",\"h2\",null,{\"className\":\"mt-4 font-display text-[clamp(28px,4vw,40px)] font-semibold leading-[1.05] tracking-[-0.03em] text-white\",\"children\":\"Everything else, answered.\"}]]}],[\"$\",\"dl\",null,{\"className\":\"mt-10 divide-y divide-white/10 border-y border-white/10\",\"children\":[[\"$\",\"div\",\"How fast can we go live?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[16px] font-semibold text-white\",\"children\":\"How fast can we go live?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-white/65\",\"children\":\"A typical mid-market services firm has the first engagement running in under a week, and most of the team using it inside two.\"}]]}],[\"$\",\"div\",\"Will it work with our existing tools?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[16px] font-semibold text-white\",\"children\":\"Will it work with our existing tools?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-white/65\",\"children\":\"Yes. PYNGYN connects to Slack, Gmail, Google Workspace, QuickBooks, Xero, DocuSign, Stripe, Salesforce, HubSpot, n8n, Zapier, and Make, with more on the way.\"}]]}],[\"$\",\"div\",\"How do you handle our data?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[16px] font-semibold text-white\",\"children\":\"How do you handle our data?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-white/65\",\"children\":\"Encryption in transit and at rest, SSO and SAML, SOC 2 aligned controls, GDPR alignment. Your data is never used to train AI models without explicit consent.\"}]]}],[\"$\",\"div\",\"Can we migrate from another tool?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[16px] font-semibold text-white\",\"children\":\"Can we migrate from another tool?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-white/65\",\"children\":\"Yes. We support imports from common project tools and spreadsheets, and our team helps with the first migration so you do not lose history.\"}]]}],[\"$\",\"div\",\"How does pricing work?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[16px] font-semibold text-white\",\"children\":\"How does pricing work?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-white/65\",\"children\":\"Client Space is $19 per client/month, standalone. Workspace is $9 per internal seat/month, standalone. Bundle both for $24.99/month. Enterprise pricing is custom. 7-day trial, no credit card required.\"}]]}],[\"$\",\"div\",\"Will the team actually use it?\",{\"className\":\"py-5\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[16px] font-semibold text-white\",\"children\":\"Will the team actually use it?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-white/65\",\"children\":\"Yes. Because PYNGYN replaces manual coordination work instead of adding to it, adoption is the rule rather than the exception in pilot teams.\"}]]}]]}]]}]\n14:[\"$\",\"section\",null,{\"c