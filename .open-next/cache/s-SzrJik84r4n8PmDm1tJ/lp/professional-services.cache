uto text-white/60\"><path d=\"M6 6l12 12M18 6L6 18\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"></path></svg></td></tr><tr class=\"bg-white/[0.01]\"><th scope=\"row\" class=\"border-b border-white/10 px-4 py-3.5 text-[13.5px] font-medium text-white\">Forecasting &amp; utilisation built in</th><td class=\"border-b border-white/10 px-3 py-3.5 text-center bg-accent/[0.08]\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mx-auto text-emerald-400\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></td><td class=\"border-b border-white/10 px-3 py-3.5 text-center \"><span class=\"font-mono text-[16px] font-bold text-amber-400\">~</span></td><td class=\"border-b border-white/10 px-3 py-3.5 text-center \"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mx-auto text-white/60\"><path d=\"M6 6l12 12M18 6L6 18\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"></path></svg></td><td class=\"border-b border-white/10 px-3 py-3.5 text-center \"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mx-auto text-emerald-400\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></td><td class=\"border-b border-white/10 px-3 py-3.5 text-center \"><span class=\"font-mono text-[16px] font-bold text-amber-400\">~</span></td><td class=\"border-b border-white/10 px-3 py-3.5 text-center \"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"mx-auto text-white/60\"><path d=\"M6 6l12 12M18 6L6 18\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"></path></svg></td></tr></tbody></table></div></div><div class=\"mt-4 flex flex-wrap items-center justify-end gap-x-5 gap-y-1 text-[11.5px] text-white/70\"><span class=\"inline-flex items-center gap-1.5\"><svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"text-emerald-400\"><path d=\"M5 12l5 5L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg> Full</span><span class=\"inline-flex items-center gap-1.5\"><span class=\"text-amber-400\">~</span> Partial</span><span class=\"inline-flex items-center gap-1.5\"><svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"text-white/60\"><path d=\"M6 6l12 12M18 6L6 18\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"></path></svg> None</span></div></section><section class=\"mx-auto w-full max-w-[1180px] px-5 py-20 sm:px-7 sm:py-24\"><div class=\"max-w-[640px]\"><span class=\"inline-flex items-center gap-2 font-mono text-[11.5px] font-semibold uppercase tracking-[0.14em] text-accent\"><span class=\"h-1.5 w-1.5 rounded-full bg-accent\"></span> <!-- -->In their words</span><h2 class=\"mt-4 font-display text-[clamp(28px,4vw,42px)] font-semibold leading-[1.05] tracking-[-0.03em] text-white\">Hear it from the teams using it.</h2><p class=\"mt-5 text-[16px] leading-relaxed text-white/65\">A short clip from a real customer. Below it are the patterns we hear in nearly every discovery call.</p></div><div class=\"mt-10 max-w-[520px]\"><figure><div class=\"relative aspect-video overflow-hidden rounded-xl bg-black border border-white/10 bg-white/[0.03]\"><video class=\"h-full w-full object-contain\" controls=\"\" preload=\"metadata\" playsInline=\"\" aria-label=\"Customer testimonial\"><source src=\"https://pyngyn.ai/assets/Testimonial-CRAqvVm9.mp4\" type=\"video/mp4\"/>Your browser does not support embedded video. You can<!-- --> <a href=\"https://pyngyn.ai/assets/Testimonial-CRAqvVm9.mp4\" class=\"underline\">watch it here</a>.</video></div></figure></div><div class=\"mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\"><figure class=\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\"><span class=\"font-mono text-[10px] font-semibold uppercase tracking-wider text-white/60\">From a discovery call</span><blockquote class=\"mt-3 font-display text-[16px] font-medium leading-[1.45] tracking-[-0.005em] text-white\">“<!-- -->We run client work across WhatsApp, Excel, and three trackers. The team is good. The system is broken.<!-- -->”</blockquote><figcaption class=\"mt-4 border-t border-white/10 pt-3 text-[12.5px] text-white/65\">Founder, mid-market consulting firm</figcaption></figure><figure class=\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\"><span class=\"font-mono text-[10px] font-semibold uppercase tracking-wider text-white/60\">From a discovery call</span><blockquote class=\"mt-3 font-display text-[16px] font-medium leading-[1.45] tracking-[-0.005em] text-white\">“<!-- -->We only learn a project was unprofitable after the invoice goes out. Live engagement health would change how we sell.<!-- -->”</blockquote><figcaption class=\"mt-4 border-t border-white/10 pt-3 text-[12.5px] text-white/65\">Partner, advisory firm</figcaption></figure><figure class=\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\"><span class=\"font-mono text-[10px] font-semibold uppercase tracking-wider text-white/60\">From a discovery call</span><blockquote class=\"mt-3 font-display text-[16px] font-medium leading-[1.45] tracking-[-0.005em] text-white\">“<!-- -->Our partner reviews are a Friday meeting. By Monday the status is already stale. We need a system that updates itself.<!-- -->”</blockquote><figcaption class=\"mt-4 border-t border-white/10 pt-3 text-[12.5px] text-white/65\">Operations lead, marketing agency</figcaption></figure></div></section><section class=\"mx-auto w-full max-w-[1180px] px-5 py-20 sm:px-7 sm:py-24\"><div class=\"max-w-[640px]\"><span class=\"inline-flex items-center gap-2 font-mono text-[11.5px] font-semibold uppercase tracking-[0.14em] text-accent\"><span class=\"h-1.5 w-1.5 rounded-full bg-accent\"></span> <!-- -->What teams ask us first</span><h2 class=\"mt-4 font-display text-[clamp(28px,4vw,42px)] font-semibold leading-[1.05] tracking-[-0.03em] text-white\">The honest answers to the obvious questions.</h2></div><div class=\"mt-10 grid gap-4 lg:grid-cols-2\"><div class=\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\"><h3 class=\"font-display text-[17.5px] font-semibold leading-tight tracking-[-0.015em] text-white\">We already use WhatsApp and spreadsheets. Why change?</h3><p class=\"mt-3 text-[14.5px] leading-relaxed text-white/65\">Both are great until the firm grows past about 20 people. Then status fragments, accountability drifts, and you stop trusting the numbers. PYNGYN is the layer you needed when scattered tools started costing you margin.</p></div><div class=\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\"><h3 class=\"font-display text-[17.5px] font-semibold leading-tight tracking-[-0.015em] text-white\">Our team will not adopt another tool.</h3><p class=\"mt-3 text-[14.5px] leading-relaxed text-white/65\">PYNGYN replaces work, not adds to it. Status updates, follow-ups, and Friday roll-ups happen automatically, so adopting means doing less, not more. Firms typically have most of the team live in under two weeks.</p></div><div class=\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\"><h3 class=\"font-display text-[17.5px] font-semibold leading-tight tracking-[-0.015em] text-white\">Setup sounds complicated.</h3><p class=\"mt-3 text-[14.5px] leading-relaxed text-white/65\">It is not. A typical mid-market firm onboards in days, not months. We model one of your real engagements live in the demo so you see exactly what week one looks like.</p></div><div class=\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\"><h3 class=\"font-display text-[17.5px] font-semibold leading-tight tracking-[-0.015em] text-white\">We already use another PM tool.</h3><p class=\"mt-3 text-[14.5px] leading-relaxed text-white/65\">Most firms already do. PYNGYN slots over the top: it can import projects, talk to the tools you keep, and replace the ones causing the most pain. You decide the pace.</p></div></div></section><section class=\"mx-auto w-full max-w-[820px] px-5 py-20 sm:px-7 sm:py-24\"><div class=\"text-center\"><span class=\"inline-flex items-center gap-2 font-mono text-[11.5px] font-semibold uppercase tracking-[0.14em] text-accent\"><span class=\"h-1.5 w-1.5 rounded-full bg-accent\"></span> <!-- -->FAQ</span><h2 class=\"mt-4 font-display text-[clamp(28px,4vw,40px)] font-semibold leading-[1.05] tracking-[-0.03em] text-white\">Everything else, answered.</h2></div><dl class=\"mt-10 divide-y divide-white/10 border-y border-white/10\"><div class=\"py-5\"><dt class=\"text-[16px] font-semibold text-white\">How fast can we go live?</dt><dd class=\"mt-2 text-[14.5px] leading-relaxed text-white/65\">A typical mid-market services firm has the first engagement running in under a week, and most of the team using it inside two.</dd></div><div class=\"py-5\"><dt class=\"text-[16px] font-semibold text-white\">Will it work with our existing tools?</dt><dd class=\"mt-2 text-[14.5px] leading-relaxed text-white/65\">Yes. PYNGYN connects to Slack, Gmail, Google Workspace, QuickBooks, Xero, DocuSign, Stripe, Salesforce, HubSpot, n8n, Zapier, and Make, with more on the way.</dd></div><div class=\"py-5\"><dt class=\"text-[16px] font-semibold text-white\">How do you handle our data?</dt><dd class=\"mt-2 text-[14.5px] leading-relaxed text-white/65\">Encryption in transit and at rest, SSO and SAML, SOC 2 aligned controls, GDPR alignment. Your data is never used to train AI models without explicit consent.</dd></div><div class=\"py-5\"><dt class=\"text-[16px] font-semibold text-white\">Can we migrate from another tool?</dt><dd class=\"mt-2 text-[14.5px] leading-relaxed text-white/65\">Yes. We support imports from common project tools and spreadsheets, and our team helps with the first migration so you do not lose history.</dd></div><div class=\"py-5\"><dt class=\"text-[16px] font-semibold text-white\">How does pricing work?</dt><dd class=\"mt-2 text-[14.5px] leading-relaxed text-white/65\">Client Space is $19 per client/month, standalone. Workspace is $9 per internal seat/month, standalone. Bundle both for $24.99/month. Enterprise pricing is custom. 7-day trial, no credit card required.</dd></div><div class=\"py-5\"><dt class=\"text-[16px] font-semibold text-white\">Will the team actually use it?</dt><dd class=\"mt-2 text-[14.5px] leading-relaxed text-white/65\">Yes. Because PYNGYN replaces manual coordination work instead of adding to it, adoption is the rule rather than the exception in pilot teams.</dd></div></dl></section><section class=\"mx-auto w-full max-w-[1180px] px-5 pb-28 pt-12 text-center sm:px-7 sm:pb-36\"><div class=\"relative mx-auto overflow-hidden rounded-[28px] border border-accent/30 bg-gradient-to-br from-accent/20 via-accent/5 to-transparent p-10 sm:p-16\"><div class=\"hero-grid pointer-events-none absolute inset-0 opacity-40\" aria-hidden=\"true\"></div><div class=\"relative\"><span class=\"inline-flex items-center gap-2 font-mono text-[11.5px] font-semibold uppercase tracking-[0.14em] text-accent\"><span class=\"h-1.5 w-1.5 rounded-full bg-accent\"></span> <!-- -->Your move</span><h2 class=\"mx-auto mt-4 max-w-[760px] font-display text-[clamp(32px,5vw,56px)] font-semibold leading-[1.02] tracking-[-0.035em] text-white\">Your operations will either scale your firm,<br class=\"hidden sm:inline\"/> <!-- -->or break it.</h2><p class=\"mx-auto mt-5 max-w-[520px] text-[16.5px] leading-relaxed text-white/65\">Stop running client work through chaos. See PYNGYN run one of your real engagements, live.</p><div class=\"mt-9 flex flex-wrap items-center justify-center gap-3\"><a href=\"/demo\" class=\"group inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-3.5 text-[15px] font-semibold text-white shadow-cta transition-all hover:-translate-y-0.5 hover:bg-accent-dk \">Book a demo<span aria-hidden=\"true\" class=\"transition-transform group-hover:translate-x-0.5\">→</span></a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"inline-flex items-center justify-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-6 py-3.5 text-[15px] font-semibold text-white transition-all hover:border-white/30 hover:bg-white/[0.08] \">Start free trial</a></div><p class=\"mt-5 text-[12.5px] text-white/70\">7-day free trial. No credit card. Cancel anytime.</p></div></div></section><footer class=\"border-t border-white/10\"><div class=\"mx-auto flex w-full max-w-[1180px] flex-col items-start justify-between gap-3 px-5 py-7 text-[12.5px] text-white/70 sm:flex-row sm:items-center sm:px-7\"><p>© 2026 PYNGYN, a product of VIMOVI GlobalTech Private Limited.</p><div class=\"flex flex-wrap gap-x-5 gap-y-1\"><a href=\"/privacy\" class=\"hover:text-white\">Privacy</a><a href=\"/terms\" class=\"hover:text-white\">Terms</a><a href=\"/support\" class=\"hover:text-white\">Support</a></div></div></footer></div><div class=\"fixed inset-x-0 bottom-0 z-[70] border-t border-white/10 bg-ink text-white shadow-[0_-10px_30px_-14px_rgba(0,0,0,0.55)] transition-transform duration-300 translate-y-full pointer-events-none\" role=\"region\" aria-label=\"Start a free trial\" aria-hidden=\"true\"><div class=\"flex items-center justify-between gap-3 px-5 py-3 pl-[76px]\"><span class=\"text-[13.5px] font-semibold text-white/85\">7-day free trial · No credit card required</span><a href=\"/demo\" class=\"btn btn-accent flex-none px-4 py-2 text-[13.5px]\">Book a demo</a></div></div></main><!--$--><!--/$--><!--$!--><template data-dgst=\"BAILOUT_TO_CLIENT_SIDE_RENDERING\"></template><!--/$--><script src=\"/_next/static/chunks/1b-l3oagpuv39.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n3: