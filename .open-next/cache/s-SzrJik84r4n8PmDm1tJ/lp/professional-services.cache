\\\":\\\"mx-auto w-full max-w-[1180px] px-5 py-20 sm:px-7 sm:py-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-[640px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"inline-flex items-center gap-2 font-mono text-[11.5px] font-semibold uppercase tracking-[0.14em] text-accent\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"h-1.5 w-1.5 rounded-full bg-accent\\\"}],\\\" \\\",\\\"What teams ask us first\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"mt-4 font-display text-[clamp(28px,4vw,42px)] font-semibold leading-[1.05] tracking-[-0.03em] text-white\\\",\\\"children\\\":\\\"The honest answers to the obvious questions.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-10 grid gap-4 lg:grid-cols-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"We already use WhatsApp and spreadsheets. Why change?\\\",{\\\"className\\\":\\\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-display text-[17.5px] font-semibold leading-tight tracking-[-0.015em] text-white\\\",\\\"children\\\":\\\"We already use WhatsApp and spreadsheets. Why change?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-[14.5px] leading-relaxed text-white/65\\\",\\\"children\\\":\\\"Both are great until the firm grows past about 20 people. Then status fragments, accountability drifts, and you stop trusting the numbers. PYNGYN is the layer you needed when scattered tools started costing you margin.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"Our team will not adopt another tool.\\\",{\\\"className\\\":\\\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-display text-[17.5px] font-semibold leading-tight tracking-[-0.015em] text-white\\\",\\\"children\\\":\\\"Our team will not adopt another tool.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-[14.5px] leading-relaxed text-white/65\\\",\\\"children\\\":\\\"PYNGYN replaces work, not adds to it. Status updates, follow-ups, and Friday roll-ups happen automatically, so adopting means doing less, not more. Firms typically have most of the team live in under two weeks.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"Setup sounds complicated.\\\",{\\\"className\\\":\\\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-display text-[17.5px] font-semibold leading-tight tracking-[-0.015em] text-white\\\",\\\"children\\\":\\\"Setup sounds complicated.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-[14.5px] leading-relaxed text-white/65\\\",\\\"children\\\":\\\"It is not. A typical mid-market firm onboards in days, not months. We model one of your real engagements live in the demo so you see exactly what week one looks like.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"We already use another PM tool.\\\",{\\\"className\\\":\\\"rounded-2xl border border-white/10 bg-white/[0.03] p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-display text-[17.5px] font-semibold leading-tight tracking-[-0.015em] text-white\\\",\\\"children\\\":\\\"We already use another PM tool.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-[14.5px] leading-relaxed text-white/65\\\",\\\"children\\\":\\\"Most firms already do. PYNGYN slots over the top: it can import projects, talk to the tools you keep, and replace the ones causing the most pain. You decide the pace.\\\"}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"22:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mx-auto w-full max-w-[820px] px-5 py-20 sm:px-7 sm:py-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"inline-flex items-center gap-2 font-mono text-[11.5px