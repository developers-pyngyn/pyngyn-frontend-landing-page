OfItems\":5,\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"AI risk detection is now generally available (May 22, 2026)\",\"url\":\"https://pyngyn.ai/announcements\",\"description\":\"PYNGYN now watches workload, deadlines, and dependencies across every engagement and flags what threatens your dates, before they slip. Available on all plans today.\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Faster imports from other tools (May 9, 2026)\",\"url\":\"https://pyngyn.ai/announcements\",\"description\":\"Bringing your existing projects into PYNGYN is now up to 3x faster, with smarter field mapping that gets owners and statuses right the first time.\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"New: shareable read-only client views (Apr 28, 2026)\",\"url\":\"https://pyngyn.ai/announcements\",\"description\":\"Give clients and stakeholders a clean, always-current view of progress without giving them edit access or a seat.\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"PYNGYN raises to accelerate its operating system for professional-services firms (Apr 14, 2026)\",\"url\":\"https://pyngyn.ai/announcements\",\"description\":\"We're investing in the team and the product so growing firms can run every project with less overhead. Thank you to our customers for getting us here.\"},{\"@type\":\"ListItem\",\"position\":5,\"name\":\"Join our live walkthrough webinar (Mar 30, 2026)\",\"url\":\"https://pyngyn.ai/announcements\",\"description\":\"See how teams go from a one-line goal to a living plan in minutes. We host a live demo and Q&A every other week, register from the demo page.\"}]}]}</script><header class=\"fixed inset-x-0 top-0 z-[100] border-b transition-all duration-300 border-transparent bg-transparent\"><div class=\"wrap flex h-[68px] items-center justify-between\"><a class=\"flex items-center\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><div class=\"hidden h-full lg:flex lg:items-center\"><nav class=\"flex items-center gap-7 text-[15px] text-[#3a3a42]\"><a class=\"py-2 transition-colors hover:text-accent\" href=\"/clientspace/\">Clientspace</a><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Product<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Solutions<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Resources<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Compare<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></nav></div><div class=\"flex items-center gap-3\"><a href=\"https://app.pyngyn.ai/\" class=\"hidden text-[15px] font-semibold lg:inline \">Sign in</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"hidden px-4 py-2.5 lg:inline-flex btn btn-ghost\">Start free</a><a href=\"/demo\" class=\"hidden px-[18px] py-2.5 lg:inline-flex btn btn-primary\">Book a demo</a><button type=\"button\" class=\"grid h-10 w-10 place-items-center rounded-lg border lg:hidden border-line bg-white text-ink\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"mobile-menu\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"></path></svg></button></div></div></header><main id=\"main\"><section class=\"wrap pb-[10px] pt-[150px] text-center\"><span class=\"eyebrow\"><span class=\"eyebrow-dot\" aria-hidden=\"true\"></span>Announcements</span><h1 class=\"mx-auto mt-3 max-w-[720px] font-display text-[clamp(34px,4.8vw,54px)] font-semibold leading-[1.05] tracking-[-0.025em]\">What&#x27;s new at PYNGYN.</h1><p class=\"lead mx-auto mt-5\">Launches, product updates, and news from the team. Looking for granular release notes? See the<!-- --> <a href=\"/changelog\" class=\"font-semibold text-accent\">changelog</a>.</p></section><div class=\"wrap max-w-[760px] pb-[70px] pt-[40px]\"><ol class=\"flex flex-col gap-5\"><li class=\"rounded-[18px] border border-line bg-white p-6 shadow-card sm:p-7\"><div class=\"flex flex-wrap items-center gap-3\"><span class=\"rounded-full px-2.5 py-1 text-[12px] font-semibold\" style=\"background-color:#4f46e51a;color:#4f46e5\">Launch</span><span class=\"text-[13px] text-muted\">May 22, 2026</span></div><h2 class=\"mt-3 font-display text-[22px] font-semibold tracking-[-0.015em]\">AI risk detection is now generally available</h2><p class=\"mt-2 text-[15.5px] leading-relaxed text-muted\">PYNGYN now watches workload, deadlines, and dependencies across every engagement and flags what threatens your dates, before they slip. Available on all plans today.</p></li><li class=\"rounded-[18px] border border-line bg-white p-6 shadow-card sm:p-7\"><div class=\"flex flex-wrap items-center gap-3\"><span class=\"rounded-full px-2.5 py-1 text-[12px] font-semibold\" style=\"background-color:#0d94881a;color:#0d9488\">Update</span><span class=\"text-[13px] text-muted\">May 9, 2026</span></div><h2 class=\"mt-3 font-display text-[22px] font-semibold tracking-[-0.015em]\">Faster imports from other tools</h2><p class=\"mt-2 text-[15.5px] leading-relaxed text-muted\">Bringing your existing projects into PYNGYN is now up to 3x faster, with smarter field mapping that gets owners and statuses right the first time.</p></li><li class=\"rounded-[18px] border border-line bg-white p-6 shadow-card sm:p-7\"><div class=\"flex flex-wrap items-center gap-3\"><span class=\"rounded-full px-2.5 py-1 text-[12px] font-semibold\" style=\"background-color:#0d94881a;color:#0d9488\">Update</span><span class=\"text-[13px] text-muted\">Apr 28, 2026</span></div><h2 class=\"mt-3 font-display text-[22px] font-semibold tracking-[-0.015em]\">New: shareable read-only client views</h2><p class=\"mt-2 text-[15.5px] leading-relaxed text-muted\">Give clients and stakeholders a clean, always-current view of progress without giving them edit access or a seat.</p></li><li class=\"rounded-[18px] border border-line bg-white p-6 shadow-card sm:p-7\"><div class=\"flex flex-wrap items-center gap-3\"><span class=\"rounded-full px-2.5 py-1 text-[12px] font-semibold\" style=\"background-color:#9333ea1a;color:#9333ea\">Company</span><span class=\"text-[13px] text-muted\">Apr 14, 2026</span></div><h2 class=\"mt-3 font-display text-[22px] font-semibold tracking-[-0.015em]\">PYNGYN raises to accelerate its operating system for professional-services firms</h2><p class=\"mt-2 text-[15.5px] leading-relaxed text-muted\">We&#x27;re investing in the team and the product so growing firms can run every project with less overhead. Thank you to our customers for getting us here.</p></li><li class=\"rounded-[18px] border border-line bg-white p-6 shadow-card sm:p-7\"><div class=\"flex flex-wrap items-center gap-3\"><span class=\"rounded-full px-2.5 py-1 text-[12px] font-semibold\" style=\"background-color:#f973161a;color:#f97316\">Event</span><span class=\"text-[13px] text-muted\">Mar 30, 2026</span></div><h2 class=\"mt-3 font-display text-[22px] font-semibold tracking-[-0.015em]\">Join our live walkthrough webinar</h2><p class=\"mt-2 text-[15.5px] leading-relaxed text-muted\">See how teams go from a one-line goal to a living plan in minutes. We host a live demo and Q&amp;A every other week, register from the demo page.</p></li></ol><div class=\"mt-10 rounded-2xl border border-line bg-[#fbfbfd] p-7 text-center\"><h2 class=\"font-display text-[20px] font-semibold\">Curious what&#x27;s coming next?</h2><p class=\"mx-auto mt-2 max-w-[440px] text-[15px] text-muted\">See what the team is planning and building on our public roadmap.</p><a href=\"/roadmap\" class=\"btn btn-primary mt-4\">View the roadmap →</a></div></div></main><footer class=\"border-t border-line bg-white pt-16 pb-10 text-sm text-muted\"><div class=\"wrap\"><div class=\"grid gap-10 lg:grid-cols-[1.4fr_repeat(5,1fr)]\"><div><a class=\"mb-4 inline-block\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" loading=\"lazy\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><p class=\"max-w-[230px] leading-relaxed\">The operating system for professional-services firms.</p><a href=\"https://play.google.com/store/apps/details?id=com.pyngyn.io&amp;hl=en_IN\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"mt-5 inline-flex items-center gap-2.5 rounded-xl border border-line bg-white px-4 py-2.5 transition-colors hover:border-accent\" aria-label=\"Get PYNGYN on Google Play\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3.6 2.3 