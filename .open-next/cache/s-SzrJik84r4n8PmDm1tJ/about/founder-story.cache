an\",null,{\"className\":\"grid h-8 w-8 place-items-center rounded-full bg-accent text-white font-mono text-[14px] font-bold\",\"children\":\"4\"}],[\"$\",\"div\",null,{\"className\":\"text-[14.5px] font-semibold text-ink\",\"children\":\"Outcomes improve, more data added\"}]]}]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-5 max-w-[760px] text-[14.5px] leading-relaxed text-muted\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-ink\",\"children\":\"Result:\"}],\" near-zero churn after 6 months, Pyngyn becomes the firm's institutional memory.\"]}]]}]\nb:[\"$\",\"section\",null,{\"className\":\"wrap py-[40px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":\"Why now\"}],[\"$\",\"h2\",null,{\"className\":\"mt-3 max-w-[820px] font-display text-[clamp(26px,3.4vw,36px)] font-semibold leading-tight tracking-[-0.02em]\",\"children\":\"The tailwinds have never been stronger.\"}],[\"$\",\"div\",null,{\"className\":\"mt-7 space-y-4\",\"children\":[[\"$\",\"div\",\"AI adoption is accelerating in PS, but it's generic\",{\"className\":\"rounded-2xl border border-line bg-white p-6 shadow-card\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"AI adoption is accelerating in PS, but it's generic\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-muted\",\"children\":\"78% of consultants now use AI tools. But they're using tools that don't know their firm. I left ClickUp knowing the contextual AI layer for PS didn't exist. The window to build it is now.\"}]]}],[\"$\",\"div\",\"Firms are under margin pressure post-pandemic\",{\"className\":\"rounded-2xl border border-line bg-white p-6 shadow-card\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"Firms are under margin pressure post-pandemic\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-muted\",\"children\":\"PS firms are being asked to do more with leaner teams. Fragmentation is no longer just annoying, it's a P&L problem. Every hour lost to tool-switching is a billable hour that never happened.\"}]]}],[\"$\",\"div\",\"Remote work permanently broke knowledge transfer\",{\"className\":\"rounded-2xl border border-line bg-white p-6 shadow-card\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[16.5px] font-bold leading-snug\",\"children\":\"Remote work permanently broke knowledge transfer\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-muted\",\"children\":\"The informal hallway knowledge transfer is gone forever. Firms are haemorrhaging institutional knowledge and every tool they try just adds another silo. The timing for a unified OS is perfect.\"}]]}]]}]]}]\nc:[\"$\",\"section\",null,{\"className\":\"wrap py-[40px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-[24px] border border-line bg-[#0b0d12] p-8 text-white shadow-art md:p-12\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow-dark\",\"children\":\"In closing\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 max-w-[820px] font-display text-[clamp(24px,3.4vw,38px)] font-semibold leading-[1.15] tracking-[-0.02em]\",\"children\":[\"I spent 6 years inside the tools that failed PS firms.\",\" \",[\"$\",\"span\",null,{\"className\":\"text-accent\",\"children\":\"Now I'm building the one that doesn't.\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-5 max-w-[680px] text-[15.5px] leading-relaxed text-white/70\",\"children\":\"We're building the intelligence layer PS firms will run on. Seeking strategic partners who understand that the future of work is smarter integration.\"}],[\"$\",\"div\",null,{\"className\":\"mt-7 flex flex-wrap items-center gap-3.5\",\"children\":[[\"$\",\"$L1f\",null,{\"href\":\"/demo\",\"className\":\"btn bg-white text-ink hover:bg-white/90\",\"children\":\"Book a 20-minute conversation →\"}],[\"$\",\"$L1f\",null,{\"href\":\"/solutions/professional-services\",\"class