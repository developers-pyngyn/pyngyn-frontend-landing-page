ap-[18px] sm:grid-cols-2 lg:grid-cols-4\",\"children\":[[\"$\",\"div\",\"Of the day lost to tool-switching\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-display text-[34px] font-semibold leading-none tracking-[-0.02em] text-accent\",\"children\":\"35%\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[15px] font-bold text-ink\",\"children\":\"Of the day lost to tool-switching\"}],[\"$\",\"div\",null,{\"className\":\"mt-1.5 text-[13.5px] leading-relaxed text-muted\",\"children\":\"I watched this happen at every client I served at Wrike.\"}]]}],[\"$\",\"div\",\"Platforms per engagement\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-display text-[34px] font-semibold leading-none tracking-[-0.02em] text-accent\",\"children\":\"5+\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[15px] font-bold text-ink\",\"children\":\"Platforms per engagement\"}],[\"$\",\"div\",null,{\"className\":\"mt-1.5 text-[13.5px] leading-relaxed text-muted\",\"children\":\"At ClickUp I built templates to paper over this, it wasn't enough.\"}]]}],[\"$\",\"div\",\"Team misalignment\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-display text-[34px] font-semibold leading-none tracking-[-0.02em] text-accent\",\"children\":\"95%\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[15px] font-bold text-ink\",\"children\":\"Team misalignment\"}],[\"$\",\"div\",null,{\"className\":\"mt-1.5 text-[13.5px] leading-relaxed text-muted\",\"children\":\"Cross-functional projects at Meta showed me misalignment at scale.\"}]]}],[\"$\",\"div\",\"SOPs that surface when needed\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-display text-[34px] font-semibold leading-none tracking-[-0.02em] text-accent\",\"children\":\"0\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[15px] font-bold text-ink\",\"children\":\"SOPs that surface when needed\"}],[\"$\",\"div\",null,{\"className\":\"mt-1.5 text-[13.5px] leading-relaxed text-muted\",\"children\":\"No tool I implemented ever solved the SOP activation problem.\"}]]}]]}]]}]\n19:[\"$\",\"section\",null,{\"className\":\"wrap py-[40px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":\"The insight\"}],[\"$\",\"h2\",null,{\"className\":\"mt-3 max-w-[820px] font-display text-[clamp(26px,3.4vw,36px)] font-semibold leading-tight tracking-[-0.02em]\",\"children\":[\"The problem was never productivity.\",\" \",[\"$\",\"span\",null,{\"className\":\"text-accent\",\"children\":\"It was always fragmentation.\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-8 grid gap-[18px] md:grid-cols-3\",\"children\":[[\"$\",\"div\",\"01\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"index-num\",\"children\":\"01\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[17px] font-bold\",\"children\":\"I saw it from the inside\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-muted\",\"children\":\"At Wrike and ClickUp I watched firms add tools to fix coordination. Every tool made it worse. Knowledge scattered further. Consultants drowned in context-switching.\"}]]}],[\"$\",\"div\",\"02\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"index-num\",\"children\":\"02\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[17px] font-bold\",\"children\":\"AI alone doesn't fix it\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Generic AI doesn't know your firm. It can't surface the right SOP at the right moment in the right workflow. I knew the answer had to be contextual, not generic.\"}]]}],[\"$\",\"div\",\"03\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"index-num\",\"children\":\"03\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-[17px] font-bold\",\"children\":\"The OS layer didn't exist\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Every tool I implemented was a point solution. Nobody had unified knowledge, tasks, SOPs, and AI into one operating layer built specifically for PS firms. So I built it.\"}]]}]]}]]}]\n1a:[\"$\",\"section\",null,{\"className\":\"wrap py-[40px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":\"The conviction\"}],[\"$\",\"h2\",null,{\"className\":\"mt-3 font-display text-[26px] font-semibold tracking-[-0.01em]\",\"children\":\"Why I'm the one to build this.\"}],[\"$\",\"div\",null,{\"className\":\"mt-7 grid gap-[22px] md:grid-cols-3\",\"children\":[[\"$\",\"div\",\"I built the tools I'm now replacing\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[17px] font-bold\",\"children\":\"I built the tools I'm now replacing\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"2+ years at Wrike implementing SaaS PM tools for PS firms. 1+ year at ClickUp building their knowledge-sharing infrastructure. I understand this category from the inside out.\"}]]}],[\"$\",\"div\",\"I know exactly why existing tools fail\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[17px] font-bold\",\"children\":\"I know exactly why existing tools fail\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"I didn't just use these platforms, I sold them, implemented them, and watched them fall short. I know the gap between what firms need and what every incumbent delivers.\"}]]}],[\"$\",\"div\",\"I'm building a compounding moat\",{\"className\":\"card h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[17px] font-bold\",\"children\":\"I'm building a compounding moat\"}],[\"$\",\"p\",null,{\"className\":\"mt-2.5 text-[14.5px] leading-relaxed text-muted\",\"children\":\"Every SOP buil