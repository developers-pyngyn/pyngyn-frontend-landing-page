allelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n9:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"id\":\"$undefined\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@graph\\\":[{\\\"@type\\\":\\\"AboutPage\\\",\\\"@id\\\":\\\"https://pyngyn.ai/about#webpage\\\",\\\"url\\\":\\\"https://pyngyn.ai/about\\\",\\\"name\\\":\\\"About PYNGYN\\\",\\\"description\\\":\\\"PYNGYN builds Clientspace and Workspace for professional-services firms. Our mission, story, and what we believe.\\\",\\\"isPartOf\\\":{\\\"@id\\\":\\\"https://pyngyn.ai/#website\\\"},\\\"about\\\":{\\\"@id\\\":\\\"https://pyngyn.ai/#organization\\\"},\\\"inLanguage\\\":\\\"en\\\"},{\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"@id\\\":\\\"https://pyngyn.ai/about#breadcrumb\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://pyngyn.ai/\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"About\\\",\\\"item\\\":\\\"https://pyngyn.ai/about\\\"}]}]}\"}}],[\"$\",\"$L10\",null,{}],[\"$\",\"main\",null,{\"id\":\"main\",\"children\":[[\"$\",\"section\",null,{\"className\":\"wrap pb-[20px] pt-[150px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eyebrow\",\"children\":\"About\"}],[\"$\",\"h1\",null,{\"className\":\"mt-3 max-w-[820px] font-display text-[clamp(34px,4.8vw,56px)] font-semibold leading-[1.05] tracking-[-0.025em]\",\"children\":\"We're building the operating system for professional-services firms.\"}],[\"$\",\"p\",null,{\"className\":\"lead mt-5 max-w-[680px]\",\"children\":\"That's two products: Clientspace, a standalone branded portal your clients log into, and Workspace, the back office your team runs on. PYNGYN started from a simple frustration, services firms spend more time feeding their tools than doing the client work those tools are supposed to track. We thought AI could flip that, so the system does the planning, status, and risk-watching, and people get back to serving clients.\"}]]}],[\"$\",\"section\",null,{\"className\":\"wrap py-[60px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid gap-[22px] md:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-[22px] font-semibold\",\"children\":\"Our mission\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[16px] leading-[1.7] text-muted\",\"children\":\"Give every firm the clarity of a great operations team without the overhead. Workspace turns plain-language intent into a living plan that stays current on its own, and Clientspace shows the client that same picture without anyone writing a status update.\"}]]}],[\"$\",\"div\",null,{\"className\":\"card\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-[22px] font-semibold\",\"children\":\"Our story\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-[16px] leading-[1.7] text-muted\",\"children\":\"Founded by people who'd run too many projects across spreadsheets, chat threads, and trackers that went stale by Monday, and clients who found out about delays by asking. Workspace and Clientspace are the tools we wished we'd had, now built with AI at their core.\"}],[\"$\",\"p\",null,{\"className\":\"mt-4\",\"children\":[\"$\",\"$L11\",null,{\"href\":\"/about/founder-story\",\"className\":\"text-[14.5px] font-semibold text-accent hover:underline\",\"children\":\"Read the founder story →\"}]}]]}]]}]}],[\"$\",\"section\",null,{\"className\":\"wrap pb-[60px]\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-[26px] font-semibold tracking-[-0.01em]\",\"children\":\"What we believe\"}],[\