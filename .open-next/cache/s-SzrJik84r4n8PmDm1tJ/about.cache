",\"https://www.youtube.com/@PyngynOfficial\",\"https://instagram.com/pyngyn_official\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"customer support\",\"email\":\"support@pyngyn.com\",\"url\":\"https://pyngyn.ai/support\",\"availableLanguage\":[\"English\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"sales@pyngyn.com\",\"url\":\"https://pyngyn.ai/demo\",\"availableLanguage\":[\"English\"]}]}</script><script type=\"application/ld+json\" id=\"ld-website\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://pyngyn.ai/#website\",\"url\":\"https://pyngyn.ai/\",\"name\":\"PYNGYN\",\"description\":\"The operating system for professional-services firms. Run your firm and every client engagement in one place.\",\"publisher\":{\"@id\":\"https://pyngyn.ai/#organization\"},\"inLanguage\":\"en\"}</script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-sans\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main\" class=\"sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white\">Skip to content</a><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"AboutPage\",\"@id\":\"https://pyngyn.ai/about#webpage\",\"url\":\"https://pyngyn.ai/about\",\"name\":\"About PYNGYN\",\"description\":\"PYNGYN builds Clientspace and Workspace for professional-services firms. Our mission, story, and what we believe.\",\"isPartOf\":{\"@id\":\"https://pyngyn.ai/#website\"},\"about\":{\"@id\":\"https://pyngyn.ai/#organization\"},\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://pyngyn.ai/about#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://pyngyn.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"About\",\"item\":\"https://pyngyn.ai/about\"}]}]}</script><header class=\"fixed inset-x-0 top-0 z-[100] border-b transition-all duration-300 border-transparent bg-transparent\"><div class=\"wrap flex h-[68px] items-center justify-between\"><a class=\"flex items-center\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><div class=\"hidden h-full lg:flex lg:items-center\"><nav class=\"flex items-center gap-7 text-[15px] text-[#3a3a42]\"><a class=\"py-2 transition-colors hover:text-accent\" href=\"/clientspace/\">Clientspace</a><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Product<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Solutions<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Resources<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-expanded=\"false\" class=\"flex items-center gap-1.5 py-2 transition-colors hover:text-accent \">Compare<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" class=\"transition-transform duration-200 \"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></nav></div><div class=\"flex items-center gap-3\"><a href=\"https://app.pyngyn.ai/\" class=\"hidden text-[15px] font-semibold lg:inline \">Sign in</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"hidden px-4 py-2.5 lg:inline-flex btn btn-ghost\">Start free</a><a href=\"/demo\" class=\"hidden px-[18px] py-2.5 lg:inline-flex btn btn-primary\">Book a demo</a><button type=\"button\" class=\"grid h-10 w-10 place-items-center rounded-lg border lg:hidden border-line bg-white text-ink\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"mobile-menu\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"></path></svg></button></div></div></header><main id=\"main\"><section class=\"wrap pb-[20px] pt-[150px]\"><span class=\"eyebrow\">About</span><h1 class=\"mt-3 max-w-[820px] font-display text-[clamp(34px,4.8vw,56px)] font-semibold leading-[1.05] tracking-[-0.025em]\">We&#x27;re building the operating system for professional-services firms.</h1><p class=\"lead mt-5 max-w-[680px]\">That&#x27;s two products: Clientspace, a standalone branded portal your clients log into, and Workspace, the back office your team runs on. PYNGYN started from a simple frustration, services firms spend more time feeding their tools than doing the client work those tools are supposed to track. We thought AI could flip that, so the system does the planning, status, and risk-watching, and people get back to serving clients.</p></section><section class=\"wrap py-[60px]\"><div class=\"grid gap-[22px] md:grid-cols-2\"><div class=\"card\"><h2 class=\"font-display text-[22px] font-semibold\">Our mission</h2><p class=\"mt-3 text-[16px] leading-[1.7] text-muted\">Give every firm the clarity of a great operations team without the overhead. Workspace turns plain-language intent into a living plan that stays current on its own, and Clientspace shows the client that same picture without anyone writing a status update.</p></div><div class=\"card\"><h2 class=\"font-display text-[22px] font-semibold\">Our story</h2><p class=\"mt-3 text-[16px] leading-[1.7] text-muted\">Founded by people who&#x27;d run too many projects across spreadsheets, chat threads, and trackers that went stale by Monday, and clients who found out about delays by asking. Workspace and Clientspace are the tools we wished we&#x27;d had, now built with AI at their core.</p><p class=\"mt-4\"><a class=\"text-[14.5px] font-semibold text-accent hover:underline\" href=\"/about/founder-story/\">Read the founder story →</a></p></div></div></section><section class=\"wrap pb-[60px]\"><h2 class=\"font-display text-[26px] font-semibold tracking-[-0.01em]\">What we believe</h2><div class=\"mt-7 grid gap-[22px] md:grid-cols-2\"><div class=\"card h-full\"><h3 class=\"text-[18px] font-bold\">Client experience over admin</h3><p class=\"mt-2.5 text-[15px] text-muted\">The best firms spend their time serving clients, not chasing updates and reporting. Clientspace removes the busywork that gets in the way of that relationship.</p></div><div class=\"card h-full\"><h3 class=\"text-[18px] font-bold\">AI as a teammate</h3><p class=\"mt-2.5 text-[15px] text-muted\">Our AI drafts the plan and keeps it honest, but you stay in control. It assists; it never overrides.</p></div><div class=\"card h-full\"><h3 class=\"text-[18px] font-bold\">Clarity by default</h3><p class=\"mt-2.5 text-[15px] text-muted\">Everyone should be able to see what&#x27;s on track and what&#x27;s at risk, without a meeting to find out.</p></div><div class=\"card h-full\"><h3 class=\"text-[18px] font-bold\">Trust is earned</h3><p class=\"mt-2.5 text-[15px] text-muted\">Your data is yours. We&#x27;re transparent about how PYNGYN works and how we handle your information.</p></div></div></section><section class=\"section-tight\"><div class=\"wrap\"><div class=\"rounded-[28px] bg-accent px-8 py-14 shadow-soft\"><div class=\"grid gap-[18px] sm:grid-cols-2 md:grid-cols-3\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"text-center\"><div class=\"font-display text-[46px] font-semibold leading-none text-white\">~35%</div><div class=\"mt-2 text-sm text-white/75\">of billable time typically lost to coordination</div></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"text-center\"><div class=\"font-display text-[46px] font-semibold leading-none text-white\">~7 hrs</div><div class=\"mt-2 text-sm text-white/75\">a week back per person, at a conservative win-back</div></div></div><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"text-center\"><div class=\"font-display text-[46px] font-semibold leading-none text-white\">~38 days</div><div class=\"mt-2 text-sm text-white/75\">of billable time back per person each year</div></div></div></div><div style=\"opacity:0;transform:translateY(26px)\"><p class=\"mx-auto mt-10 max-w-[700px] text-center text-[13px] leading-relaxed text-white/70\">Illustrative figures from our free ROI calculator using default assumptions, not customer averages.<!-- --> <a href=\"/tools/roi-calculator\" class=\"font-semibold text-white underline underline-offset-2\">Model your own firm</a>.</p></div></div></div></section><section id=\"demo\" class=\"section\"><div class=\"wrap\"><div style=\"opacity:0;transform:translateY(26px)\"><div class=\"relative overflow-hidden rounded-[28px] border border-line bg-white px-7 py-[72px] text-center shadow-card\"><div class=\"pointer-events-none absolute -top-24 left-1/2 h-[420px] w-[420px] -translate-x-1/2 rounded-full bg-accent-lt opacity-70 blur-[80px]\" aria-hidden=\"true\"></div><span class=\"eyebrow relative\">Ready when you are</span><h2 class=\"title relative mx-auto mt-3.5 max-w-[680px] text-[clamp(30px,4.4vw,48px)]\">Stop managing the tool. Start shipping the work.</h2><p class=\"lead relative mx-auto mt-[18px]\">See PYNGYN run a real project in 30 minutes, and let AI handle the project management busywork.</p><div class=\"relative mt-[30px] flex flex-wrap items-center justify-center gap-3.5\"><a href=\"/demo\" class=\"btn btn-primary\">Book a demo →</a><a href=\"https://app.pyngyn.ai/?signup=true\" class=\"btn btn-ghost\">Start free</a></div><p class=\"relative mt-4 text-sm text-muted\">30-minute walkthrough · Tailored to your team · No commitment</p></div></div></div></section></main><footer class=\"border-t border-line bg-white pt-16 pb-10 text-sm text-muted\"><div class=\"wrap\"><div class=\"grid gap-10 lg:grid-cols-[1.4fr_repeat(5,1fr)]\"><div><a class=\"mb-4 inline-block\" aria-label=\"pyngyn home\" href=\"/\"><img alt=\"pyngyn\" loading=\"lazy\" width=\"150\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" src=\"/logo.webp\"/></a><p class=\"max-w-[230px] leading-relaxed\">The operating system for professional-services firms.</p><a href=\"https://play.google.com/store/apps/details?id=com.pyngyn.io&amp;hl=en_IN\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"mt-5 inline-flex items-center gap-2.5 rounded-xl border border-line bg-white px-4 py-2.5 transition-colors hover:border-accent\" aria-label=\"Get PYNGYN on Google Play\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3.6 2.3 13 12 3.6 21.7a1.4 1.4 0 0 1-.6-1.2V3.5c0-.5.2-.9.6-1.2z\" fill=\"#34a853\"></path><path d=\"M16.8 8.6 13 12 3.6 2.3c.4-.3.9-.3 1.4 0l8.8 5z\" fill=\"#ea4335\"></path><path d=\"M16.8 15.4 5 22c-.5.3-1 .3-1.4 0L13 12z\" fill=\"#fbbc04\"></path><path d=\"m16.8 8.6 4 2.3c.7.4.7 1.4 0 1.8l-4 2.7L13 12z\" fill=\"#4285f4\"></path></svg><span class=\"flex flex-col leading-tight\"><span class=\"text-[10